---
import { site } from "../config/site";

const currentPath = Astro.url.pathname;

function normalizePath(path: string) {
	if (path === "/") {
		return "/";
	}

	return path.endsWith("/")
		? path
		: `${path}/`;
}

function isActive(href: string) {
	const current = normalizePath(currentPath);
	const target = normalizePath(href);

	return current === target;
}
---

<header class="header">
	<div class="container nav">
		<a
			href="/"
			class="brand"
			aria-label={`${site.name} - Inicio`}
		>
			<img
				src="/images/brand/logo-ar-header.png"
				alt={site.name}
			/>
		</a>

		<nav
			class="desktop-nav"
			aria-label="Navegación principal"
		>
			{
				site.navigation.map((item) => (
					<a
						href={item.href}
						class:list={[
							isActive(item.href) && "active",
						]}
						aria-current={
							isActive(item.href)
								? "page"
								: undefined
						}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="nav-actions">
			<a
				class="button button-small"
				href={site.quoteHref}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar
			</a>

			<details class="mobile-menu">
				<summary aria-label="Abrir menú de navegación">
					<span></span>
					<span></span>
					<span></span>
				</summary>

				<nav
					class="mobile-menu-panel"
					aria-label="Navegación móvil"
				>
					{
						site.navigation.map((item) => (
							<a
								href={item.href}
								class:list={[
									isActive(item.href) &&
										"active",
								]}
								aria-current={
									isActive(item.href)
										? "page"
										: undefined
								}
							>
								{item.label}
							</a>
						))
					}

					<a
						href={site.quoteHref}
						class="mobile-quote"
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.header {
		position: sticky;

		top: 0;

		z-index: 100;

		background:
			rgba(255, 255, 255, 0.97);

		backdrop-filter: blur(14px);

		border-bottom:
			1px solid #e8e8e8;
	}

	.nav {
		min-height: 76px;

		display: flex;

		align-items: center;

		justify-content: space-between;

		gap: 24px;
	}

	.brand {
		display: flex;

		align-items: center;

		flex-shrink: 0;
	}

	.brand img {
		display: block;

		width: 120px;

		height: auto;
	}

	.desktop-nav {
		display: flex;

		align-items: center;

		justify-content: center;

		gap: 24px;

		margin-left: auto;

		font-size: 0.9rem;

		font-weight: 750;
	}

	.desktop-nav a {
		position: relative;

		padding:
			28px 0 27px;

		transition:
			color 0.2s ease;
	}

	.desktop-nav a::after {
		content: "";

		position: absolute;

		left: 0;
		right: 0;
		bottom: 18px;

		height: 2px;

		background: #ed1c24;

		transform: scaleX(0);

		transform-origin: center;

		transition:
			transform 0.2s ease;
	}

	.desktop-nav a:hover,
	.desktop-nav a.active {
		color: #ed1c24;
	}

	.desktop-nav a:hover::after,
	.desktop-nav a.active::after {
		transform: scaleX(1);
	}

	.nav-actions {
		display: flex;

		align-items: center;

		gap: 12px;

		flex-shrink: 0;
	}

	.mobile-menu {
		display: none;

		position: relative;

		z-index: 120;
	}

	.mobile-menu summary {
		width: 42px;

		height: 42px;

		display: flex;

		flex-direction: column;

		align-items: center;

		justify-content: center;

		gap: 5px;

		cursor: pointer;

		list-style: none;

		background: white;

		border:
			1px solid #dedede;

		border-radius: 6px;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu summary span {
		width: 18px;

		height: 2px;

		display: block;

		background: #111111;

		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.mobile-menu[open] summary span:nth-child(1) {
		transform:
			translateY(7px)
			rotate(45deg);
	}

	.mobile-menu[open] summary span:nth-child(2) {
		opacity: 0;
	}

	.mobile-menu[open] summary span:nth-child(3) {
		transform:
			translateY(-7px)
			rotate(-45deg);
	}

	.mobile-menu-panel {
		position: absolute;

		top: 52px;

		right: 0;

		z-index: 130;

		width: min(
			285px,
			calc(100vw - 28px)
		);

		display: flex;

		flex-direction: column;

		padding: 10px;

		background: white;

		border:
			1px solid #dedede;

		border-radius: 10px;

		box-shadow:
			0 18px 50px
			rgba(0, 0, 0, 0.14);
	}

	.mobile-menu-panel a {
		padding: 12px 14px;

		font-weight: 750;

		border-radius: 6px;
	}

	.mobile-menu-panel a:hover {
		background: #f5f5f5;
	}

	.mobile-menu-panel a.active {
		background: #fff1f1;

		color: #ed1c24;
	}

	.mobile-menu-panel .mobile-quote {
		margin-top: 7px;

		background: #ed1c24;

		color: white;

		text-align: center;
	}

	.mobile-menu-panel .mobile-quote:hover {
		background: #c9141b;

		color: white;
	}

	@media (max-width: 1250px) and (min-width: 1001px) {
		.nav {
			gap: 18px;
		}

		.desktop-nav {
			gap: 18px;

			font-size: 0.84rem;
		}

		.brand img {
			width: 110px;
		}

		.button-small {
			padding:
				10px 15px;
		}
	}

	@media (max-width: 1000px) {
		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}

		.button-small {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.nav {
			min-height: 66px;
		}

		.brand img {
			width: 105px;
		}
	}
</style>
