---
import { site } from "../config/site";
---

<section
	class="section contact"
	id="contacto"
>
	<div class="container contact-container">
		<p class="eyebrow">
			COTIZACIONES
		</p>

		<h2>
			¿Tiene un proyecto o necesita un producto?
		</h2>

		<p>
			Envíenos el tipo de trabajo o producto, ubicación,
			cantidad o medidas aproximadas. Podemos comenzar
			la evaluación por WhatsApp.
		</p>

		<div class="contact-actions">
			<a
				class="button"
				href={site.quoteHref}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar por WhatsApp
			</a>

			<a
				class="button button-secondary"
				href={site.contactHref}
			>
				Ver opciones de contacto
			</a>
		</div>

		<div class="contact-links">
			<a href="/servicios-obra-civil-guatemala/">
				Obra civil
			</a>

			<a href="/contadores-de-agua-guatemala/">
				Contadores de agua
			</a>

			<a href="/suministros-hidraulicos-guatemala/">
				Hidráulicos
			</a>

			<a href="/deck-wpc-guatemala/">
				Deck WPC
			</a>
		</div>
	</div>
</section>

<style>
	.contact {
		text-align: center;
		background: white;
	}

	.contact-container {
		max-width: 820px;
	}

	.contact h2 {
		max-width: 760px;
		margin-inline: auto;
		margin-bottom: 18px;
		font-size:
			clamp(
				2.1rem,
				4vw,
				3.4rem
			);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.contact p:not(.eyebrow) {
		max-width: 680px;
		margin-inline: auto;
		color: #666666;
		line-height: 1.7;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px 18px;
		margin-top: 28px;
		padding-top: 22px;
		border-top: 1px solid #e2e2e2;
	}

	.contact-links a {
		color: #555555;
		font-size: 0.82rem;
		font-weight: 800;
	}

	.contact-links a:hover {
		color: #ed1c24;
	}

	@media (max-width: 560px) {
		.contact h2 {
			font-size: 2.1rem;
		}

		.contact-actions {
			flex-direction: column;
		}
	}
</style>
