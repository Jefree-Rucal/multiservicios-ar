---
import { site } from "../config/site";
---

<section class="section services-preview">
	<div class="container">
		<div class="services-heading">
			<div>
				<p class="eyebrow">
					SERVICIOS Y EJECUCIÓN
				</p>

				<h2>
					No solo suministramos.
					<span>También ejecutamos el trabajo.</span>
				</h2>
			</div>

			<div class="services-heading-copy">
				<p>
					Atendemos necesidades de mantenimiento, reparación,
					remodelación e infraestructura para empresas,
					comercios y proyectos en Guatemala.
				</p>

				<a
					class="button button-secondary"
					href="/servicios-obra-civil-guatemala/"
				>
					Ver todos los servicios
				</a>
			</div>
		</div>

		<div class="services-grid">
			<article>
				<span>01</span>
				<h3>Mantenimiento y reparaciones</h3>
				<p>
					Atención de trabajos correctivos y mejoras
					en instalaciones existentes.
				</p>
			</article>

			<article>
				<span>02</span>
				<h3>Remodelaciones y acabados</h3>
				<p>
					Adecuaciones, tablayeso, pintura y trabajos
					de terminación según el proyecto.
				</p>
			</article>

			<article>
				<span>03</span>
				<h3>Plomería y drenajes</h3>
				<p>
					Reparaciones, modificaciones e instalaciones
					para redes de agua y drenaje.
				</p>
			</article>

			<article>
				<span>04</span>
				<h3>Instalaciones hidráulicas</h3>
				<p>
					Montaje de equipos, tuberías, accesorios y
					componentes hidráulicos según requerimiento.
				</p>
			</article>

			<article>
				<span>05</span>
				<h3>Herrería y estructuras</h3>
				<p>
					Fabricación e instalación de elementos metálicos
					para seguridad, soporte e infraestructura.
				</p>
			</article>

			<article>
				<span>06</span>
				<h3>Impermeabilización y mejoras</h3>
				<p>
					Intervenciones para resolver filtraciones,
					deterioro y necesidades de mantenimiento.
				</p>
			</article>
		</div>

		<div class="services-bottom">
			<div>
				<strong>
					¿Tiene un proyecto que no aparece en esta lista?
				</strong>

				<p>
					Envíenos fotografías, medidas o el alcance.
					Revisamos si podemos ejecutarlo y qué información
					necesitamos para cotizar correctamente.
				</p>
			</div>

			<a
				class="button"
				href={site.quoteHref}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar un proyecto
			</a>
		</div>
	</div>
</section>

<style>
	.services-preview {
		background: #f7f7f7;
	}

	.services-heading {
		display: grid;
		grid-template-columns:
			minmax(0, 1fr)
			minmax(0, 0.72fr);
		align-items: end;
		gap: 70px;
		margin-bottom: 40px;
	}

	.services-heading h2 {
		margin-bottom: 0;
		font-size:
			clamp(
				2.25rem,
				4vw,
				3.55rem
			);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.services-heading h2 span {
		display: block;
		color: #ed1c24;
	}

	.services-heading-copy p {
		margin: 0 0 20px;
		color: #666666;
		line-height: 1.75;
	}

	.services-grid {
		display: grid;
		grid-template-columns:
			repeat(3, minmax(0, 1fr));
		gap: 14px;
	}

	.services-grid article {
		min-height: 235px;
		padding: 25px;
		background: white;
		border: 1px solid #dfdfdf;
		border-radius: 10px;
	}

	.services-grid article > span {
		display: block;
		margin-bottom: 38px;
		color: #ed1c24;
		font-size: 0.72rem;
		font-weight: 900;
	}

	.services-grid h3 {
		margin-bottom: 10px;
		font-size: 1.2rem;
		line-height: 1.25;
	}

	.services-grid p {
		margin: 0;
		color: #666666;
		font-size: 0.92rem;
		line-height: 1.65;
	}

	.services-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 34px;
		margin-top: 18px;
		padding: 28px 30px;
		background: #111111;
		color: white;
		border-radius: 11px;
	}

	.services-bottom > div {
		max-width: 760px;
	}

	.services-bottom strong {
		display: block;
		margin-bottom: 7px;
		font-size: 1.2rem;
	}

	.services-bottom p {
		margin: 0;
		color: #bdbdbd;
		line-height: 1.65;
	}

	.services-bottom .button {
		flex: 0 0 auto;
	}

	@media (max-width: 900px) {
		.services-heading {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.services-grid {
			grid-template-columns:
				repeat(2, minmax(0, 1fr));
		}

		.services-bottom {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 560px) {
		.services-heading h2 {
			font-size: 2.2rem;
		}

		.services-grid {
			grid-template-columns: 1fr;
		}

		.services-grid article {
			min-height: 0;
		}

		.services-bottom {
			padding: 24px;
		}

		.services-bottom .button,
		.services-heading-copy .button {
			width: 100%;
		}
	}
</style>
