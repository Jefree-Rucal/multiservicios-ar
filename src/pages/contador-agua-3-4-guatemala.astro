---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	'Contador de Agua 3/4 en Guatemala | Precio desde Q420 | AR';

const description =
	'Contadores de agua de 3/4 en Guatemala desde Q420. Compare Genebre 6029P, 6110C y 6029. Suministro, kit e instalación disponibles según requerimiento.';

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de contadores de agua de 3/4" y quisiera solicitar una cotización.

Cantidad:
Aplicación:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsapp6029P = createWhatsAppLink(
	`Hola, quisiera cotizar un contador de agua Genebre 6029P de 3/4".

Cantidad requerida:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:

¿Me pueden confirmar precio y disponibilidad?`
);

const whatsapp6110C = createWhatsAppLink(
	`Hola, quisiera cotizar un contador de agua Genebre 6110C de 3/4".

Cantidad requerida:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:

¿Me pueden confirmar precio y disponibilidad?`
);

const whatsapp6029 = createWhatsAppLink(
	`Hola, quisiera cotizar un contador de agua Genebre 6029 de 3/4".

Cantidad requerida:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:

¿Me pueden confirmar precio y disponibilidad?`
);

const whatsappInstallation = createWhatsAppLink(
	`Hola, necesito cotizar suministro e instalación de un contador de agua de 3/4".

Cantidad:
Ubicación del proyecto:
¿Es instalación nueva o reemplazo?:
Información adicional:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: '¿Cuánto cuesta un contador de agua de 3/4 en Guatemala?',
			acceptedAnswer: {
				"@type": "Answer",
				text:
					'AR maneja opciones de contador de agua de 3/4 desde Q420 como precio de referencia. El precio final depende del modelo y debe confirmarse según disponibilidad.',
			},
		},
		{
			"@type": "Question",
			name: '¿Qué contador de agua de 3/4 necesito?',
			acceptedAnswer: {
				"@type": "Answer",
				text:
					'La selección depende de la construcción del contador, tipo de medición, posición de montaje y requerimiento de la instalación. AR puede revisar estos datos antes de cotizar.',
			},
		},
		{
			"@type": "Question",
			name: '¿Cuál es la diferencia entre Genebre 6029P, 6110C y 6029?',
			acceptedAnswer: {
				"@type": "Answer",
				text:
					'El 6029P utiliza tecnopolímero y chorro múltiple; el 6110C es de chorro único y permite montaje horizontal o vertical; el 6029 es un contador metálico de chorro múltiple para montaje horizontal.',
			},
		},
		{
			"@type": "Question",
			name: '¿También realizan instalación?',
			acceptedAnswer: {
				"@type": "Answer",
				text:
					'Sí. AR puede cotizar únicamente el contador o preparar una propuesta con suministro, materiales complementarios e instalación.',
			},
		},
		{
			"@type": "Question",
			name: '¿El contador sirve para trámites con EMPAGUA?',
			acceptedAnswer: {
				"@type": "Answer",
				text:
					'La aceptación puede depender del trámite y de las especificaciones vigentes. AR puede ayudar a revisar el requerimiento, pero no afirma autorización de un modelo específico sin documentación aplicable.',
			},
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="product-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<a
					class="breadcrumb"
					href="/contadores-de-agua-guatemala/"
				>
					← Contadores de agua
				</a>

				<p class="eyebrow">
					CONTADOR DE AGUA 3/4 EN GUATEMALA
				</p>

				<h1>
					Contador de agua 3/4"
					<span>
						desde Q420.
					</span>
				</h1>

				<p class="hero-lead">
					Compare tres opciones Genebre de 3/4"
					para instalaciones nuevas, reposiciones
					y proyectos en Guatemala. Podemos cotizar
					solo el equipo o incluir instalación.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar 3/4"
					</a>

					<a
						class="button button-secondary"
						href="#comparar"
					>
						Comparar modelos
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ 3 opciones</span>
					<span>✓ Instalación disponible</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="price-panel">
				<p class="panel-eyebrow">
					PRECIO DE REFERENCIA
				</p>

				<div class="price-main">
					<span>Desde</span>
					<strong>Q420</strong>
				</div>

				<p class="panel-copy">
					El precio cambia según el modelo seleccionado.
				</p>

				<div class="price-list">
					<div>
						<span>6029P</span>
						<strong>Q420</strong>
					</div>

					<div>
						<span>6110C</span>
						<strong>Q450</strong>
					</div>

					<div>
						<span>6029</span>
						<strong>Q560</strong>
					</div>
				</div>

				<p class="price-note">
					*Precios de referencia sujetos a confirmación
					de disponibilidad y actualización del proveedor.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     PRODUCTOS
	================================================== -->

	<section
		class="section products-section"
		id="comparar"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					COMPARE LOS 3 MODELOS
				</p>

				<h2>
					El mismo diámetro,
					<span>tres configuraciones distintas.</span>
				</h2>

				<p>
					La diferencia no está únicamente en el precio.
					La construcción, el sistema de medición y la
					posición de montaje también cambian.
				</p>
			</div>

			<div class="product-grid">
				<!-- 6029P -->

				<article class="product-card">
					<div class="card-heading">
						<div>
							<span class="card-number">
								01
							</span>

							<span class="brand">
								GENEBRE
							</span>
						</div>

						<span class="model-tag">
							6029P
						</span>
					</div>

					<ProductMedia
						src="/images/contadores/genebre-6029p-contador-tecnopolimero-3-4.png"
						alt='Imagen ilustrativa de contador de agua Genebre 6029P de 3/4"'
						model="Genebre 6029P"
						label='Contador de agua 3/4"'
					/>

					<p class="product-type">
						TECNOPOLÍMERO · CHORRO MÚLTIPLE
					</p>

					<h3>
						Genebre 6029P
					</h3>

					<p class="product-description">
						Contador para agua fría con cuerpo de
						tecnopolímero y montaje horizontal.
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia:</strong>
							6029P 05
						</li>

						<li>
							<strong>Medida:</strong>
							3/4"
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal
						</li>

						<li>
							<strong>Presión máx.:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							40 °C
						</li>
					</ul>

					<div class="card-footer">
						<div>
							<span>
								Precio de referencia
							</span>

							<strong>
								Q420
							</strong>
						</div>

						<a
							href={whatsapp6029P}
							target="_blank"
							rel="noopener noreferrer"
						>
							Cotizar →
						</a>
					</div>
				</article>

				<!-- 6110C -->

				<article class="product-card featured">
					<span class="featured-label">
						H / V
					</span>

					<div class="card-heading">
						<div>
							<span class="card-number">
								02
							</span>

							<span class="brand">
								GENEBRE
							</span>
						</div>

						<span class="model-tag">
							6110C
						</span>
					</div>

					<ProductMedia
						src="/images/contadores/genebre-6110c-contador-niquelado-3-4.png"
						alt='Imagen ilustrativa de contador de agua Genebre 6110C niquelado de 3/4"'
						model="Genebre 6110C"
						label='Contador de agua 3/4"'
					/>

					<p class="product-type">
						METÁLICO NIQUELADO · CHORRO ÚNICO
					</p>

					<h3>
						Genebre 6110C
					</h3>

					<p class="product-description">
						Contador de dial seco con transmisión
						magnética y posibilidad de montaje
						horizontal o vertical.
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia:</strong>
							6110C 05
						</li>

						<li>
							<strong>Medida:</strong>
							3/4"
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal o vertical
						</li>

						<li>
							<strong>Presión máx.:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							30 °C
						</li>
					</ul>

					<div class="card-footer">
						<div>
							<span>
								Precio de referencia
							</span>

							<strong>
								Q450
							</strong>
						</div>

						<a
							href={whatsapp6110C}
							target="_blank"
							rel="noopener noreferrer"
						>
							Cotizar →
						</a>
					</div>
				</article>

				<!-- 6029 -->

				<article class="product-card">
					<div class="card-heading">
						<div>
							<span class="card-number">
								03
							</span>

							<span class="brand">
								GENEBRE
							</span>
						</div>

						<span class="model-tag">
							6029
						</span>
					</div>

					<ProductMedia
						src="/images/contadores/genebre-6029-contador-metalico-3-4.png"
						alt='Imagen ilustrativa de contador de agua Genebre 6029 metálico de 3/4"'
						model="Genebre 6029"
						label='Contador de agua 3/4"'
					/>

					<p class="product-type">
						CUERPO METÁLICO · CHORRO MÚLTIPLE
					</p>

					<h3>
						Genebre 6029
					</h3>

					<p class="product-description">
						Contador para agua fría de chorro múltiple
						con dial seco y montaje horizontal.
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia:</strong>
							6029 05
						</li>

						<li>
							<strong>Medida:</strong>
							3/4"
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal
						</li>

						<li>
							<strong>Presión máx.:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							30 °C
						</li>
					</ul>

					<div class="card-footer">
						<div>
							<span>
								Precio de referencia
							</span>

							<strong>
								Q560
							</strong>
						</div>

						<a
							href={whatsapp6029}
							target="_blank"
							rel="noopener noreferrer"
						>
							Cotizar →
						</a>
					</div>
				</article>
			</div>

			<p class="products-note">
				Imágenes ilustrativas. Los precios y disponibilidad
				deben confirmarse al momento de solicitar la cotización.
			</p>
		</div>
	</section>

	<!-- ==================================================
	     GUÍA DE ELECCIÓN
	================================================== -->

	<section class="section guide-section">
		<div class="container guide-grid">
			<div class="guide-copy">
				<p class="eyebrow">
					¿CUÁL DE LOS 3?
				</p>

				<h2>
					La mejor opción depende
					<span>de cómo se va a instalar.</span>
				</h2>

				<p>
					Si ya tiene una especificación, fotografía
					o modelo existente, puede enviárnoslo.
					Si no, revisamos con usted la información
					básica antes de preparar la propuesta.
				</p>

				<a
					class="button"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Ayúdenme a elegir
				</a>
			</div>

			<div class="decision-list">
				<article>
					<span>01</span>

					<div>
						<h3>
							¿Montaje horizontal?
						</h3>

						<p>
							Los modelos 6029P y 6029 están
							especificados para montaje horizontal.
						</p>
					</div>
				</article>

				<article class="decision-featured">
					<span>02</span>

					<div>
						<h3>
							¿Horizontal o vertical?
						</h3>

						<p>
							El 6110C permite evaluar instalación
							en posición horizontal o vertical.
						</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>
							¿Tiene un modelo existente?
						</h3>

						<p>
							Una foto de la instalación o de la
							placa del contador nos ayuda a revisar
							el reemplazo con mayor precisión.
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     TABLA
	================================================== -->

	<section class="section table-section">
		<div class="container">
			<div class="section-heading compact-heading">
				<p class="eyebrow">
					COMPARACIÓN RÁPIDA
				</p>

				<h2>
					6029P vs 6110C vs 6029.
				</h2>
			</div>

			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th>Modelo</th>
							<th>Construcción</th>
							<th>Medición</th>
							<th>Montaje</th>
							<th>Temp.</th>
							<th>Precio ref.</th>
						</tr>
					</thead>

					<tbody>
						<tr>
							<td>
								<strong>6029P</strong>
							</td>
							<td>Tecnopolímero</td>
							<td>Chorro múltiple</td>
							<td>Horizontal</td>
							<td>40 °C</td>
							<td>
								<strong>Q420</strong>
							</td>
						</tr>

						<tr>
							<td>
								<strong>6110C</strong>
							</td>
							<td>Metálico niquelado</td>
							<td>Chorro único</td>
							<td>Horizontal / vertical</td>
							<td>30 °C</td>
							<td>
								<strong>Q450</strong>
							</td>
						</tr>

						<tr>
							<td>
								<strong>6029</strong>
							</td>
							<td>Metálico</td>
							<td>Chorro múltiple</td>
							<td>Horizontal</td>
							<td>30 °C</td>
							<td>
								<strong>Q560</strong>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<p class="table-note">
				Los tres modelos trabajan con presión máxima
				de 16 bar según especificación del fabricante.
			</p>
		</div>
	</section>

	<!-- ==================================================
	     SUMINISTRO + INSTALACIÓN
	================================================== -->

	<section class="section installation-section">
		<div class="container installation-grid">
			<div class="installation-copy">
				<p class="eyebrow eyebrow-light">
					SUMINISTRO + INSTALACIÓN
				</p>

				<h2>
					Puede comprar el contador
					<span>o resolver el trabajo completo.</span>
				</h2>

				<p>
					La cotización puede prepararse solo con
					el equipo o incluir materiales complementarios,
					mano de obra y coordinación de instalación.
				</p>

				<a
					class="button button-light"
					href={whatsappInstallation}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar instalación
				</a>
			</div>

			<div class="scope-grid">
				<article>
					<span class="scope-number">01</span>

					<h3>
						Solo contador
					</h3>

					<p>
						Para quien ya cuenta con instalador
						o personal técnico.
					</p>

					<strong>
						Equipo
					</strong>
				</article>

				<article>
					<span class="scope-number">02</span>

					<h3>
						Suministro + instalación
					</h3>

					<p>
						Evaluamos el contador, materiales
						y mano de obra necesarios.
					</p>

					<strong>
						Equipo + trabajo
					</strong>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PARA COTIZAR
	================================================== -->

	<section class="section quote-section">
		<div class="container">
			<div class="section-heading compact-heading">
				<p class="eyebrow">
					PARA COTIZAR
				</p>

				<h2>
					Envíenos cuatro datos.
				</h2>

				<p>
					Con esto podemos entender mejor el
					requerimiento antes de confirmar modelo
					y disponibilidad.
				</p>
			</div>

			<div class="quote-grid">
				<article>
					<span>01</span>
					<h3>Cantidad</h3>
					<p>¿Cuántas unidades necesita?</p>
				</article>

				<article>
					<span>02</span>
					<h3>Aplicación</h3>
					<p>Reposición, instalación nueva o proyecto.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Posición</h3>
					<p>Horizontal, vertical o por confirmar.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Alcance</h3>
					<p>Solo contador o también instalación.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Contadores de agua de 3/4".
				</h2>

				<p>
					Si su requerimiento es de otra medida,
					puede consultar nuestra página general
					de contadores de agua.
				</p>

				<a
					class="text-link"
					href="/contadores-de-agua-guatemala/"
				>
					Ver todos los contadores →
				</a>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Cuánto cuesta un contador de agua de 3/4 en Guatemala?
					</summary>

					<p>
						Actualmente manejamos opciones con
						precios de referencia desde Q420.
						El precio final debe confirmarse
						según modelo y disponibilidad.
					</p>
				</details>

				<details>
					<summary>
						¿Cuál es la diferencia entre 6029P, 6110C y 6029?
					</summary>

					<p>
						El 6029P utiliza tecnopolímero y
						medición de chorro múltiple. El 6110C
						es de chorro único y admite montaje
						horizontal o vertical. El 6029 es un
						contador metálico de chorro múltiple
						para montaje horizontal.
					</p>
				</details>

				<details>
					<summary>
						¿También realizan instalación?
					</summary>

					<p>
						Sí. Podemos cotizar únicamente el
						contador o preparar una propuesta
						que incluya equipo, materiales
						complementarios y mano de obra.
					</p>
				</details>

				<details>
					<summary>
						¿Puedo enviar una foto del contador que quiero reemplazar?
					</summary>

					<p>
						Sí. Una fotografía del contador,
						las conexiones y cualquier dato visible
						del modelo puede ayudarnos a entender
						mejor el requerimiento.
					</p>
				</details>

				<details>
					<summary>
						¿Sirve para un trámite con EMPAGUA?
					</summary>

					<p>
						La aceptación de un modelo puede depender
						del trámite y de las especificaciones
						vigentes. Podemos revisar el requerimiento,
						pero no afirmamos autorización de un
						modelo específico sin documentación aplicable.
					</p>
				</details>

				<details>
					<summary>
						¿Emiten factura FEL?
					</summary>

					<p>
						Sí. Las ventas pueden documentarse
						mediante factura electrónica FEL.
					</p>
				</details>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CTA FINAL
	================================================== -->

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN
			</p>

			<h2>
				¿Necesita un contador de agua de 3/4"?
			</h2>

			<p>
				Indíquenos cantidad, aplicación y si también
				requiere instalación. Le ayudamos a revisar
				qué opción cotizar.
			</p>

			<a
				class="button"
				href={whatsappGeneral}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar por WhatsApp
			</a>
