---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

const title =
	"Contadores de Agua en Guatemala | Venta e Instalación | AR";

const description =
	"Contadores de agua en Guatemala para instalaciones, proyectos y reposición. Opciones Genebre de 3/4, contadores Woltmann bridados y servicio de suministro e instalación.";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Cuánto cuesta un contador de agua de 3/4 en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR maneja diferentes opciones de contador de agua de 3/4. Los precios publicados son de referencia y deben confirmarse al momento de cotizar según modelo y disponibilidad.",
			},
		},
		{
			"@type": "Question",
			name: "¿Qué tipos de contador de agua de 3/4 ofrecen?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Se pueden cotizar opciones Genebre de tecnopolímero, cuerpo metálico niquelado y cuerpo metálico para agua fría, dependiendo del requerimiento del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Venden contadores de agua Woltmann?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Se pueden cotizar contadores Genebre Woltmann con bridas ANSI en medidas como 3, 4, 6 y 8 pulgadas, sujetos a disponibilidad y especificación.",
			},
		},
		{
			"@type": "Question",
			name: "¿También realizan instalación de contadores de agua?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar únicamente el suministro o preparar una propuesta que incluya contador, kit de instalación, materiales complementarios y mano de obra.",
			},
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="meters-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					CONTADORES DE AGUA EN GUATEMALA
				</p>

				<h1>
					Contadores de agua para
					<span>
						proyectos e instalaciones.
					</span>
				</h1>

				<p class="hero-lead">
					Suministro de contadores de agua para
					reposición, instalaciones nuevas y proyectos
					hidráulicos en Guatemala. Trabajamos opciones
					de 3/4" y medidores Woltmann bridados para
					mayores diámetros.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={site.quoteHref}
					>
						Cotizar contador
					</a>

					<a
						class="button button-secondary"
						href="#contadores-3-4"
					>
						Ver opciones
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Solo suministro</span>

					<span>✓ Instalación disponible</span>

					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="panel-label">
					PRECIO DE REFERENCIA
				</p>

				<div class="starting-price">
					<span>Desde</span>

					<strong>Q420</strong>
				</div>

				<p class="panel-description">
					Contadores de agua de 3/4" para diferentes
					requerimientos.
				</p>

				<div class="panel-options">
					<div>
						<span>01</span>

						<p>
							<strong>Tecnopolímero</strong>
							Alternativa ligera para agua fría.
						</p>
					</div>

					<div>
						<span>02</span>

						<p>
							<strong>Metálico niquelado</strong>
							Para montaje horizontal o vertical.
						</p>
					</div>

					<div>
						<span>03</span>

						<p>
							<strong>Metálico</strong>
							Contador de chorro múltiple.
						</p>
					</div>
				</div>

				<p class="price-note">
					*Precio de referencia sujeto a confirmación
					de modelo y disponibilidad.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     3/4"
	================================================== -->

	<section
		class="section small-meters"
		id="contadores-3-4"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					CONTADORES DE AGUA 3/4"
				</p>

				<h2>
					Tres opciones para distintos requerimientos.
				</h2>

				<p>
					No todos los contadores de 3/4" son iguales.
					La construcción, tipo de medición y forma de
					instalación pueden cambiar según el modelo.
				</p>
			</div>

			<div class="product-grid">
				<!-- 6029P -->

				<article class="product-card">
					<div class="product-top">
						<span class="product-number">
							01
						</span>

						<span class="product-family">
							GENEBRE
						</span>
					</div>

					<div class="product-type">
						TECNOPOLÍMERO
					</div>

					<h3>
						Genebre 6029P
					</h3>

					<p class="product-subtitle">
						Contador de agua fría de chorro múltiple
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia 3/4":</strong>
							6029P 05
						</li>

						<li>
							<strong>Construcción:</strong>
							Tecnopolímero
						</li>

						<li>
							<strong>Medición:</strong>
							Chorro múltiple
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal
						</li>

						<li>
							<strong>Presión máxima:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							40 °C
						</li>
					</ul>

					<div class="product-footer">
						<div>
							<span class="price-caption">
								Precio de referencia
							</span>

							<strong class="price">
								Q420
							</strong>
						</div>

						<a href={site.quoteHref}>
							Cotizar →
						</a>
					</div>
				</article>

				<!-- 6110C -->

				<article class="product-card featured">
					<div class="recommended">
						3/4"
					</div>

					<div class="product-top">
						<span class="product-number">
							02
						</span>

						<span class="product-family">
							GENEBRE
						</span>
					</div>

					<div class="product-type">
						METÁLICO NIQUELADO
					</div>

					<h3>
						Genebre 6110C
					</h3>

					<p class="product-subtitle">
						Contador de agua fría de chorro único
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia 3/4":</strong>
							6110C 05
						</li>

						<li>
							<strong>Lectura:</strong>
							Dial seco
						</li>

						<li>
							<strong>Transmisión:</strong>
							Magnética
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal o vertical
						</li>

						<li>
							<strong>Presión máxima:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							30 °C
						</li>
					</ul>

					<div class="product-footer">
						<div>
							<span class="price-caption">
								Precio de referencia
							</span>

							<strong class="price">
								Q450
							</strong>
						</div>

						<a href={site.quoteHref}>
							Cotizar →
						</a>
					</div>
				</article>

				<!-- 6029 -->

				<article class="product-card">
					<div class="product-top">
						<span class="product-number">
							03
						</span>

						<span class="product-family">
							GENEBRE
						</span>
					</div>

					<div class="product-type">
						CUERPO METÁLICO
					</div>

					<h3>
						Genebre 6029
					</h3>

					<p class="product-subtitle">
						Contador de agua fría de chorro múltiple
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia 3/4":</strong>
							6029 05
						</li>

						<li>
							<strong>Medición:</strong>
							Chorro múltiple
						</li>

						<li>
							<strong>Lectura:</strong>
							Dial seco
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal
						</li>

						<li>
							<strong>Presión máxima:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							30 °C
						</li>
					</ul>

					<div class="product-footer">
						<div>
							<span class="price-caption">
								Precio de referencia
							</span>

							<strong class="price">
								Q560
							</strong>
						</div>

						<a href={site.quoteHref}>
							Cotizar →
						</a>
					</div>
				</article>
			</div>

			<p class="catalog-note">
				Los precios son referencias comerciales y pueden
				variar según disponibilidad, actualización del
				proveedor y especificaciones requeridas.
			</p>
		</div>
	</section>

	<!-- ==================================================
	     COMPARACIÓN
	================================================== -->

	<section class="section comparison-section">
		<div class="container comparison-grid">
			<div class="comparison-copy">
				<p class="eyebrow">
					¿CUÁL NECESITA?
				</p>

				<h2>
					No elegimos el contador solamente por el precio.
				</h2>

				<p>
					Antes de cotizar verificamos medida, posición
					de montaje y requerimientos de la instalación.
					Esto ayuda a evitar comprar un modelo que luego
					no corresponda al proyecto.
				</p>

				<a
					class="button"
					href={site.quoteHref}
				>
					Enviar requerimiento
				</a>
			</div>

			<div class="comparison-table-wrapper">
				<table class="comparison-table">
					<thead>
						<tr>
							<th>
								Opción
							</th>

							<th>
								Tipo
							</th>

							<th>
								Montaje
							</th>

							<th>
								Temp.
							</th>
						</tr>
					</thead>

					<tbody>
						<tr>
							<td>
								<strong>
									6029P
								</strong>
							</td>

							<td>
								Chorro múltiple
							</td>

							<td>
								Horizontal
							</td>

							<td>
								40 °C
							</td>
						</tr>

						<tr>
							<td>
								<strong>
									6110C
								</strong>
							</td>

							<td>
								Chorro único
							</td>

							<td>
								H / V
							</td>

							<td>
								30 °C
							</td>
						</tr>

						<tr>
							<td>
								<strong>
									6029
								</strong>
							</td>

							<td>
								Chorro múltiple
							</td>

							<td>
								Horizontal
							</td>

							<td>
								30 °C
							</td>
						</tr>
					</tbody>
				</table>

				<p class="table-note">
					Los tres modelos trabajan hasta 16 bar
					según especificaciones del fabricante.
				</p>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WOLTMANN
	================================================== -->

	<section
		class="section woltmann-section"
		id="woltmann"
	>
		<div class="container">
			<div class="woltmann-heading">
				<div>
					<p class="eyebrow eyebrow-light">
						PROYECTOS DE MAYOR DIÁMETRO
					</p>

					<h2>
						Contadores Woltmann
						<span>
							con bridas ANSI.
						</span>
					</h2>
				</div>

				<div class="woltmann-intro">
					<p>
						Para instalaciones que requieren mayores
						caudales podemos cotizar la línea Genebre
						6060A para agua fría.
					</p>

					<p>
						La selección se realiza según diámetro,
						conexión, caudal y requerimientos del
						proyecto.
					</p>
				</div>
			</div>

			<div class="size-grid">
				<article>
					<span>
						3"
					</span>

					<strong>
						6060A 11
					</strong>

					<p>
						Woltmann ANSI
					</p>
				</article>

				<article>
					<span>
						4"
					</span>

					<strong>
						6060A 12
					</strong>

					<p>
						Woltmann ANSI
					</p>
				</article>

				<article>
					<span>
						6"
					</span>

					<strong>
						6060A 14
					</strong>

					<p>
						Woltmann ANSI
					</p>
				</article>

				<article>
					<span>
						8"
					</span>

					<strong>
						6060A 16
					</strong>

					<p>
						Woltmann ANSI
					</p>
				</article>
			</div>

			<div class="woltmann-specs">
				<div>
					<span>
						01
					</span>

					<p>
						<strong>Agua fría</strong>
						Temperatura máxima de trabajo de 30 °C.
					</p>
				</div>

				<div>
					<span>
						02
					</span>

					<p>
						<strong>16 bar</strong>
						Presión máxima según fabricante.
					</p>
				</div>

				<div>
					<span>
						03
					</span>

					<p>
						<strong>Bridas ANSI</strong>
						Conexión para instalaciones industriales.
					</p>
				</div>

				<div>
					<span>
						04
					</span>

					<p>
						<strong>Preparado para impulsos</strong>
						Permite evaluar lectura remota mediante accesorio.
					</p>
				</div>
			</div>

			<div class="woltmann-cta">
				<p>
					¿Necesita 3", 4", 6", 8" u otra medida?
				</p>

				<a
					class="button"
					href={site.quoteHref}
				>
					Cotizar Woltmann
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     KIT + INSTALACIÓN
	================================================== -->

	<section class="section installation-section">
		<div class="container installation-grid">
			<div>
				<p class="eyebrow">
					MÁS QUE EL CONTADOR
				</p>

				<h2>
					Podemos cotizar el equipo
					<span>
						y lo necesario para instalarlo.
					</span>
				</h2>

				<p class="installation-lead">
					Dependiendo del proyecto podemos preparar
					la propuesta únicamente con el contador
					o agregar materiales complementarios y
					mano de obra.
				</p>
			</div>

			<div class="scope-options">
				<article>
					<span class="scope-number">
						01
					</span>

					<div>
						<h3>
							Solo suministro
						</h3>

						<p>
							El contador o medidor requerido,
							sujeto a confirmación de modelo,
							precio y disponibilidad.
						</p>

						<strong>
							Equipo
						</strong>
					</div>
				</article>

				<article>
					<span class="scope-number">
						02
					</span>

					<div>
						<h3>
							Contador + kit
						</h3>

						<p>
							Podemos incluir flanges, empaques,
							tornillería y otros accesorios cuando
							el sistema los requiera.
						</p>

						<strong>
							Equipo + accesorios
						</strong>
					</div>
				</article>

				<article class="scope-featured">
					<span class="scope-number">
						03
					</span>

					<div>
						<h3>
							Suministro + instalación
						</h3>

						<p>
							Evaluamos materiales, equipo y mano
							de obra para resolver el alcance
							completo.
						</p>

						<strong>
							Equipo + materiales + mano de obra
						</strong>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CÓMO COTIZAR
	================================================== -->

	<section class="section quote-process">
		<div class="container">
			<div class="process-heading">
				<p class="eyebrow">
					PARA COTIZAR
				</p>

				<h2>
					Envíenos estos datos y avanzamos más rápido.
				</h2>
			</div>

			<div class="process-grid">
				<article>
					<span>
						01
					</span>

					<h3>
						Medida
					</h3>

					<p>
						Por ejemplo 3/4", 3", 4", 6" u 8".
					</p>
				</article>

				<article>
					<span>
						02
					</span>

					<h3>
						Cantidad
					</h3>

					<p>
						Indíquenos cuántas unidades necesita.
					</p>
				</article>

				<article>
					<span>
						03
					</span>

					<h3>
						Aplicación
					</h3>

					<p>
						Reposición, instalación nueva o proyecto.
					</p>
				</article>

				<article>
					<span>
						04
					</span>

					<h3>
						Alcance
					</h3>

					<p>
						Solo equipo, kit o instalación completa.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de comprar un contador de agua.
				</h2>

				<p>
					Si ya tiene una fotografía, ficha técnica
					o requerimiento del proyecto, puede
					enviárnoslo para revisarlo.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Cuánto cuesta un contador de agua de 3/4?
					</summary>

					<p>
						Actualmente manejamos precios comerciales
						de referencia desde Q420. El precio final
						debe confirmarse según modelo y
						disponibilidad al momento de cotizar.
					</p>
				</details>

				<details>
					<summary>
						¿Qué opción de 3/4 necesito?
					</summary>

					<p>
						Depende del requerimiento de la instalación.
						Podemos revisar medida, posición de montaje
						y especificaciones antes de recomendar
						una opción para cotización.
					</p>
				</details>

				<details>
					<summary>
						¿Tienen contadores Woltmann?
					</summary>

					<p>
						Podemos cotizar la línea Genebre 6060A
						con bridas ANSI en medidas como 3", 4",
						6" y 8", además de revisar otras medidas
						según requerimiento.
					</p>
				</details>

				<details>
					<summary>
						¿Pueden incluir flanges, empaques y tornillos?
					</summary>

					<p>
						Sí. Para aplicaciones bridadas podemos
						evaluar kits de instalación con los
						accesorios requeridos según medida.
					</p>
				</details>

				<details>
					<summary>
						¿También realizan instalación?
					</summary>

					<p>
						Sí. Podemos preparar una cotización
						únicamente de suministro o evaluar
						suministro, materiales complementarios
						y mano de obra.
					</p>
				</details>

				<details>
					<summary>
						¿El contador está autorizado por EMPAGUA?
					</summary>

					<p>
						La aceptación de un modelo puede depender
						del trámite y de las especificaciones
						vigentes. Podemos ayudarle a revisar el
						requerimiento antes de cotizar, pero no
						afirmamos autorización de un modelo
						específico sin documentación aplicable.
					</p>
				</details>

				<details>
					<summary>
						¿Emiten factura?
					</summary>

					<p>
						Sí. Las ventas pueden documentarse
						mediante factura electrónica FEL.
					</p>
				</details>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CTA
	================================================== -->

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN
			</p>

			<h2>
				¿Ya sabe qué contador necesita?
			</h2>

			<p>
				Envíenos la medida, cantidad y una fotografía
				o especificación si la tiene. Revisamos el
				requerimiento antes de preparar la propuesta.
			</p>

			<a
				class="button"
				href={site.quoteHref}
			>
				Solicitar cotización
			</a>
		</div>
	</section>

	<section class="technical-note">
		<div class="container">
			<p>
				Genebre y las demás marcas mencionadas pertenecen
				a sus respectivos titulares. Referencias técnicas,
				precios y disponibilidad están sujetos a
				confirmación al momento de la cotización.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	/* ==================================================
	   HERO
	================================================== */

