---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import {
	createWhatsAppLink,
} from "../config/site";

const title =
	"Contadores de Agua en Guatemala | Precios y Opciones | AR";

const description =
	"Contadores de agua en Guatemala con precios publicados desde Q420 para 3/4 y desde Q3,050 para Woltmann. Suministro e instalación sujetos a confirmación.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de contadores de agua y quiero comprar, confirmar disponibilidad o saber qué opción necesito.

Medida que necesito / no sé cuál:
Cantidad:
Aplicación:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsapp6029P = createWhatsAppLink(
	`Hola, vi el contador de agua Genebre 6029P de 3/4" a Q420 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad requerida:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsapp6110C = createWhatsAppLink(
	`Hola, vi el contador de agua Genebre 6110C de 3/4" a Q450 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad requerida:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsapp6029 = createWhatsAppLink(
	`Hola, vi el contador de agua Genebre 6029 de 3/4" a Q560 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad requerida:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappWoltmann = createWhatsAppLink(
	`Hola, vi sus contadores Woltmann Genebre 6060A con precios publicados y necesito ayuda para elegir o confirmar disponibilidad.

Medida requerida / no sé cuál:
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const woltmannPrices = [
	{
		size: '3"',
		ref: "6060A 11 · DN80",
		price: "Q3,050",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 3" a Q3,050 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
		),
	},
	{
		size: '4"',
		ref: "6060A 12 · DN100",
		price: "Q4,000",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 4" a Q4,000 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
		),
	},
	{
		size: '6"',
		ref: "6060A 14 · DN150",
		price: "Q5,900",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 6" a Q5,900 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
		),
	},
	{
		size: '8"',
		ref: "6060A 16 · DN200",
		price: "Q8,500",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 8" a Q8,500 como precio de referencia.

Quiero comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
		),
	},
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Cuánto cuesta un contador de agua en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"El precio depende de la medida, construcción y modelo. AR publica opciones de 3/4 desde Q420 y contadores Woltmann Genebre 6060A desde Q3,050. Los precios y la disponibilidad se confirman antes de cerrar la compra.",
			},
		},
		{
			"@type": "Question",
			name: "¿Dónde comprar un contador de agua en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Multiservicios Obra Civil AR ofrece contadores de agua para reposición, instalaciones nuevas y proyectos en Guatemala, con precios publicados en opciones seleccionadas y posibilidad de solo suministro o suministro más instalación.",
			},
		},
		{
			"@type": "Question",
			name: "¿Qué medidas de contadores de agua pueden cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR ofrece contadores de 3/4 y equipos Woltmann bridados en medidas como 3, 4, 6 y 8 pulgadas. Otras medidas se revisan según requerimiento y disponibilidad.",
			},
		},
		{
			"@type": "Question",
			name: "¿Venden contadores de agua Woltmann?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR publica precios de referencia para Woltmann Genebre 6060A: 3 pulgadas Q3,050, 4 pulgadas Q4,000, 6 pulgadas Q5,900 y 8 pulgadas Q8,500. Precio y disponibilidad se confirman antes de la compra.",
			},
		},
		{
			"@type": "Question",
			name: "¿Qué incluye el precio publicado del contador?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"El precio publicado corresponde a la unidad del contador de la medida y modelo indicados. Kits, flanges, empaques, tornillería, otros materiales complementarios, entrega e instalación se cotizan por separado cuando aplican.",
			},
		},
		{
			"@type": "Question",
			name: "¿También realizan instalación de contadores de agua?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar únicamente el suministro o preparar una propuesta que incluya contador, kit de instalación, materiales complementarios y mano de obra.",
			},
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/contadores/genebre-6029p-contador-tecnopolimero-3-4.png"
	imageAlt="Contadores de agua en Guatemala para suministro e instalación"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="meters-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					CONTADORES DE AGUA EN GUATEMALA
				</p>

				<h1>
					Contadores de agua
					<span>
						en Guatemala.
					</span>
				</h1>

				<p class="hero-lead">
					Venta y suministro de contadores de agua en
					Guatemala para reposición, instalaciones nuevas
					y proyectos hidráulicos. Publicamos precios de
					referencia para contadores de 3/4" y Woltmann
					en las medidas que podemos comparar claramente.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href="#contadores-3-4"
					>
						Ver precios y comprar
					</a>

					<a
						class="button button-secondary"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Ayúdenme a elegir
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ 3/4" desde Q420</span>

					<span>✓ Woltmann desde Q3,050</span>

					<span>✓ Instalación disponible</span>

					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="panel-label">
					CONTADOR DE AGUA 3/4 · PRECIO DE REFERENCIA
				</p>

				<div class="starting-price">
					<span>Desde</span>

					<strong>Q420</strong>
				</div>

				<p class="panel-description">
					Contadores de agua de 3/4" para diferentes
					requerimientos.
				</p>

				<div class="panel-options">
					<div>
						<span>01</span>

						<p>
							<strong>Tecnopolímero</strong>
							Alternativa ligera para agua fría.
						</p>
					</div>

					<div>
						<span>02</span>

						<p>
							<strong>Metálico niquelado</strong>
							Para montaje horizontal o vertical.
						</p>
					</div>

					<div>
						<span>03</span>

						<p>
							<strong>Metálico</strong>
							Contador de chorro múltiple.
						</p>
					</div>
				</div>

				<p class="price-note">
					*Precios comerciales de referencia por unidad,
					sujetos a confirmación de modelo y disponibilidad.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     3/4"
	================================================== -->

	<section
		class="section small-meters"
		id="contadores-3-4"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					CONTADORES DE AGUA 3/4"
				</p>

				<h2>
					Tres opciones para distintos requerimientos.
				</h2>

				<p>
					No todos los contadores de 3/4" son iguales.
					Compare construcción, medición, montaje y precio.
					Si ya sabe cuál necesita, puede confirmar
					disponibilidad y comprar por WhatsApp.
				</p>

				<a
					class="button button-secondary"
					href="/contador-agua-3-4-guatemala/"
				>
					Ver precios y modelos de contador 3/4
				</a>
			</div>

			<div class="product-grid">
				<!-- 6029P -->

				<article class="product-card">
					<div class="product-top">
						<span class="product-number">
							01
						</span>

						<span class="product-family">
							GENEBRE
						</span>
					</div>

					<ProductMedia
						src="/images/contadores/genebre-6029p-contador-tecnopolimero-3-4.png"
						alt='Imagen ilustrativa de contador de agua Genebre 6029P de 3/4"'
						model="Genebre 6029P"
						label='Contador de agua 3/4"'
					/>

					<div class="product-type">
						TECNOPOLÍMERO
					</div>

					<h3>
						Genebre 6029P
					</h3>

					<p class="product-subtitle">
						Contador de agua fría de chorro múltiple
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia 3/4":</strong>
							6029P 05
						</li>

						<li>
							<strong>Construcción:</strong>
							Tecnopolímero
						</li>

						<li>
							<strong>Medición:</strong>
							Chorro múltiple
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal
						</li>

						<li>
							<strong>Presión máxima:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							40 °C
						</li>
					</ul>

					<div class="product-footer">
						<div>
							<span class="price-caption">
								Precio de referencia
							</span>

							<strong class="price">
								Q420
							</strong>
						</div>

						<a
                            href={whatsapp6029P}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Comprar / confirmar →
                        </a>
					</div>
				</article>

				<!-- 6110C -->

				<article class="product-card featured">
					<div class="recommended">
						3/4"
					</div>

					<div class="product-top">
						<span class="product-number">
							02
						</span>

						<span class="product-family">
							GENEBRE
						</span>
					</div>

					<ProductMedia
						src="/images/contadores/genebre-6110c-contador-niquelado-3-4.png"
						alt='Imagen ilustrativa de contador de agua Genebre 6110C niquelado de 3/4"'
						model="Genebre 6110C"
						label='Contador de agua 3/4"'
					/>

					<div class="product-type">
						METÁLICO NIQUELADO
					</div>

					<h3>
						Genebre 6110C
					</h3>

					<p class="product-subtitle">
						Contador de agua fría de chorro único
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia 3/4":</strong>
							6110C 05
						</li>

						<li>
							<strong>Lectura:</strong>
							Dial seco
						</li>

						<li>
							<strong>Transmisión:</strong>
							Magnética
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal o vertical
						</li>

						<li>
							<strong>Presión máxima:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							30 °C
						</li>
					</ul>

					<div class="product-footer">
						<div>
							<span class="price-caption">
								Precio de referencia
							</span>

							<strong class="price">
								Q450
							</strong>
						</div>

						<a
							href={whatsapp6110C}
							target="_blank"
							rel="noopener noreferrer"
						>
							Comprar / confirmar →
						</a>
					</div>
				</article>

				<!-- 6029 -->

				<article class="product-card">
					<div class="product-top">
						<span class="product-number">
							03
						</span>

						<span class="product-family">
							GENEBRE
						</span>
					</div>

					<ProductMedia
						src="/images/contadores/genebre-6029-contador-metalico-3-4.png"
						alt='Imagen ilustrativa de contador de agua Genebre 6029 metálico de 3/4"'
						model="Genebre 6029"
						label='Contador de agua 3/4"'
					/>

					<div class="product-type">
						CUERPO METÁLICO
					</div>

					<h3>
						Genebre 6029
					</h3>

					<p class="product-subtitle">
						Contador de agua fría de chorro múltiple
					</p>

					<ul class="spec-list">
						<li>
							<strong>Referencia 3/4":</strong>
							6029 05
						</li>

						<li>
							<strong>Medición:</strong>
							Chorro múltiple
						</li>

						<li>
							<strong>Lectura:</strong>
							Dial seco
						</li>

						<li>
							<strong>Montaje:</strong>
							Horizontal
						</li>

						<li>
							<strong>Presión máxima:</strong>
							16 bar
						</li>

						<li>
							<strong>Temperatura máx.:</strong>
							30 °C
						</li>
					</ul>

					<div class="product-footer">
						<div>
							<span class="price-caption">
								Precio de referencia
							</span>

							<strong class="price">
								Q560
							</strong>
						</div>

						<a
							href={whatsapp6029}
							target="_blank"
							rel="noopener noreferrer"
						>
							Comprar / confirmar →
						</a>
					</div>
				</article>
			</div>

			<p class="catalog-note">
				Los precios publicados corresponden a una unidad
				del contador indicado. Instalación y materiales
				complementarios se cotizan por separado cuando aplican.
				Precio y disponibilidad se confirman antes de la compra.
			</p>
		</div>
	</section>

	<!-- ==================================================
	     COMPARACIÓN
	================================================== -->

	<section class="section comparison-section">
		<div class="container comparison-grid">
			<div class="comparison-copy">
				<p class="eyebrow">
					¿CUÁL NECESITA?
				</p>

				<h2>
					No elegimos el contador solamente por el precio.
				</h2>

				<p>
					Antes de comprar conviene verificar medida,
					posición de montaje y requerimientos de la instalación.
					Esto ayuda a evitar elegir un modelo que luego
					no corresponda al proyecto.
				</p>

				<a
                    class="button"
                    href={whatsappGeneral}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Ayúdenme a elegir
                </a>
			</div>

			<div class="comparison-table-wrapper">
				<table class="comparison-table">
					<thead>
						<tr>
							<th>
								Opción
							</th>

							<th>
								Tipo
							</th>

							<th>
								Montaje
							</th>

							<th>
								Temp.
							</th>
						</tr>
					</thead>

					<tbody>
						<tr>
							<td>
								<strong>
									6029P
								</strong>
							</td>

							<td>
								Chorro múltiple
							</td>

							<td>
								Horizontal
							</td>

							<td>
								40 °C
							</td>
						</tr>

						<tr>
							<td>
								<strong>
									6110C
								</strong>
							</td>

							<td>
								Chorro único
							</td>

							<td>
								H / V
							</td>

							<td>
								30 °C
							</td>
						</tr>

						<tr>
							<td>
								<strong>
									6029
								</strong>
							</td>

							<td>
								Chorro múltiple
							</td>

							<td>
								Horizontal
							</td>

							<td>
								30 °C
							</td>
						</tr>
					</tbody>
				</table>

				<p class="table-note">
					Los tres modelos trabajan hasta 16 bar
					según especificaciones del fabricante.
				</p>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WOLTMANN
	================================================== -->

	<section
		class="section woltmann-section"
		id="woltmann"
	>
		<div class="container">
			<div class="woltmann-heading">
				<div>
					<p class="eyebrow eyebrow-light">
						PROYECTOS DE MAYOR DIÁMETRO
					</p>

					<h2>
						Contadores Woltmann
						<span>
							con bridas ANSI.
						</span>
					</h2>
				</div>

				<div class="woltmann-intro">
					<ProductMedia
						src="/images/contadores/genebre-6060a-woltmann-bridado.png"
						alt="Imagen ilustrativa de contador de agua Woltmann bridado Genebre 6060A"
						model="Genebre 6060A"
						label="Contador Woltmann con bridas ANSI"
						variant="dark"
						aspect="wide"
					/>

					<p>
						Para instalaciones que requieren mayores
						caudales ofrecemos la línea Genebre 6060A
						para agua fría, con precios de referencia
						publicados por medida.
					</p>

					<p>
						La selección se realiza según diámetro,
						conexión, caudal y requerimientos del
						proyecto.
					</p>

					<p>
						Para válvulas, uniones tipo Dresser y otros
						componentes puede consultar también nuestros
						<a href="/suministros-hidraulicos-guatemala/">
							suministros hidráulicos en Guatemala
						</a>.
					</p>
				</div>
			</div>

			<div class="size-grid">
				{
					woltmannPrices.map((meter) => (
						<article>
							<span>{meter.size}</span>

							<strong>{meter.price}</strong>

							<p>{meter.ref}</p>

							<a
								href={meter.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								Comprar / confirmar →
							</a>
						</article>
					))
				}
			</div>

			<div class="woltmann-specs">
				<div>
					<span>
						01
					</span>

					<p>
						<strong>Agua fría</strong>
						Temperatura máxima de trabajo de 30 °C.
					</p>
				</div>

				<div>
					<span>
						02
					</span>

					<p>
						<strong>16 bar</strong>
						Presión máxima según fabricante.
					</p>
				</div>

				<div>
					<span>
						03
					</span>

					<p>
						<strong>Bridas ANSI</strong>
						Conexión para instalaciones industriales.
					</p>
				</div>

				<div>
					<span>
						04
					</span>

					<p>
						<strong>Preparado para impulsos</strong>
						Permite evaluar lectura remota mediante accesorio.
					</p>
				</div>
			</div>

			<div class="woltmann-cta">
				<p>
					¿No sabe qué medida, kit o instalación necesita?
				</p>

				<a
                    class="button"
                    href={whatsappWoltmann}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Ayúdenme a elegir Woltmann
                </a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     KIT + INSTALACIÓN
	================================================== -->

	<section class="section installation-section">
		<div class="container installation-grid">
			<div>
				<p class="eyebrow">
					MÁS QUE EL CONTADOR
				</p>

				<h2>
					Podemos cotizar el equipo
					<span>
						y lo necesario para instalarlo.
					</span>
				</h2>

				<p class="installation-lead">
					Puede comprar únicamente el contador al precio
					publicado cuando aplique, o solicitar una propuesta
					con materiales complementarios e instalación.
				</p>
			</div>

			<div class="scope-options">
				<article>
					<span class="scope-number">
						01
					</span>

					<div>
						<h3>
							Solo suministro
						</h3>

						<p>
							El contador o medidor requerido,
							sujeto a confirmación de modelo,
							precio y disponibilidad.
						</p>

						<strong>
							Equipo
						</strong>
					</div>
				</article>

				<article>
					<span class="scope-number">
						02
					</span>

					<div>
						<h3>
							Contador + kit
						</h3>

						<p>
