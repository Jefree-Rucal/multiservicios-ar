---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Servicios de Obra Civil en Guatemala | Mantenimiento y Remodelación | AR";

const description =
	"Servicios de obra civil en Guatemala para empresas y proyectos: mantenimiento, remodelación, tablayeso, plomería, impermeabilización, pintura y herrería.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de servicios de obra civil y quisiera solicitar una cotización.

Tipo de trabajo:
Ubicación del proyecto:
Medidas o área aproximada:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappMaintenance = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de mantenimiento.

Tipo de mantenimiento:
Ubicación:
Área aproximada:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappRemodeling = createWhatsAppLink(
	`Hola, necesito cotizar una remodelación.

Área o espacio:
Ubicación del proyecto:
Trabajo que quiero realizar:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappDrywall = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de tablayeso / drywall.

Tipo de trabajo:
Área aproximada:
Ubicación:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappPlumbing = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de plomería o drenajes.

Tipo de problema o instalación:
Ubicación:
¿Es reparación o instalación nueva?:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappWaterproofing = createWhatsAppLink(
	`Hola, necesito cotizar impermeabilización.

Tipo de superficie:
Área aproximada:
Ubicación:
¿Existe filtración actualmente?: Sí / No
¿Puedo enviar fotografías?: Sí`
);

const whatsappMetalwork = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de herrería o soldadura.

Tipo de trabajo:
Medidas aproximadas:
Ubicación:
¿Puedo enviar fotografías o diseño?: Sí
Información adicional:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué servicios de obra civil realizan en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede evaluar trabajos de mantenimiento, remodelación, tablayeso, pintura, plomería, drenajes, impermeabilización, herrería, soldadura e instalaciones hidráulicas según el alcance del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Atienden mantenimiento y remodelaciones para empresas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede preparar cotizaciones para empresas, comercios, oficinas e instalaciones que requieran mantenimiento, reparación, remodelación o mejora de infraestructura.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan tablayeso o drywall?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Se pueden evaluar trabajos de tablayeso o drywall para muros, divisiones, cielos, reparaciones y sustituciones según las condiciones del área.",
			},
		},
		{
			"@type": "Question",
			name: "¿Puedo enviar fotografías para cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Fotografías, medidas, planos y una descripción del problema ayudan a entender mejor el alcance antes de coordinar una visita o preparar una cotización.",
			},
		},
		{
			"@type": "Question",
			name: "¿La cotización puede incluir materiales y mano de obra?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Dependiendo del alcance, AR puede preparar una propuesta de mano de obra, materiales o suministro más ejecución.",
			},
		},
		{
			"@type": "Question",
			name: "¿Necesitan visitar el lugar antes de cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Depende del trabajo. Algunos requerimientos pueden revisarse inicialmente con fotografías y medidas; otros necesitan visita técnica para confirmar condiciones y alcance.",
			},
		},
	],
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Servicios de obra civil en Guatemala",
			item: "/servicios-obra-civil-guatemala/",
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/projects/oficinas-administrativas-estructura-metalica.jpeg"
	imageAlt="Proyecto de obra civil y construcción ejecutado por Multiservicios Obra Civil AR en Guatemala"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="services-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					SERVICIOS DE OBRA CIVIL EN GUATEMALA
				</p>

				<h1>
					Servicios de obra civil
					<span>para empresas y proyectos.</span>
				</h1>

				<p class="hero-lead">
					Mantenimiento, remodelaciones, tablayeso,
					plomería, drenajes, impermeabilización,
					pintura, herrería y otros trabajos de
					infraestructura según el alcance requerido.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#servicios"
					>
						Ver servicios
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Evaluación por proyecto</span>
					<span>✓ Materiales + mano de obra</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="panel-label">
					¿QUÉ NECESITA RESOLVER?
				</p>

				<h2>
					Cuéntenos el trabajo.
				</h2>

				<div class="panel-list">
					<div>
						<span>01</span>

						<p>
							<strong>Tipo de trabajo</strong>
							Mantenimiento, reparación, remodelación o instalación.
						</p>
					</div>

					<div>
						<span>02</span>

						<p>
							<strong>Ubicación</strong>
							Indíquenos dónde se realizará el proyecto.
						</p>
					</div>

					<div>
						<span>03</span>

						<p>
							<strong>Medidas o área</strong>
							Una referencia inicial ayuda a dimensionar.
						</p>
					</div>

					<div>
						<span>04</span>

						<p>
							<strong>Fotografías</strong>
							Puede adjuntar imágenes o planos por WhatsApp.
						</p>
					</div>
				</div>

				<p class="panel-note">
					La cotización final depende del alcance y
					las condiciones del sitio.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     SERVICIOS
	================================================== -->

	<section
		class="section services-section"
		id="servicios"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					ÁREAS DE TRABAJO
				</p>

				<h2>
					Mantenimiento y remodelación
					<span>con un alcance definido.</span>
				</h2>

				<p>
					Organizamos cada requerimiento por tipo de trabajo
					para poder revisar materiales, mano de obra,
					condiciones existentes y logística antes de cotizar.
				</p>
			</div>

			<div class="services-grid">
				<article class="service-card featured">
					<span class="service-number">01</span>

					<h3>
						Mantenimiento y reparaciones
					</h3>

					<p>
						Trabajos correctivos y mejoras en instalaciones
						comerciales, empresariales y de proyecto.
					</p>

					<ul>
						<li>Reparaciones locativas</li>
						<li>Mantenimiento correctivo</li>
						<li>Mejoras de infraestructura</li>
					</ul>

					<a
						href={whatsappMaintenance}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar mantenimiento →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">02</span>

					<h3>
						Remodelaciones
					</h3>

					<p>
						Adecuación y renovación de espacios según
						medidas, condiciones existentes y objetivo.
					</p>

					<ul>
						<li>Oficinas y áreas interiores</li>
						<li>Espacios comerciales</li>
						<li>Adecuaciones de proyecto</li>
					</ul>

					<a
						href={whatsappRemodeling}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar remodelación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">03</span>

					<h3>
						Tablayeso / drywall
					</h3>

					<p>
						Soluciones livianas para divisiones,
						cielos, reparaciones y adecuaciones interiores.
					</p>

					<ul>
						<li>Muros y divisiones</li>
						<li>Cielos</li>
						<li>Reparaciones y sustituciones</li>
					</ul>

					<a
						href={whatsappDrywall}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar tablayeso →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">04</span>

					<h3>
						Pintura y acabados
					</h3>

					<p>
						Preparación y aplicación de pintura para
						mantenimiento, renovación y entrega de espacios.
					</p>

					<ul>
						<li>Interiores</li>
						<li>Exteriores</li>
						<li>Correcciones y retoques</li>
					</ul>

					<a
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar pintura →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">05</span>

					<h3>
						Plomería y drenajes
					</h3>

					<p>
						Reparaciones e instalaciones hidráulicas
						y sanitarias según las condiciones del proyecto.
					</p>

					<ul>
						<li>Reparación de tuberías</li>
						<li>Drenajes</li>
						<li>Instalaciones nuevas</li>
					</ul>

					<a
						href={whatsappPlumbing}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar plomería →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">06</span>

					<h3>
						Impermeabilización
					</h3>

					<p>
						Evaluación y tratamiento de superficies
						expuestas a humedad o filtraciones.
					</p>

					<ul>
						<li>Losas</li>
						<li>Terrazas</li>
						<li>Áreas expuestas</li>
					</ul>

					<a
						href={whatsappWaterproofing}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar impermeabilización →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">07</span>

					<h3>
						Herrería y soldadura
					</h3>

					<p>
						Fabricación, reparación y adecuación de
						elementos metálicos según medidas y diseño.
					</p>

					<ul>
						<li>Fabricación</li>
						<li>Reparaciones</li>
						<li>Refuerzos y adecuaciones</li>
					</ul>

					<a
						href={whatsappMetalwork}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar herrería →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">08</span>

					<h3>
						Instalaciones hidráulicas
					</h3>

					<p>
						Integración de equipo, accesorios y mano
						de obra para requerimientos hidráulicos.
					</p>

					<ul>
						<li>Contadores</li>
						<li>Válvulas</li>
						<li>Accesorios y conexiones</li>
					</ul>

					<a href="/suministros-hidraulicos-guatemala/">
						Ver suministros hidráulicos →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PRUEBA REAL
	================================================== -->

	<section class="section proof-section">
		<div class="container proof-grid">
			<div class="proof-copy">
				<p class="eyebrow">
					PROYECTOS EJECUTADOS
				</p>

				<h2>
					La obra civil se demuestra
					<span>con trabajo realizado.</span>
				</h2>

				<p>
					Nuestro portafolio incluye construcción y adecuación
					de oficinas, drenajes, estructuras metálicas,
					instalaciones de agua y remodelaciones.
				</p>

				<a
					class="button"
					href="/proyectos/"
				>
					Ver proyectos realizados
				</a>
			</div>

			<div class="proof-cards">
				<a
					class="proof-card proof-card-large"
					href="/proyectos/"
				>
					<img
						src="/images/projects/oficinas-administrativas-estructura-metalica.jpeg"
						alt="Construcción de oficinas con estructura metálica ejecutada por AR"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>OBRA CIVIL</span>
						<strong>Oficinas y estructura</strong>
					</div>
				</a>

				<a
					class="proof-card"
					href="/proyectos/"
				>
					<img
						src="/images/projects/drenaje-pluvial-pvc-bajo-piso.jpeg"
						alt="Instalación de drenaje pluvial PVC bajo piso ejecutada por AR"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>INSTALACIONES</span>
						<strong>Drenaje pluvial</strong>
					</div>
				</a>

				<a
					class="proof-card"
					href="/proyectos/"
				>
					<img
						src="/images/projects/barandal-seguridad-industrial.jpeg"
						alt="Barandal de seguridad industrial fabricado e instalado por AR"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>HERRERÍA</span>
						<strong>Seguridad industrial</strong>
					</div>
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     ENFOQUE
	================================================== -->

	<section class="section approach-section">
		<div class="container approach-grid">
			<div class="approach-copy">
				<p class="eyebrow eyebrow-light">
					NUESTRO ENFOQUE
				</p>

				<h2>
					Primero entendemos
					<span>qué necesita resolver.</span>
				</h2>

				<p>
					No cotizamos únicamente por el nombre del oficio.
					Revisamos problema, dimensiones, materiales,
					accesos y condiciones para definir el alcance.
				</p>

				<a
					class="button button-light"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Contarnos el proyecto
				</a>
			</div>

			<div class="approach-cards">
				<article>
					<span>01</span>

					<div>
						<h3>
							Diagnóstico inicial
						</h3>

						<p>
							Fotografías, medidas y una descripción
							nos ayudan a entender el requerimiento.
						</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>
							Alcance definido
						</h3>

						<p>
							Separamos materiales, mano de obra
							y condiciones necesarias.
						</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>
							Cotización
						</h3>

						<p>
							La propuesta se prepara con base
							en el trabajo solicitado.
						</p>
					</div>
				</article>

				<article class="approach-featured">
					<span>04</span>

					<div>
						<h3>
							Ejecución
						</h3>

						<p>
							Coordinamos el proyecto de acuerdo
							con el alcance aprobado.
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PROCESO
	================================================== -->

	<section class="section process-section">
		<div class="container">
			<div class="section-heading process-heading">
				<p class="eyebrow">
					CÓMO COTIZAMOS
				</p>

				<h2>
					Del requerimiento a la ejecución.
				</h2>

				<p>
					En obra civil, una medida, una fotografía o
					una condición del sitio puede cambiar el alcance.
					Por eso revisamos antes de preparar la propuesta.
				</p>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Requerimiento</h3>
					<p>Recibimos descripción, fotos y medidas.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Evaluación</h3>
					<p>Revisamos alcance y condiciones del trabajo.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Definimos materiales, mano de obra y propuesta.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Ejecución</h3>
					<p>Coordinamos el proyecto una vez aprobado.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     COTIZACIÓN
	================================================== -->

	<section class="section quote-section">
		<div class="container quote-grid">
			<div>
				<p class="eyebrow">
					PARA COTIZAR
				</p>

				<h2>
					Entre más contexto,
					<span>mejor podemos evaluar.</span>
				</h2>

				<p class="quote-lead">
					No necesita tener una ficha técnica perfecta.
					Con información básica podemos empezar.
				</p>
			</div>

			<div class="quote-list">
				<article>
					<span>01</span>

					<div>
						<h3>Fotografías</h3>
						<p>Del área, daño o espacio a intervenir.</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>Medidas</h3>
						<p>Área aproximada, largo, ancho o altura.</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>Ubicación</h3>
						<p>Para entender logística y coordinación.</p>
					</div>
				</article>

				<article class="quote-featured">
					<span>04</span>

					<div>
						<h3>Objetivo</h3>
						<p>Qué necesita reparar, cambiar o mejorar.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar obra civil.
				</h2>

				<p>
					Si ya cuenta con fotografías, planos o medidas,
					puede enviarlos directamente por WhatsApp.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué servicios de obra civil realizan en Guatemala?
					</summary>

					<p>
						Podemos evaluar mantenimiento, remodelación,
						tablayeso, pintura, plomería, drenajes,
						impermeabilización, herrería, soldadura e
						instalaciones hidráulicas según proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿Atienden mantenimiento y remodelaciones para empresas?
					</summary>

					<p>
						Sí. Podemos preparar cotizaciones para empresas,
						comercios, oficinas e instalaciones que requieran
						reparación, mantenimiento, remodelación o mejora.
					</p>
				</details>

				<details>
					<summary>
						¿Trabajan tablayeso o drywall?
					</summary>

					<p>
						Sí. Podemos evaluar muros, divisiones, cielos,
						reparaciones y sustituciones según el área
						y las condiciones existentes.
					</p>
				</details>

				<details>
					<summary>
						¿Puedo enviar fotografías para cotizar?
					</summary>

					<p>
						Sí. Fotografías, medidas, planos y una descripción
						del problema ayudan a entender mejor el alcance.
					</p>
				</details>

				<details>
					<summary>
						¿La cotización puede incluir materiales y mano de obra?
					</summary>

					<p>
						Sí. Dependiendo del alcance, podemos cotizar
						mano de obra, materiales o una propuesta
						de suministro más ejecución.
