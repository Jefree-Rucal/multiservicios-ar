---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Servicios de Obra Civil en Guatemala | Mantenimiento y Remodelación | AR";

const description =
	"Servicios de obra civil en Guatemala: mantenimiento, remodelación, tablayeso, pintura, plomería, drenajes, impermeabilización, herrería e instalaciones hidráulicas. Cotización por proyecto.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de servicios de obra civil y quisiera solicitar una cotización.

Tipo de trabajo:
Ubicación del proyecto:
Medidas o área aproximada:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappMaintenance = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de mantenimiento.

Tipo de mantenimiento:
Ubicación:
Área aproximada:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappRemodeling = createWhatsAppLink(
	`Hola, necesito cotizar una remodelación.

Área o espacio:
Ubicación del proyecto:
Trabajo que quiero realizar:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappDrywall = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de tablayeso / drywall.

Tipo de trabajo:
Área aproximada:
Ubicación:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappPlumbing = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de plomería o drenajes.

Tipo de problema o instalación:
Ubicación:
¿Es reparación o instalación nueva?:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappWaterproofing = createWhatsAppLink(
	`Hola, necesito cotizar impermeabilización.

Tipo de superficie:
Área aproximada:
Ubicación:
¿Existe filtración actualmente?: Sí / No
¿Puedo enviar fotografías?: Sí`
);

const whatsappMetalwork = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de herrería o soldadura.

Tipo de trabajo:
Medidas aproximadas:
Ubicación:
¿Puedo enviar fotografías o diseño?: Sí
Información adicional:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué servicios de obra civil realizan?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede evaluar trabajos de mantenimiento, remodelación, tablayeso, pintura, plomería, drenajes, impermeabilización, herrería, soldadura e instalaciones hidráulicas según el alcance del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan proyectos para empresas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede preparar cotizaciones para empresas, comercios, oficinas, instalaciones y proyectos que requieran mantenimiento, reparación o mejora de infraestructura.",
			},
		},
		{
			"@type": "Question",
			name: "¿Puedo enviar fotografías para cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Fotografías, medidas, planos o una descripción del problema ayudan a entender mejor el alcance antes de coordinar una visita o preparar una cotización.",
			},
		},
		{
			"@type": "Question",
			name: "¿La cotización incluye materiales y mano de obra?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Depende del alcance solicitado. AR puede cotizar mano de obra, materiales o una propuesta integral de suministro y ejecución.",
			},
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="services-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					SERVICIOS DE OBRA CIVIL EN GUATEMALA
				</p>

				<h1>
					Mantenimiento, reparación
					<span>y ejecución de proyectos.</span>
				</h1>

				<p class="hero-lead">
					Atendemos requerimientos de obra civil,
					mantenimiento y mejora de infraestructura
					para empresas, comercios y proyectos.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#servicios"
					>
						Ver servicios
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Evaluación por proyecto</span>
					<span>✓ Materiales + mano de obra</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="panel-label">
					¿QUÉ NECESITA RESOLVER?
				</p>

				<h2>
					Cuéntenos el alcance.
				</h2>

				<div class="panel-list">
					<div>
						<span>01</span>

						<p>
							<strong>Tipo de trabajo</strong>
							Mantenimiento, reparación, remodelación o instalación.
						</p>
					</div>

					<div>
						<span>02</span>

						<p>
							<strong>Ubicación</strong>
							Indíquenos dónde se realizará el proyecto.
						</p>
					</div>

					<div>
						<span>03</span>

						<p>
							<strong>Medidas o área</strong>
							Una referencia inicial nos ayuda a dimensionar.
						</p>
					</div>

					<div>
						<span>04</span>

						<p>
							<strong>Fotografías</strong>
							Puede adjuntar imágenes o planos por WhatsApp.
						</p>
					</div>
				</div>

				<p class="panel-note">
					La cotización final depende del alcance y condiciones del sitio.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     SERVICIOS
	================================================== -->

	<section
		class="section services-section"
		id="servicios"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					ÁREAS DE TRABAJO
				</p>

				<h2>
					Servicios enfocados en
					<span>resolver infraestructura.</span>
				</h2>

				<p>
					No presentamos una lista de “todo”.
					Organizamos los trabajos por tipo de necesidad
					para definir mejor el alcance y la cotización.
				</p>
			</div>

			<div class="services-grid">
				<article class="service-card featured">
					<span class="service-number">
						01
					</span>

					<h3>
						Mantenimiento y reparaciones
					</h3>

					<p>
						Correcciones, reparaciones y trabajos
						de mantenimiento en instalaciones
						comerciales, empresariales y de proyecto.
					</p>

					<ul>
						<li>Reparaciones locativas</li>
						<li>Mantenimiento correctivo</li>
						<li>Mejoras de infraestructura</li>
					</ul>

					<a
						href={whatsappMaintenance}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar mantenimiento →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						02
					</span>

					<h3>
						Remodelaciones
					</h3>

					<p>
						Adecuación y renovación de espacios
						según requerimiento, medidas y
						condiciones existentes.
					</p>

					<ul>
						<li>Áreas interiores</li>
						<li>Espacios comerciales</li>
						<li>Adecuaciones de proyecto</li>
					</ul>

					<a
						href={whatsappRemodeling}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar remodelación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						03
					</span>

					<h3>
						Tablayeso / drywall
					</h3>

					<p>
						Soluciones livianas para divisiones,
						reparaciones, cielos y adecuaciones
						interiores.
					</p>

					<ul>
						<li>Muros y divisiones</li>
						<li>Cielos</li>
						<li>Reparaciones y sustituciones</li>
					</ul>

					<a
						href={whatsappDrywall}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar tablayeso →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						04
					</span>

					<h3>
						Pintura y acabados
					</h3>

					<p>
						Preparación y aplicación de pintura
						para mantenimiento, renovación
						y entrega de espacios.
					</p>

					<ul>
						<li>Interiores</li>
						<li>Exteriores</li>
						<li>Corrección y retoque</li>
					</ul>

					<a
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar pintura →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						05
					</span>

					<h3>
						Plomería y drenajes
					</h3>

					<p>
						Reparaciones e instalaciones hidráulicas
						y sanitarias según las condiciones
						del proyecto.
					</p>

					<ul>
						<li>Reparaciones de tubería</li>
						<li>Drenajes</li>
						<li>Instalaciones nuevas</li>
					</ul>

					<a
						href={whatsappPlumbing}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar plomería →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						06
					</span>

					<h3>
						Impermeabilización
					</h3>

					<p>
						Evaluación y tratamiento de superficies
						que requieren protección o corrección
						por filtraciones.
					</p>

					<ul>
						<li>Losas</li>
						<li>Terrazas</li>
						<li>Áreas expuestas</li>
					</ul>

					<a
						href={whatsappWaterproofing}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar impermeabilización →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						07
					</span>

					<h3>
						Herrería y soldadura
					</h3>

					<p>
						Trabajos metálicos y reparaciones
						según diseño, medidas y necesidad
						del proyecto.
					</p>

					<ul>
						<li>Reparación</li>
						<li>Fabricación</li>
						<li>Refuerzos y adecuaciones</li>
					</ul>

					<a
						href={whatsappMetalwork}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar herrería →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">
						08
					</span>

					<h3>
						Instalaciones hidráulicas
					</h3>

					<p>
						Integración de equipo, accesorios
						y mano de obra para requerimientos
						hidráulicos.
					</p>

					<ul>
						<li>Contadores</li>
						<li>Válvulas</li>
						<li>Accesorios y conexiones</li>
					</ul>

					<a href="/suministros-hidraulicos-guatemala/">
						Ver hidráulicos →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     ENFOQUE
	================================================== -->

	<section class="section approach-section">
		<div class="container approach-grid">
			<div class="approach-copy">
				<p class="eyebrow eyebrow-light">
					NUESTRO ENFOQUE
				</p>

				<h2>
					No vendemos una lista
					<span>de oficios aislados.</span>
				</h2>

				<p>
					Partimos del problema o necesidad del cliente,
					revisamos el alcance y preparamos una propuesta
					acorde al trabajo requerido.
				</p>

				<a
					class="button button-light"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Contarnos el proyecto
				</a>
			</div>

			<div class="approach-cards">
				<article>
					<span>01</span>

					<div>
						<h3>
							Diagnóstico inicial
						</h3>

						<p>
							Fotografías, medidas y una descripción
							nos ayudan a entender el requerimiento.
						</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>
							Alcance definido
						</h3>

						<p>
							Separamos materiales, mano de obra
							y condiciones necesarias.
						</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>
							Cotización clara
						</h3>

						<p>
							La propuesta se prepara según
							el trabajo realmente solicitado.
						</p>
					</div>
				</article>

				<article class="approach-featured">
					<span>04</span>

					<div>
						<h3>
							Ejecución
						</h3>

						<p>
							Coordinamos el trabajo de acuerdo
							con el alcance aprobado.
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PROCESO
	================================================== -->

	<section class="section process-section">
		<div class="container">
			<div class="section-heading process-heading">
				<p class="eyebrow">
					CÓMO COTIZAMOS
				</p>

				<h2>
					Del requerimiento a la ejecución.
				</h2>

				<p>
					En trabajos de obra civil, una medida o una
					fotografía puede cambiar por completo el alcance.
					Por eso revisamos antes de prometer.
				</p>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Requerimiento</h3>
					<p>Recibimos descripción, fotos y medidas.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Evaluación</h3>
					<p>Revisamos alcance y condiciones del trabajo.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Preparamos materiales, mano de obra y propuesta.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Ejecución</h3>
					<p>Coordinamos el proyecto una vez aprobado.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     QUÉ ENVIAR
	================================================== -->

	<section class="section quote-section">
		<div class="container quote-grid">
			<div>
				<p class="eyebrow">
					PARA COTIZAR
				</p>

				<h2>
					Entre más contexto,
					<span>mejor podemos evaluar.</span>
				</h2>

				<p class="quote-lead">
					No necesita tener una ficha técnica perfecta.
					Con información básica podemos empezar.
				</p>
			</div>

			<div class="quote-list">
				<article>
					<span>01</span>

					<div>
						<h3>Fotografías</h3>
						<p>Del área, daño o espacio a intervenir.</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>Medidas</h3>
						<p>Área aproximada, largo, ancho o altura.</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>Ubicación</h3>
						<p>Para entender logística y coordinación.</p>
					</div>
				</article>

				<article class="quote-featured">
					<span>04</span>

					<div>
						<h3>Objetivo</h3>
						<p>Qué necesita reparar, cambiar o mejorar.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar un trabajo.
				</h2>

				<p>
					Si ya cuenta con fotografías, planos o
					medidas, puede enviarlos directamente
					por WhatsApp.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué servicios de obra civil realizan?
					</summary>

					<p>
						Podemos evaluar mantenimiento, remodelación,
						tablayeso, pintura, plomería, drenajes,
						impermeabilización, herrería, soldadura
						e instalaciones hidráulicas según proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿Trabajan proyectos para empresas?
					</summary>

					<p>
						Sí. Podemos preparar cotizaciones para
						empresas, comercios, oficinas e instalaciones
						que requieran reparación, mantenimiento
						o mejora de infraestructura.
					</p>
				</details>

				<details>
					<summary>
						¿Puedo enviar fotografías para cotizar?
					</summary>

					<p>
						Sí. Fotografías, medidas, planos o una
						descripción del problema ayudan a entender
						mejor el alcance antes de coordinar.
					</p>
				</details>

				<details>
					<summary>
						¿La cotización incluye materiales y mano de obra?
					</summary>

					<p>
						Depende del alcance solicitado. Podemos
						cotizar mano de obra, materiales o una
						propuesta integral de suministro y ejecución.
					</p>
				</details>

				<details>
					<summary>
						¿Necesitan visitar el lugar?
					</summary>

					<p>
						Algunos trabajos pueden evaluarse inicialmente
						con fotografías y medidas. En otros casos,
						una visita es necesaria para confirmar
						condiciones y alcance.
					</p>
				</details>

				<details>
					<summary>
						¿Emiten factura FEL?
					</summary>

					<p>
						Sí. Los trabajos pueden documentarse
						mediante factura electrónica FEL.
					</p>
				</details>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CTA FINAL
	================================================== -->

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN
			</p>

			<h2>
				¿Tiene una reparación, mantenimiento o proyecto?
			</h2>

			<p>
				Envíenos fotografías, medidas aproximadas y
				una breve descripción. Revisamos el requerimiento
				antes de preparar la propuesta.
			</p>

			<a
				class="button"
				href={whatsappGeneral}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar por WhatsApp
			</a>
		</div>
	</section>

	<section class="legal-note">
		<div class="container">
			<p>
				La disponibilidad de servicios, materiales,
				plazos y alcance se confirma al momento de cotizar.
				Algunos trabajos pueden requerir visita técnica.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	/* ==================================================
	   HERO
	================================================== */

	.services-hero {
		padding: 88px 0;

		background:
			linear-gradient(
				115deg,
				#ffffff 0%,
				#ffffff 60%,
				#f1f1f1 100%
			);
	}

	.hero-grid {
		display: grid;

		grid-template-columns:
			minmax(0, 1.08fr)
			minmax(370px, 0.92fr);

		align-items: center;

		gap: 64px;
	}

	.hero-copy {
		min-width: 0;
	}

	.hero-copy h1 {
		max-width: 800px;

		margin-bottom: 26px;

		font-size:
			clamp(
				3rem,
				5vw,
				5rem
			);

		line-height: 0.97;

		letter-spacing: -0.055em;
	}

	.hero-copy h1 span {
		display: block;

		color: #ed1c24;
	}

	.hero-lead {
		max-width: 680px;

		color: #606060;

		font-size: 1.08rem;

		line-height: 1.75;
	}

	.hero-actions {
		display: flex;

		flex-wrap: wrap;

		gap: 12px;

		margin-top: 32px;
	}

	.hero-trust {
		display: flex;

		flex-wrap: wrap;

		gap: 12px 22px;

		margin-top: 30px;

		color: #555555;

		font-size: 0.88rem;

		font-weight: 700;
	}

	.hero-panel {
		padding: 36px;

		background: #111111;

		color: white;

		border-radius: 14px;

		box-shadow:
			0 30px 70px
			rgba(0, 0, 0, 0.16);
	}

	.panel-label {
		margin-bottom: 14px;

		color: #ff464d;

		font-size: 0.7rem;

		font-weight: 900;

		letter-spacing: 0.14em;
	}

	.hero-panel h2 {
		margin-bottom: 26px;

