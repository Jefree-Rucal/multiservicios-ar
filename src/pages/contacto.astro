---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
	createWhatsAppLink,
	phoneDisplay,
	site,
} from "../config/site";

const title =
	"Contacto y Cotizaciones en Guatemala | Multiservicios Obra Civil AR";

const description =
	"Contacte a Multiservicios Obra Civil AR en Guatemala para obra civil, mantenimiento, remodelaciones, suministros hidráulicos, contadores de agua, Deck WPC e instalación.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi la página de Multiservicios Obra Civil AR y quisiera revisar una necesidad.

¿Qué necesito resolver o comprar?:
Ubicación:
Medidas o cantidad aproximada:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappCivil = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de obra civil, mantenimiento o remodelación.

Tipo de trabajo:
Ubicación:
Área o medidas aproximadas:
¿Qué necesito reparar, construir o mejorar?:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappHydraulic = createWhatsAppLink(
	`Hola, necesito comprar o cotizar un producto / trabajo hidráulico.

Producto o necesidad:
Medida / diámetro:
Cantidad:
¿Necesito solo suministro o también instalación?:
Ubicación:
Información adicional:`
);

const whatsappDeck = createWhatsAppLink(
	`Hola, necesito comprar Deck WPC o cotizar instalación.

Área aproximada en m²:
Ubicación:
¿Necesito solo material, material + accesorios o instalación?:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappUnsure = createWhatsAppLink(
	`Hola, necesito ayuda con un trabajo o producto, pero no sé exactamente cómo pedirlo.

Lo que necesito resolver:
Ubicación:
Medidas aproximadas si las tengo:
Puedo enviar fotografías: Sí
Información adicional:`
);

const contactSchema = {
	"@context": "https://schema.org",
	"@type": "ContactPage",
	name: "Contacto y cotizaciones - Multiservicios Obra Civil AR",
	description,
	inLanguage: "es-GT",
	mainEntity: {
		"@type": "Organization",
		name: site.name,
		areaServed: {
			"@type": "Country",
			name: "Guatemala",
		},
		contactPoint: {
			"@type": "ContactPoint",
			telephone: phoneDisplay,
			contactType: "cotizaciones y ventas",
			availableLanguage: ["es"],
			areaServed: "GT",
		},
	},
};
---

<BaseLayout
	title={title}
	description={description}
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(contactSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="contact-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					CONTACTO DIRECTO · GUATEMALA
				</p>

				<h1>
					Díganos qué necesita.
					<span>No tiene que saber cómo pedirlo.</span>
				</h1>

				<p class="hero-lead">
					Si busca ejecutar un trabajo, comprar un producto
					o combinar suministro + instalación, puede empezar
					con la información que ya tenga. Nosotros le indicamos
					qué falta para avanzar.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Escribir por WhatsApp
					</a>

					<a
						class="button button-secondary"
						href="#elegir-solicitud"
					>
						Elegir tipo de solicitud
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Servicios y ejecución</span>
					<span>✓ Productos y suministros</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="contact-panel">
				<p class="panel-label">
					WHATSAPP AR
				</p>

				<a
					class="phone-link"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Contactar a ${site.name} por WhatsApp`}
				>
					{phoneDisplay}
				</a>

				<p class="panel-copy">
					Una fotografía y una explicación sencilla muchas
					veces son suficientes para empezar la revisión.
				</p>

				<div class="panel-routes">
					<div>
						<span>SI ES UN SERVICIO</span>
						<strong>
							Fotos + ubicación + medidas aproximadas
						</strong>
						<p>
							Revisamos el alcance y le indicamos si hace
							falta información o visita adicional.
						</p>
					</div>

					<div>
						<span>SI ES UN PRODUCTO</span>
						<strong>
							Modelo / medida + cantidad
						</strong>
						<p>
							Confirmamos especificación, precio y
							disponibilidad antes de cerrar la compra.
						</p>
					</div>
				</div>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     ROUTES
	================================================== -->

	<section
		class="section contact-options"
		id="elegir-solicitud"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					¿QUÉ NECESITA?
				</p>

				<h2>
					Empiece por la ruta
					<span>que más se parece a su caso.</span>
				</h2>

				<p>
					No obligamos al cliente a llenar un formulario largo.
					Cada opción abre WhatsApp con las preguntas mínimas
					para entender mejor el requerimiento.
				</p>
			</div>

			<div class="options-grid">
				<article class="option-card featured">
					<span class="option-number">01</span>

					<p class="option-kicker">
						SERVICIOS
					</p>

					<h3>
						Obra civil y mantenimiento
					</h3>

					<p>
						Reparaciones, remodelaciones, plomería,
						drenajes, tablayeso, pintura, herrería,
						impermeabilización e infraestructura.
					</p>

					<a
						href={whatsappCivil}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar mi proyecto →
					</a>
				</article>

				<article class="option-card">
					<span class="option-number">02</span>

					<p class="option-kicker">
						PRODUCTOS + INSTALACIÓN
					</p>

					<h3>
						Hidráulicos y contadores
					</h3>

					<p>
						Contadores de agua, Woltmann, uniones Dresser,
						válvulas, accesorios o una instalación hidráulica.
					</p>

					<a
						href={whatsappHydraulic}
						target="_blank"
						rel="noopener noreferrer"
					>
						Comprar o cotizar →
					</a>
				</article>

				<article class="option-card">
					<span class="option-number">03</span>

					<p class="option-kicker">
						PRODUCTO + INSTALACIÓN
					</p>

					<h3>
						Piso Deck WPC
					</h3>

					<p>
						Compra de cajas, accesorios según necesidad
						o propuesta de suministro + instalación.
					</p>

					<a
						href={whatsappDeck}
						target="_blank"
						rel="noopener noreferrer"
					>
						Comprar Deck / cotizar instalación →
					</a>
				</article>

				<article class="option-card unsure">
					<span class="option-number">04</span>

					<p class="option-kicker">
						NO SÉ CÓMO PEDIRLO
					</p>

					<h3>
						Tengo un problema o una idea
					</h3>

					<p>
						Explíquenos qué quiere resolver y envíe fotos.
						Le ayudamos a identificar qué información
						hace falta para revisar el caso.
					</p>

					<a
						href={whatsappUnsure}
						target="_blank"
						rel="noopener noreferrer"
					>
						Enviar mi caso →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WHAT TO SEND
	================================================== -->

	<section
		class="section send-section"
		id="que-enviar"
	>
		<div class="container send-grid">
			<div class="send-copy">
				<p class="eyebrow eyebrow-light">
					PARA EMPEZAR
				</p>

				<h2>
					Envíe lo que ya tenga.
					<span>No necesita un expediente completo.</span>
				</h2>

				<p>
					La información exacta cambia según el trabajo,
					pero estos cuatro datos ayudan a avanzar mucho
					más rápido desde el primer mensaje.
				</p>

				<a
					class="button button-light"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Enviar mi información
				</a>
			</div>

			<div class="send-cards">
				<article>
					<span>01</span>

					<div>
						<h3>Qué necesita</h3>
						<p>
							Qué desea reparar, construir, comprar,
							reemplazar o mejorar.
						</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>Ubicación</h3>
						<p>
							Zona, municipio o referencia general
							del lugar del trabajo o entrega.
						</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>Medidas / cantidad</h3>
						<p>
							Área, largo, diámetro, medida del producto
							o cantidad aproximada.
						</p>
					</div>
				</article>

				<article class="send-featured">
					<span>04</span>

					<div>
						<h3>Fotos o referencias</h3>
						<p>
							Imágenes del área, producto existente,
							plano o referencia cuando la tenga.
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WHAT HAPPENS NEXT
	================================================== -->

	<section class="section next-section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					¿QUÉ PASA DESPUÉS?
				</p>

				<h2>
					La siguiente etapa depende
					<span>de si compra un producto o contrata un trabajo.</span>
				</h2>

				<p>
					Esto evita prometer tiempos, precios o alcances
					antes de revisar lo necesario.
				</p>
			</div>

			<div class="next-grid">
				<article>
					<p class="next-label">
						PRODUCTO / SUMINISTRO
					</p>

					<h3>
						Comprar un producto
					</h3>

					<ol>
						<li>
							<span>01</span>
							<div>
								<strong>Identificamos el producto</strong>
								<p>Modelo, medida, cantidad y aplicación.</p>
							</div>
						</li>

						<li>
							<span>02</span>
							<div>
								<strong>Confirmamos</strong>
								<p>Precio, especificación y disponibilidad.</p>
							</div>
						</li>

						<li>
							<span>03</span>
							<div>
								<strong>Cerramos el alcance</strong>
								<p>
									Producto solo o con accesorios /
									instalación cuando aplique.
								</p>
							</div>
						</li>
					</ol>
				</article>

				<article class="next-featured">
					<p class="next-label">
						SERVICIO / EJECUCIÓN
					</p>

					<h3>
						Contratar un trabajo
					</h3>

					<ol>
						<li>
							<span>01</span>
							<div>
								<strong>Revisamos la necesidad</strong>
								<p>Fotos, ubicación, medidas y objetivo.</p>
							</div>
						</li>

						<li>
							<span>02</span>
							<div>
								<strong>Definimos qué falta</strong>
								<p>
									Información adicional, medición o
									visita cuando el caso lo requiera.
								</p>
							</div>
						</li>

						<li>
							<span>03</span>
							<div>
								<strong>Preparamos la propuesta</strong>
								<p>
									Alcance, materiales y mano de obra
									según el proyecto.
								</p>
							</div>
						</li>
					</ol>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FINAL CTA
	================================================== -->

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				¿LISTO PARA EMPEZAR?
			</p>

			<h2>
				Escríbanos con lo que ya sabe.
			</h2>

			<p>
				Si falta una medida, una fotografía o una especificación,
				se lo indicamos durante la revisión. El primer mensaje
				no tiene que estar perfecto.
			</p>

			<a
				class="button"
				href={whatsappGeneral}
				target="_blank"
				rel="noopener noreferrer"
			>
				Escribir al {phoneDisplay}
			</a>
		</div>
	</section>

	<section class="contact-note">
		<div class="container">
			<p>
				Precios, disponibilidad de materiales, visitas,
				plazos, entrega e instalación se confirman según
				cada requerimiento y el alcance acordado.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.contact-hero {
		padding: 88px 0;
		background:
			linear-gradient(
				115deg,
				#ffffff 0%,
				#ffffff 60%,
				#f1f1f1 100%
			);
	}

	.hero-grid {
		display: grid;
		grid-template-columns:
			minmax(0, 1.08fr)
			minmax(370px, 0.92fr);
		align-items: center;
		gap: 64px;
	}

	.hero-copy h1 {
		max-width: 820px;
		margin-bottom: 26px;
		font-size:
			clamp(
				3rem,
				5vw,
				5rem
			);
		line-height: 0.97;
		letter-spacing: -0.055em;
	}

	.hero-copy h1 span,
	.section-heading h2 span,
	.send-copy h2 span {
		display: block;
		color: #ed1c24;
	}

	.hero-lead {
		max-width: 690px;
		color: #606060;
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.hero-trust {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		margin-top: 30px;
		color: #555555;
		font-size: 0.88rem;
		font-weight: 700;
	}

	.contact-panel {
		padding: 36px;
		background: #111111;
		color: white;
		border-radius: 14px;
		box-shadow:
			0 30px 70px
			rgba(0, 0, 0, 0.16);
	}

	.panel-label {
		margin-bottom: 8px;
		color: #ff464d;
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.14em;
	}

	.phone-link {
		display: inline-block;
		margin-bottom: 16px;
		color: white;
		font-size:
			clamp(
				1.85rem,
				3vw,
				2.5rem
			);
		font-weight: 900;
		letter-spacing: -0.04em;
	}

	.phone-link:hover {
		color: #ff464d;
	}

	.panel-copy {
		margin-bottom: 22px;
		color: #bdbdbd;
		line-height: 1.65;
	}

	.panel-routes {
		display: grid;
		gap: 12px;
	}

	.panel-routes > div {
		padding: 18px;
		background: #181818;
		border: 1px solid #303030;
		border-radius: 9px;
	}

	.panel-routes span {
		display: block;
		margin-bottom: 7px;
		color: #ff464d;
		font-size: 0.64rem;
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.panel-routes strong {
		display: block;
		margin-bottom: 6px;
		font-size: 0.95rem;
	}

	.panel-routes p {
		margin: 0;
		color: #999999;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.section-heading {
		max-width: 830px;
		margin-bottom: 44px;
	}

	.section-heading h2,
	.send-copy h2,
	.final-inner h2 {
		margin-bottom: 18px;
		font-size:
			clamp(
				2.25rem,
				4vw,
				3.55rem
			);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.section-heading > p:last-child {
		color: #666666;
		line-height: 1.75;
	}

	.contact-options {
		background: #f7f7f7;
	}

	.options-grid {
		display: grid;
		grid-template-columns:
			repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.option-card {
		display: flex;
		flex-direction: column;
		min-height: 300px;
		padding: 28px;
		background: white;
		border: 1px solid #dedede;
		border-radius: 12px;
	}

	.option-card.featured {
		border-top: 4px solid #ed1c24;
		background: #fffafa;
	}

	.option-card.unsure {
		background: #111111;
		border-color: #111111;
		color: white;
	}

	.option-number {
		margin-bottom: 34px;
		color: #ed1c24;
		font-size: 0.75rem;
		font-weight: 900;
	}

	.option-kicker {
		margin: 0 0 7px !important;
		color: #8a8a8a !important;
		font-size: 0.64rem !important;
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.option-card.unsure .option-kicker {
		color: #ff464d !important;
	}

	.option-card h3 {
		margin-bottom: 10px;
		font-size: 1.4rem;
		letter-spacing: -0.02em;
	}

	.option-card p:not(.option-kicker) {
		color: #666666;
		line-height: 1.65;
	}

	.option-card.unsure p:not(.option-kicker) {
		color: #aaaaaa;
	}

	.option-card a {
		margin-top: auto;
		color: #ed1c24;
		font-weight: 900;
	}

	.option-card.unsure a {
		color: #ff464d;
	}

	.send-section {
		background: #111111;
		color: white;
	}

	.send-grid {
		display: grid;
		grid-template-columns:
			minmax(0, 0.85fr)
			minmax(0, 1.15fr);
		align-items: center;
		gap: 70px;
	}

	.eyebrow-light {
		color: #ff464d;
	}

	.send-copy > p:not(.eyebrow) {
		color: #bdbdbd;
		line-height: 1.75;
	}

	.send-copy h2 span {
		color: #ff4047;
	}

	.button-light {
		margin-top: 8px;
		background: white;
		color: #111111;
	}

	.button-light:hover {
		background: #ed1c24;
		color: white;
	}

	.send-cards {
		display: grid;
		grid-template-columns:
			repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.send-cards article {
		display: grid;
		grid-template-columns:
			32px minmax(0, 1fr);
		gap: 12px;
		padding: 22px;
		background: #181818;
		border: 1px solid #2f2f2f;
		border-radius: 9px;
	}

	.send-cards .send-featured {
		border-color: #ed1c24;
		background: #1d1516;
	}

	.send-cards article > span {
		color: #ed1c24;
		font-size: 0.72rem;
		font-weight: 900;
	}

	.send-cards h3 {
		margin-bottom: 6px;
		font-size: 1.1rem;
	}

	.send-cards p {
		margin: 0;
		color: #9f9f9f;
		font-size: 0.85rem;
		line-height: 1.55;
	}

	.next-section {
		background: white;
	}

	.next-grid {
		display: grid;
		grid-template-columns:
			repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.next-grid > article {
		padding: 30px;
		background: #f7f7f7;
		border: 1px solid #dedede;
		border-radius: 12px;
	}

	.next-grid > article.next-featured {
		border-top: 4px solid #ed1c24;
		background: #fffafa;
	}

	.next-label {
		margin: 0 0 8px;
		color: #ed1c24;
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.next-grid h3 {
		margin-bottom: 24px;
		font-size: 1.5rem;
	}

	.next-grid ol {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.next-grid li {
		display: grid;
		grid-template-columns:
			34px minmax(0, 1fr);
		gap: 12px;
		padding: 18px 0;
		border-top: 1px solid #dddddd;
	}

	.next-grid li > span {
		padding-top: 3px;
		color: #ed1c24;
		font-size: 0.72rem;
		font-weight: 900;
	}

	.next-grid li strong {
		display: block;
		margin-bottom: 4px;
	}

	.next-grid li p {
		margin: 0;
		color: #666666;
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.final-cta {
		background: #f7f7f7;
		text-align: center;
	}

	.final-inner {
