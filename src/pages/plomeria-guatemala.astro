---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Plomería en Guatemala | Drenajes e Instalaciones | AR";

const description =
	"Plomería en Guatemala para empresas, comercios y proyectos: reparación de tuberías, drenajes, instalaciones sanitarias, redes de agua y trabajos hidráulicos.";

const pageUrl =
	"https://obracivilar.com/plomeria-guatemala/";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de plomería en Guatemala y quisiera solicitar una cotización.

Tipo de trabajo o problema:
Ubicación:
¿Es reparación o instalación nueva?:
Área o medidas aproximadas:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappDrainage = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de drenaje.

Tipo de drenaje o problema:
Ubicación:
Metros lineales aproximados:
Diámetro de tubería si lo conozco:
¿La tubería iría bajo piso?: Sí / No / No sé
¿Puedo enviar fotografías o planos?: Sí`
);

const whatsappRepair = createWhatsAppLink(
	`Hola, necesito cotizar una reparación de plomería.

Problema que presenta:
Ubicación:
¿Dónde está la tubería o instalación?:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappInstallation = createWhatsAppLink(
	`Hola, necesito cotizar una instalación de plomería.

Tipo de instalación:
Ubicación:
¿Es obra nueva o remodelación?:
Puntos o áreas a conectar:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué trabajos de plomería realizan en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede evaluar reparación y modificación de tuberías, instalaciones nuevas, drenajes, instalaciones sanitarias, conexiones de agua y trabajos hidráulicos según el alcance del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan drenajes además de plomería?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR ha ejecutado trabajos de drenaje que incluyen apertura, excavación, colocación de tubería, relleno y restitución de superficies. El alcance se define según la condición existente.",
			},
		},
		{
			"@type": "Question",
			name: "¿Pueden instalar tubería bajo piso?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí, cuando el proyecto lo requiere. Antes de cotizar se revisan recorrido, profundidad, diámetro, interferencias, accesos y el tipo de superficie que deberá restituirse.",
			},
		},
		{
			"@type": "Question",
			name: "¿Atienden instalaciones sanitarias?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Se pueden evaluar conexiones e instalaciones para aparatos sanitarios, redes de agua y drenaje dentro de remodelaciones, adecuaciones y obra nueva.",
			},
		},
		{
			"@type": "Question",
			name: "¿La cotización puede incluir materiales y mano de obra?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Dependiendo del trabajo, la propuesta puede incluir tubería, accesorios, materiales complementarios, mano de obra y trabajos de obra civil relacionados.",
			},
		},
		{
			"@type": "Question",
			name: "¿Necesitan visitar el lugar antes de cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Depende del alcance. Fotografías, medidas y planos permiten una revisión inicial; trabajos con tubería oculta, drenajes o interferencias pueden requerir visita técnica.",
			},
		},
	],
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "Plomería en Guatemala",
	description,
	url: pageUrl,
	image:
		"https://obracivilar.com/images/projects/drenaje-pluvial-pvc-bajo-piso.jpeg",
	serviceType: [
		"Plomería",
		"Reparación de tuberías",
		"Drenajes",
		"Instalaciones sanitarias",
		"Instalaciones hidráulicas",
	],
	areaServed: {
		"@type": "Country",
		name: "Guatemala",
	},
	provider: {
		"@type": "Organization",
		name: "Multiservicios Obra Civil AR",
		url: "https://obracivilar.com/",
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "https://obracivilar.com/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Servicios de obra civil en Guatemala",
			item: "https://obracivilar.com/servicios-obra-civil-guatemala/",
		},
		{
			"@type": "ListItem",
			position: 3,
			name: "Plomería en Guatemala",
			item: pageUrl,
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/projects/drenaje-pluvial-pvc-bajo-piso.jpeg"
	imageAlt="Instalación de drenaje pluvial con tubería PVC bajo piso ejecutada por Multiservicios Obra Civil AR en Guatemala"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(serviceSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<section class="plumbing-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					PLOMERÍA EN GUATEMALA
				</p>

				<h1>
					Plomería, tuberías
					<span>y drenajes para proyectos.</span>
				</h1>

				<p class="hero-lead">
					Reparaciones, instalaciones nuevas, drenajes,
					redes de agua y trabajos sanitarios para empresas,
					comercios, remodelaciones y proyectos en Guatemala.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#trabajos-reales"
					>
						Ver trabajos reales
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Reparación + instalación</span>
					<span>✓ Materiales + mano de obra</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<div class="hero-media">
				<img
					src="/images/projects/drenaje-pluvial-pvc-bajo-piso.jpeg"
					alt="Instalación de tubería PVC para drenaje pluvial bajo piso durante proyecto de obra civil"
					loading="eager"
					decoding="async"
				/>

				<div class="hero-media-caption">
					<span>PROYECTO EJECUTADO</span>
					<strong>Drenaje pluvial instalado bajo piso</strong>
					<p>≈44 m lineales · PVC Ø6"</p>
				</div>
			</div>
		</div>
	</section>

	<section class="proof-strip">
		<div class="container proof-grid">
			<div>
				<strong>≈44 m</strong>
				<span>de drenaje pluvial documentado</span>
			</div>

			<div>
				<strong>PVC Ø6"</strong>
				<span>en proyecto bajo piso</span>
			</div>

			<div>
				<strong>2 × 2,400 L</strong>
				<span>en sistema de almacenamiento ejecutado</span>
			</div>
		</div>
	</section>

	<section class="section services-section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					SERVICIOS DE PLOMERÍA
				</p>

				<h2>
					No todo problema de tubería
					<span>se resuelve de la misma forma.</span>
				</h2>

				<p>
					Antes de cotizar revisamos qué instalación existe,
					dónde está ubicada, qué debe modificarse y si el
					trabajo requiere también apertura, reparación o
					restitución de superficies.
				</p>
			</div>

			<div class="service-grid">
				<article class="service-card featured">
					<span class="service-number">01</span>

					<h3>Reparación de tuberías</h3>

					<p>
						Intervenciones en redes existentes cuando se
						requiere corregir, sustituir o modificar tramos.
					</p>

					<ul>
						<li>Correcciones y cambios de tramo</li>
						<li>Adaptaciones de instalaciones</li>
						<li>Revisión según condición existente</li>
					</ul>

					<a
						href={whatsappRepair}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar reparación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">02</span>

					<h3>Drenajes</h3>

					<p>
						Nuevas líneas, modificaciones y trabajos de obra
						civil asociados a conducción pluvial o sanitaria.
					</p>

					<ul>
						<li>Tubería bajo piso</li>
						<li>Excavación y colocación</li>
						<li>Relleno y restitución</li>
					</ul>

					<a
						href={whatsappDrainage}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar drenaje →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">03</span>

					<h3>Instalaciones nuevas</h3>

					<p>
						Distribución de agua y conexiones para obra nueva,
						ampliaciones, remodelaciones y adecuaciones.
					</p>

					<ul>
						<li>Redes de agua</li>
						<li>Conexiones y accesorios</li>
						<li>Puntos según proyecto</li>
					</ul>

					<a
						href={whatsappInstallation}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar instalación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">04</span>

					<h3>Instalaciones sanitarias</h3>

					<p>
						Conexiones de agua y drenaje para aparatos
						sanitarios dentro de adecuaciones y remodelaciones.
					</p>

					<ul>
						<li>Lavamanos e inodoros</li>
						<li>Alimentación de agua</li>
						<li>Descargas sanitarias</li>
					</ul>

					<a
						href={whatsappInstallation}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar instalación sanitaria →
					</a>
				</article>
			</div>
		</div>
	</section>

	<section
		class="section case-section"
		id="trabajos-reales"
	>
		<div class="container case-grid">
			<div class="case-media">
				<img
					src="/images/projects/drenaje-pluvial-pvc-bajo-piso.jpeg"
					alt="Zanja con tubería PVC durante instalación de drenaje pluvial bajo piso en Guatemala"
					loading="lazy"
					decoding="async"
				/>

				<span class="photo-badge">
					PROYECTO REAL
				</span>
			</div>

			<div class="case-copy">
				<p class="eyebrow">
					CASO DOCUMENTADO · DRENAJE
				</p>

				<h2>
					Nueva línea pluvial
					<span>instalada bajo piso.</span>
				</h2>

				<p class="case-intro">
					El proyecto requería independizar la conducción
					de aguas pluviales y aguas negras mediante una
					nueva línea de drenaje.
				</p>

				<div class="case-stat">
					<strong>≈44 m lineales</strong>
					<span>de tubería PVC Ø6"</span>
				</div>

				<div class="case-steps">
					<div>
						<span>01</span>
						<p>
							<strong>Apertura y excavación</strong>
							Preparación del recorrido bajo piso.
						</p>
					</div>

					<div>
						<span>02</span>
						<p>
							<strong>Colocación de tubería</strong>
							Instalación de la nueva conducción.
						</p>
					</div>

					<div>
						<span>03</span>
						<p>
							<strong>Relleno y restitución</strong>
							Material selecto y acabado final con concreto.
						</p>
					</div>
				</div>

				<a
					class="button"
					href={whatsappDrainage}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar un drenaje similar
				</a>
			</div>
		</div>
	</section>

	<section class="section gallery-section">
		<div class="container">
			<div class="gallery-heading">
				<div>
					<p class="eyebrow">
						TRABAJO VISIBLE Y OCULTO
					</p>

					<h2>
						La plomería también está
						<span>detrás de los acabados.</span>
					</h2>
				</div>

				<p>
					Una instalación puede terminar en un aparato sanitario,
					pero antes requiere recorridos, conexiones, válvulas,
					pendientes y coordinación con la obra.
				</p>
			</div>

			<div class="gallery-grid">
				<article class="gallery-card gallery-card-wide">
					<img
						src="/images/servicios/plomeria/instalacion-sanitaria-inodoro-lavamanos.jpeg"
						alt="Instalación sanitaria terminada con lavamanos e inodoro en proyecto de remodelación"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>INSTALACIÓN SANITARIA</span>
						<strong>Conexiones listas para el uso del espacio</strong>
					</div>
				</article>

				<article class="gallery-card">
					<img
						src="/images/servicios/plomeria/plomeria-bajo-piso-instalacion.jpeg"
						alt="Red de plomería expuesta durante apertura de piso y muro"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>REDES INTERIORES</span>
						<strong>Tubería antes de cerrar acabados</strong>
					</div>
				</article>

				<article class="gallery-card">
					<img
						src="/images/projects/instalacion-tinacos-2400-litros.jpeg"
						alt="Sistema de almacenamiento de agua con dos tinacos e interconexión hidráulica"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>ALMACENAMIENTO DE AGUA</span>
						<strong>Depósitos, tubería y conexión del sistema</strong>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section scope-section">
		<div class="container scope-grid">
			<div class="scope-copy">
				<p class="eyebrow eyebrow-light">
					ANTES DE COTIZAR
				</p>

				<h2>
					Primero definimos
					<span>qué hay que intervenir.</span>
				</h2>

				<p>
					En plomería, una tubería visible no siempre cuenta
					toda la historia. El recorrido, la conexión existente,
					el acceso y el acabado alrededor pueden cambiar
					completamente el trabajo.
				</p>

				<a
					class="button button-light"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Enviar fotografías
				</a>
			</div>

			<div class="scope-list">
				<article>
					<span>01</span>
					<div>
						<h3>Ubicación del problema</h3>
						<p>Piso, muro, cielo, exterior o área técnica.</p>
					</div>
				</article>

				<article>
					<span>02</span>
					<div>
						<h3>Tipo de instalación</h3>
						<p>Agua potable, sanitaria, pluvial u otra red.</p>
					</div>
				</article>

				<article>
					<span>03</span>
					<div>
						<h3>Accesos y acabados</h3>
						<p>Qué debe abrirse y qué necesita restituirse.</p>
					</div>
				</article>

				<article class="scope-featured">
					<span>04</span>
					<div>
						<h3>Alcance completo</h3>
						<p>Materiales, mano de obra y trabajos complementarios.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section related-section">
		<div class="container related-grid">
			<div>
				<p class="eyebrow">
					¿TAMBIÉN NECESITA EQUIPO?
				</p>

				<h2>
					Plomería e hidráulica
					<span>pueden formar parte del mismo proyecto.</span>
				</h2>

				<p>
					Además de la ejecución, AR puede cotizar contadores
					de agua, válvulas, uniones tipo Dresser, kits y
					accesorios cuando la instalación lo requiere.
				</p>
			</div>

			<div class="related-actions">
				<a
					class="button"
					href="/suministros-hidraulicos-guatemala/"
				>
					Ver suministros hidráulicos
				</a>

				<a
					class="text-link"
					href="/contadores-de-agua-guatemala/"
				>
					Ver contadores de agua →
				</a>
			</div>
		</div>
	</section>

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar
					<span>plomería y drenajes.</span>
				</h2>

				<p>
					Fotografías, ubicación y una descripción clara
					del problema ayudan a determinar si podemos iniciar
					con una revisión remota o si conviene visitar el sitio.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué trabajos de plomería realizan en Guatemala?
					</summary>
					<p>
						Podemos evaluar reparación y modificación de tuberías,
						instalaciones nuevas, drenajes, instalaciones sanitarias,
						conexiones de agua y trabajos hidráulicos según proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿Trabajan drenajes además de plomería?
					</summary>
					<p>
						Sí. Hemos ejecutado trabajos que incluyen apertura,
						excavación, colocación de tubería, relleno y restitución
						de superficies.
					</p>
				</details>

				<details>
					<summary>
						¿Pueden instalar tubería bajo piso?
					</summary>
					<p>
						Sí, cuando el proyecto lo requiere. Se revisan recorrido,
						profundidad, diámetro, interferencias y el tipo de
						superficie que deberá restituirse.
					</p>
				</details>

				<details>
					<summary>
						¿Atienden instalaciones sanitarias?
					</summary>
					<p>
						Sí. Se pueden evaluar conexiones para aparatos sanitarios,
						redes de agua y drenaje dentro de remodelaciones,
						adecuaciones y obra nueva.
					</p>
				</details>

				<details>
					<summary>
						¿La cotización puede incluir materiales y mano de obra?
					</summary>
					<p>
						Sí. El alcance puede incluir tubería, accesorios,
						materiales complementarios, mano de obra y trabajos
						de obra civil relacionados.
					</p>
				</details>

				<details>
					<summary>
						¿Necesitan visitar el lugar?
					</summary>
					<p>
						Depende del trabajo. Fotografías, medidas y planos
						permiten una revisión inicial; instalaciones ocultas
						o drenajes pueden requerir visita técnica.
					</p>
				</details>

				<details>
					<summary>
						¿Emiten factura FEL?
					</summary>
					<p>
						Sí. Los trabajos pueden documentarse mediante
						factura electrónica FEL.
					</p>
				</details>
			</div>
		</div>
	</section>

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN DE PLOMERÍA
			</p>

			<h2>
				¿Tiene una tubería, drenaje o instalación por resolver?
			</h2>

			<p>
				Envíenos fotografías, ubicación y una descripción del
				requerimiento. Revisamos el alcance antes de preparar
				la propuesta.
			</p>

			<a
				class="button"
				href={whatsappGeneral}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar por WhatsApp
			</a>
		</div>
	</section>

	<section class="legal-note">
		<div class="container">
			<p>
				La disponibilidad de materiales, plazos y alcance se confirma
				al momento de cotizar. Algunos trabajos pueden requerir
				visita técnica y apertura exploratoria antes de definir
				la solución final.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.plumbing-hero {
		padding: 56px 0;
		background:
			linear-gradient(
				115deg,
				#ffffff 0%,
				#ffffff 57%,
				#eeeeee 100%
			);
	}

	.hero-grid {
		display: grid;
		grid-template-columns:
			minmax(0, 1.02fr)
			minmax(410px, 0.98fr);
		align-items: center;
		gap: 62px;
	}

	.hero-copy h1 {
		max-width: 840px;
		margin-bottom: 22px;
		font-size: clamp(3rem, 4.65vw, 4.6rem);
		line-height: 0.97;
