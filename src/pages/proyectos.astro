---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Proyectos de Obra Civil en Guatemala | Portafolio AR";

const description =
	"Proyectos reales de obra civil en Guatemala: oficinas, estructuras metálicas, drenajes, hidráulica, remodelaciones y Deck WPC ejecutados por AR.";

const whatsappProjects = createWhatsAppLink(
	`Hola, vi su portafolio de proyectos y quisiera solicitar una cotización.

Tipo de proyecto:
Ubicación:
Área o medidas aproximadas:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

function createProjectQuoteLink(projectName: string, requestedData: string) {
	return createWhatsAppLink(
		`Hola, vi en su portafolio el proyecto "${projectName}" y necesito algo similar.

${requestedData}
Ubicación:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:

¿Me pueden indicar qué necesitan para revisar el proyecto?`
	);
}

const projects = [
	{
		number: "01",
		category: "Construcción integral",
		title: "Oficinas administrativas sobre estructura metálica",
		image: "/images/projects/oficinas-administrativas-estructura-metalica.jpeg",
		alt: "Proyecto de obra civil en Guatemala con oficinas administrativas construidas sobre estructura metálica",
		description:
			"Construcción de un nivel completo de oficinas sobre un área existente de estacionamiento, integrando estructura, cerramientos, instalaciones y acabados.",
		metrics: ["≈55.62 m²", "Estructura + acabados"],
		details:
			"Estructura metálica, tablayeso y DensGlass, techo, ventanas, puertas, piso, pintura, electricidad, plomería, gradas y acabados finales.",
		href: "/servicios-obra-civil-guatemala/",
		linkLabel: "Ver servicios de obra civil",
		quoteLabel: "Quiero un proyecto similar",
		quoteHref: createProjectQuoteLink(
			"Oficinas administrativas sobre estructura metálica",
			`Área aproximada que necesito:
¿Es construcción nueva, ampliación o remodelación?:`
		),
	},
	{
		number: "02",
		category: "Obra civil + drenajes",
		title: "Independización de drenaje pluvial bajo piso",
		image: "/images/projects/drenaje-pluvial-pvc-bajo-piso.jpeg",
		alt: "Proyecto de drenaje pluvial con tubería PVC bajo piso ejecutado en Guatemala",
		description:
			"Intervención para separar la conducción de aguas pluviales y aguas negras mediante una nueva línea instalada bajo piso.",
		metrics: ["≈44 m lineales", 'PVC Ø6"'],
		details:
			"Apertura y excavación, colocación de tubería, relleno con material selecto y restitución final con concreto.",
		href: "/servicios-obra-civil-guatemala/",
		linkLabel: "Ver plomería y obra civil",
		quoteLabel: "Cotizar drenaje similar",
		quoteHref: createProjectQuoteLink(
			"Independización de drenaje pluvial bajo piso",
			`Metros lineales aproximados:
Diámetro de tubería si lo conozco:
¿La tubería iría bajo piso?: Sí / No / No sé`
		),
	},
	{
		number: "03",
		category: "Herrería + seguridad industrial",
		title: "Barandal metálico de protección para área de mercadería",
		image: "/images/projects/barandal-seguridad-industrial.jpeg",
		alt: "Proyecto de herrería con barandal metálico de seguridad industrial instalado por AR",
		description:
			"Fabricación e instalación de protección metálica corrida para delimitar y resguardar un área operativa.",
		metrics: ["≈46.24 m lineales", "Fabricación + instalación"],
		details:
			"Solución metálica ejecutada a medida para mejorar la delimitación y seguridad del área.",
		href: "/servicios-obra-civil-guatemala/",
		linkLabel: "Ver herrería y soldadura",
		quoteLabel: "Cotizar herrería similar",
		quoteHref: createProjectQuoteLink(
			"Barandal metálico de protección para área de mercadería",
			`Metros lineales aproximados:
Uso o área donde se instalará:
¿Tiene medidas o diseño de referencia?: Sí / No`
		),
	},
	{
		number: "04",
		category: "Plomería + hidráulica",
		title: "Sistema de almacenamiento de agua con dos tinacos",
		image: "/images/projects/instalacion-tinacos-2400-litros.jpeg",
		alt: "Proyecto de instalación hidráulica con dos tinacos de 2400 litros en azotea",
		description:
			"Instalación de almacenamiento de agua en azotea e integración del sistema con tubería, conexiones y bombeo.",
		metrics: ["2 × 2,400 L", "Conexión a bomba"],
		details:
			"Montaje de los dos depósitos, interconexión hidráulica y conexión al sistema de suministro.",
		href: "/suministros-hidraulicos-guatemala/",
		linkLabel: "Ver soluciones hidráulicas",
		quoteLabel: "Cotizar sistema hidráulico",
		quoteHref: createProjectQuoteLink(
			"Sistema de almacenamiento de agua con dos tinacos",
			`Capacidad aproximada que necesita:
Cantidad de depósitos:
¿Necesita bomba / conexiones?: Sí / No / No sé`
		),
	},
	{
		number: "05",
		category: "Remodelación + acabados",
		title: "Renovación de piso interior en restaurante",
		image: "/images/projects/remodelacion-piso-deck-pvc-restaurante.jpeg",
		alt: "Proyecto de remodelación de piso interior en restaurante ejecutado por AR",
		description:
			"Renovación de un área interior afectada por humedad mediante preparación de la base e instalación de piso Deck en PVC.",
		metrics: ["≈78 m²", "Preparación + instalación"],
		details:
			"Se trabajó la base antes de colocar el acabado final para resolver la condición existente y renovar el espacio.",
		href: "/servicios-obra-civil-guatemala/",
		linkLabel: "Ver remodelaciones",
		quoteLabel: "Cotizar remodelación similar",
		quoteHref: createProjectQuoteLink(
			"Renovación de piso interior en restaurante",
			`Área aproximada en m²:
Problema o condición actual:
Tipo de acabado que busca si ya lo sabe:`
		),
	},
	{
		number: "06",
		category: "Deck WPC",
		title: "Instalación de Deck WPC en área exterior",
		image: "/images/projects/hero-deck.jpeg",
		alt: "Proyecto exterior terminado con Piso Deck WPC instalado por Multiservicios Obra Civil AR",
		description:
			"Instalación de Deck WPC para renovar un espacio exterior con acabado tipo madera y una solución pensada para el uso del área.",
		metrics: ["Área exterior", "Suministro + instalación"],
		details:
			"Proyecto ejecutado por AR con suministro de material e instalación del sistema de Deck WPC.",
		href: "/deck-wpc-guatemala/",
		linkLabel: "Ver Piso Deck WPC",
		quoteLabel: "Cotizar Deck instalado",
		quoteHref: createProjectQuoteLink(
			"Instalación de Deck WPC en área exterior",
			`Área aproximada en m²:
¿Necesita solo material o instalación completa?:
¿La superficie ya está preparada?: Sí / No / No sé`
		),
	},
];

const portfolioSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Proyectos de obra civil en Guatemala | Multiservicios Obra Civil AR",
	description,
	inLanguage: "es-GT",
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: projects.length,
		itemListElement: projects.map((project, index) => ({
			"@type": "ListItem",
			position: index + 1,
			item: {
				"@type": "CreativeWork",
				name: project.title,
				description: project.description,
				image: project.image,
				about: project.category,
			},
		})),
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Proyectos de obra civil en Guatemala",
			item: "/proyectos/",
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/projects/oficinas-administrativas-estructura-metalica.jpeg"
	imageAlt="Proyecto de obra civil en Guatemala ejecutado por Multiservicios Obra Civil AR"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(portfolioSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="projects-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					PORTAFOLIO DE PROYECTOS EN GUATEMALA
				</p>

				<h1>
					Proyectos de obra civil
					<span>ejecutados en Guatemala.</span>
				</h1>

				<p class="hero-lead">
					Proyectos reales de construcción, estructuras,
					drenajes, instalaciones hidráulicas, remodelaciones
					y Deck WPC. Mostramos el problema, el alcance y
					la solución ejecutada por AR.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href="#proyectos"
					>
						Ver proyectos
					</a>

					<a
						class="button button-secondary"
						href={whatsappProjects}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar un proyecto
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Fotografías de trabajos reales</span>
					<span>✓ Alcances documentados</span>
					<span>✓ Ejecución en Guatemala</span>
				</div>
			</div>

			<div class="hero-showcase">
				<img
					src="/images/projects/oficinas-administrativas-estructura-metalica.jpeg"
					alt="Proyecto integral de oficinas administrativas con estructura metálica ejecutado en Guatemala"
					loading="eager"
					decoding="async"
				/>

				<div class="hero-showcase-overlay">
					<span>PROYECTO DESTACADO</span>

					<strong>
						Construcción integral de oficinas
					</strong>

					<p>
						≈55.62 m² · estructura, instalaciones y acabados
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PROOF STRIP
	================================================== -->

	<section class="proof-strip">
		<div class="container proof-grid">
			<div>
				<strong>6</strong>
				<span>proyectos destacados en esta selección</span>
			</div>

			<div>
				<strong>55.62 m²</strong>
				<span>oficinas en proyecto integral</span>
			</div>

			<div>
				<strong>≈44 m</strong>
				<span>de drenaje pluvial bajo piso</span>
			</div>

			<div>
				<strong>2 × 2,400 L</strong>
				<span>en sistema de almacenamiento de agua</span>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FEATURED CASE
	================================================== -->

	<section class="section case-study">
		<div class="container case-grid">
			<div class="case-image">
				<img
					src="/images/projects/oficinas-administrativas-estructura-metalica.jpeg"
					alt="Resultado de construcción de oficinas administrativas sobre estructura metálica en Guatemala"
					loading="lazy"
					decoding="async"
				/>

				<span class="photo-badge">
					PROYECTO REAL
				</span>
			</div>

			<div class="case-copy">
				<p class="eyebrow">
					CASO DESTACADO · OBRA CIVIL
				</p>

				<h2>
					Construcción de oficinas
					<span>sobre estructura metálica.</span>
				</h2>

				<p class="case-intro">
					El requerimiento era habilitar un nivel completo
					de oficinas manteniendo disponible el espacio
					inferior para estacionamiento.
				</p>

				<div class="case-block">
					<span>NECESIDAD</span>

					<p>
						Crear aproximadamente 55.62 m² de oficinas
						administrativas sobre una superficie existente.
					</p>
				</div>

				<div class="case-block">
					<span>ALCANCE</span>

					<p>
						Integrar estructura, cerramientos, instalaciones,
						cubierta, circulación y acabados dentro de una
						misma ejecución.
					</p>
				</div>

				<div class="case-block">
					<span>SOLUCIÓN EJECUTADA</span>

					<p>
						Proyecto integral desde la estructura metálica
						hasta tablayeso, DensGlass, techo, electricidad,
						plomería, piso, pintura, gradas y acabados.
					</p>
				</div>

				<div class="scope-tags">
					<span>Estructura metálica</span>
					<span>Tablayeso / DensGlass</span>
					<span>Electricidad</span>
					<span>Plomería</span>
					<span>Piso y pintura</span>
					<span>Gradas y acabados</span>
				</div>

				<div class="case-actions">
					<a
						class="button"
						href={projects[0].quoteHref}
						target="_blank"
						rel="noopener noreferrer"
					>
						Quiero un proyecto similar
					</a>

					<a
						class="case-text-link"
						href="/servicios-obra-civil-guatemala/"
					>
						Ver servicios de obra civil →
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PROJECT GRID
	================================================== -->

	<section
		class="section portfolio-section"
		id="proyectos"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					PROYECTOS DESTACADOS
				</p>

				<h2>
					Obra civil, instalaciones
					<span>y remodelaciones reales.</span>
				</h2>

				<p>
					Esta selección muestra diferentes tipos de
					requerimiento y ejecución. Si algún caso se parece
					a lo que necesita, puede escribirnos directamente
					desde ese proyecto para revisar su propio alcance.
				</p>
			</div>

			<div class="portfolio-grid">
				{
					projects.map((project) => (
						<article class="project-card">
							<a
								class="project-image"
								href={project.href}
								aria-label={`${project.linkLabel}: ${project.title}`}
							>
								<img
									src={project.image}
									alt={project.alt}
									loading="lazy"
									decoding="async"
								/>

								<span class="project-number">
									{project.number}
								</span>
							</a>

							<div class="project-body">
								<p class="project-category">
									{project.category}
								</p>

								<h3>
									{project.title}
								</h3>

								<p class="project-description">
									{project.description}
								</p>

								<div class="project-metrics">
									{
										project.metrics.map((metric) => (
											<span>{metric}</span>
										))
									}
								</div>

								<p class="project-detail">
									{project.details}
								</p>

								<div class="project-actions">
									<a
										class="project-quote"
										href={project.quoteHref}
										target="_blank"
										rel="noopener noreferrer"
									>
										{project.quoteLabel}
									</a>

									<a
										class="project-link"
										href={project.href}
									>
										{project.linkLabel} →
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="project-conversion-strip">
		<div class="container conversion-strip-inner">
			<div>
				<span>¿NO SABE CÓMO PEDIRLO?</span>
				<strong>
					Mándenos una foto del problema o del área.
				</strong>
				<p>
					Podemos empezar con fotografías, ubicación y medidas
					aproximadas. Después le indicamos qué hace falta
					para definir el alcance.
				</p>
			</div>

			<a
				class="button"
				href={whatsappProjects}
				target="_blank"
				rel="noopener noreferrer"
			>
				Enviar mi requerimiento
			</a>
		</div>
	</section>

	<!-- ==================================================
	     SPECIALTIES
	================================================== -->

	<section class="section specialties-section">
		<div class="container">
			<div class="section-heading specialties-heading">
				<p class="eyebrow">
					DEL PORTAFOLIO A SU REQUERIMIENTO
				</p>

				<h2>
					Explore la especialidad
					<span>que más se parece a su proyecto.</span>
				</h2>
			</div>

			<div class="specialties-grid">
				<a href="/servicios-obra-civil-guatemala/">
					<span>01</span>
					<strong>Obra civil y mantenimiento</strong>
					<p>
						Remodelaciones, tablayeso, pintura,
						plomería, impermeabilización y herrería.
					</p>
					<em>Ver servicios →</em>
				</a>

				<a href="/suministros-hidraulicos-guatemala/">
					<span>02</span>
					<strong>Suministros e instalaciones hidráulicas</strong>
					<p>
						Woltmann, Dresser, válvulas, accesorios
						y requerimientos hidráulicos.
					</p>
					<em>Ver hidráulicos →</em>
				</a>

				<a href="/deck-wpc-guatemala/">
					<span>03</span>
					<strong>Piso Deck WPC</strong>
					<p>
						Material e instalación para terrazas,
						balcones y áreas exteriores.
					</p>
					<em>Ver Deck WPC →</em>
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CAPABILITIES
	================================================== -->

	<section class="section capabilities-section">
		<div class="container capabilities-grid">
			<div class="capabilities-copy">
				<p class="eyebrow eyebrow-light">
					DE LA REPARACIÓN AL PROYECTO INTEGRAL
				</p>

				<h2>
					El alcance se define
					<span>según la necesidad.</span>
				</h2>

				<p>
					Algunos trabajos son intervenciones puntuales.
					Otros combinan estructura, instalaciones,
					acabados y coordinación de varias especialidades.
				</p>

				<a
					class="button button-light"
					href="/servicios-obra-civil-guatemala/"
				>
					Ver servicios de obra civil
				</a>
			</div>

			<div class="capability-cards">
				<article>
					<span>01</span>
					<div>
						<h3>Obra civil</h3>
						<p>Intervenciones, adecuaciones y ejecución de infraestructura.</p>
					</div>
				</article>

				<article>
					<span>02</span>
					<div>
						<h3>Estructuras y herrería</h3>
						<p>Fabricación, protecciones, barandales y elementos metálicos.</p>
					</div>
				</article>

				<article>
					<span>03</span>
					<div>
						<h3>Hidráulica</h3>
						<p>Tuberías, almacenamiento, contadores, válvulas y conexiones.</p>
					</div>
				</article>

				<article class="capability-featured">
					<span>04</span>
					<div>
						<h3>Remodelaciones</h3>
						<p>Preparación, reparación, acabados, pisos y renovación de espacios.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     EVIDENCE
	================================================== -->

	<section class="section evidence-section">
		<div class="container evidence-grid">
			<div>
				<p class="eyebrow">
					EVIDENCIA ANTES QUE PROMESAS
				</p>

				<h2>
					Un proyecto debe
					<span>poder explicarse.</span>
				</h2>
			</div>

			<div class="evidence-list">
				<article>
					<span>01</span>
					<div>
						<h3>El problema</h3>
						<p>Qué condición o necesidad debía resolverse.</p>
					</div>
				</article>

				<article>
					<span>02</span>
					<div>
						<h3>El alcance</h3>
						<p>Qué trabajos, materiales y especialidades fueron necesarios.</p>
					</div>
				</article>

				<article>
					<span>03</span>
					<div>
						<h3>La ejecución</h3>
						<p>Cómo se materializó la solución en el sitio.</p>
					</div>
				</article>

				<article>
					<span>04</span>
					<div>
						<h3>El resultado</h3>
						<p>Una referencia real para futuros proyectos similares.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FINAL CTA
	================================================== -->

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				SU PROYECTO
			</p>

			<h2>
				¿Vio un proyecto parecido al suyo?
			</h2>

			<p>
				No necesita tener planos perfectos para iniciar.
				Envíenos fotografías, ubicación y medidas aproximadas;
				revisamos qué información falta antes de cotizar.
			</p>

			<a
				class="button"
				href={whatsappProjects}
				target="_blank"
				rel="noopener noreferrer"
			>
				Revisar mi proyecto por WhatsApp
			</a>
		</div>
	</section>

	<section class="portfolio-note">
		<div class="container">
			<p>
				Las fotografías corresponden a trabajos ejecutados y se
				presentan como referencia del tipo de proyecto. Los alcances
				y cantidades indicados corresponden a los casos documentados;
				cada nueva cotización se evalúa de forma independiente.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.projects-hero {
		padding: 82px 0;
		background:
			linear-gradient(
				115deg,
				#ffffff 0%,
				#ffffff 58%,
				#f0f0f0 100%
			);
	}

	.hero-grid {
		display: grid;
		grid-template-columns:
			minmax(0, 0.92fr)
			minmax(420px, 1.08fr);
