---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/Hero.astro";
import Solutions from "../components/Solutions.astro";
import ExecutionOptions from "../components/ExecutionOptions.astro";
import ContactCTA from "../components/ContactCTA.astro";

const title =
	"Multiservicios Obra Civil AR | Guatemala";

const description =
	"Obra civil, suministros hidráulicos y Deck WPC para empresas, proyectos y clientes en Guatemala. Suministro e instalación disponibles.";
---

<BaseLayout
	title={title}
	description={description}
>
	<Hero />

	<Solutions />

	<ExecutionOptions />

	<ContactCTA />
</BaseLayout>