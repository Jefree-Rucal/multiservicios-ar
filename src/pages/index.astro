---
const whatsappLink = "#contacto";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>Multiservicios Obra Civil AR | Guatemala</title>

		<meta
			name="description"
			content="Obra civil, suministros hidráulicos y Deck WPC para empresas, proyectos y clientes en Guatemala. Suministro e instalación disponibles."
		/>
	</head>

	<body>
		<!-- ==================================================
		     HEADER
		================================================== -->

		<header class="header">
			<div class="container nav">
				<a
					href="/"
					class="brand"
					aria-label="Multiservicios Obra Civil AR"
				>
					<img
						src="/images/brand/logo-ar-header.png"
						alt="Multiservicios Obra Civil AR"
					/>
				</a>

				<nav
					class="desktop-nav"
					aria-label="Navegación principal"
				>
					<a href="#servicios">Servicios</a>
					<a href="#hidraulicos">Hidráulicos</a>
					<a href="#deck">Deck WPC</a>
					<a href="#proyectos">Proyectos</a>
				</nav>

				<div class="nav-actions">
					<a
						class="button button-small"
						href={whatsappLink}
					>
						Cotizar
					</a>

					<details class="mobile-menu">
						<summary aria-label="Abrir menú">
							<span></span>
							<span></span>
							<span></span>
						</summary>

						<nav class="mobile-menu-panel">
							<a href="#servicios">
								Servicios
							</a>

							<a href="#hidraulicos">
								Hidráulicos
							</a>

							<a href="#deck">
								Deck WPC
							</a>

							<a href="#proyectos">
								Proyectos
							</a>

							<a
								href={whatsappLink}
								class="mobile-quote"
							>
								Solicitar cotización
							</a>
						</nav>
					</details>
				</div>
			</div>
		</header>

		<main>
			<!-- ==================================================
			     HERO
			================================================== -->

			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">
							CONSTRUCCIÓN · SUMINISTRO · INSTALACIÓN
						</p>

						<h1>
							Soluciones para
							<span>
								infraestructura y proyectos.
							</span>
						</h1>

						<p class="lead">
							Obra civil, suministros hidráulicos y
							Deck WPC para empresas, proyectos y
							clientes en Guatemala.
						</p>

						<div class="hero-actions">
							<a
								class="button"
								href={whatsappLink}
							>
								Solicitar cotización
							</a>

							<a
								class="button button-secondary"
								href="#soluciones"
							>
								Ver soluciones
							</a>
						</div>

						<div class="hero-trust">
							<span>✓ Suministro</span>
							<span>✓ Instalación</span>
							<span>✓ Facturación</span>
						</div>
					</div>

					<div class="hero-project">
						<img
							src="/images/projects/hero-deck.jpeg"
							alt="Proyecto de Deck WPC instalado por Multiservicios Obra Civil AR"
						/>

						<div class="project-overlay">
							<span class="project-label">
								PROYECTO EJECUTADO POR AR
							</span>

							<strong>
								Suministro + instalación
							</strong>

							<p>
								Deck WPC para exterior
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ==================================================
			     SOLUCIONES
			================================================== -->

			<section
				class="section"
				id="soluciones"
			>
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">
							NUESTRAS SOLUCIONES
						</p>

						<h2>
							Una empresa. Tres líneas de trabajo.
						</h2>

						<p>
							Puede contratar únicamente el suministro
							o solicitar una solución completa con
							instalación.
						</p>
					</div>

					<div class="cards">
						<!-- OBRA CIVIL -->

						<article
							class="card"
							id="servicios"
						>
							<div class="card-top">
								<span class="card-number">
									01
								</span>

								<span class="card-line"></span>
							</div>

							<h3>
								Obra Civil y Mantenimiento
							</h3>

							<p>
								Remodelaciones, reparaciones,
								drenajes, plomería, tablayeso,
								pintura, herrería e infraestructura.
							</p>

							<a href="#">
								Ver servicios →
							</a>
						</article>

						<!-- HIDRÁULICOS -->

						<article
							class="card card-featured"
							id="hidraulicos"
						>
							<div class="card-top">
								<span class="card-number">
									02
								</span>

								<span class="card-line"></span>
							</div>

							<h3>
								Suministros Hidráulicos
							</h3>

							<p>
								Contadores de agua, válvulas de
								compuerta, uniones Dresser,
								medidores bridados y accesorios.
							</p>

							<a href="#">
								Ver catálogo →
							</a>
						</article>

						<!-- DECK -->

						<article
							class="card"
							id="deck"
						>
							<div class="card-top">
								<span class="card-number">
									03
								</span>

								<span class="card-line"></span>
							</div>

							<h3>
								Deck WPC
							</h3>

							<p>
								Venta por caja o volumen para
								terrazas, exteriores y proyectos.
								Instalación disponible.
							</p>

							<a href="#">
								Ver Deck →
							</a>
						</article>
					</div>
				</div>
			</section>

			<!-- ==================================================
			     SUMINISTRO + EJECUCIÓN
			================================================== -->

			<section
				class="section dark-section"
				id="proyectos"
			>
				<div class="container execution-grid">
					<div class="execution-copy">
						<p class="eyebrow eyebrow-light">
							SUMINISTRO + EJECUCIÓN
						</p>

						<h2>
							Compre el material
							<span>
								o resuelva el proyecto completo.
							</span>
						</h2>

						<p>
							Nos adaptamos al alcance que necesita:
							desde el suministro de materiales hasta
							la instalación y ejecución del proyecto.
						</p>

						<a
							class="button button-light"
							href={whatsappLink}
						>
							Cuéntenos qué necesita
						</a>
					</div>

					<div class="execution-options">
						<article class="execution-option">
							<span class="option-number">
								01
							</span>

							<div>
								<h3>
									Solo suministro
								</h3>

								<p>
									¿Ya cuenta con instalador o personal
									técnico? Le cotizamos únicamente el
									producto o material.
								</p>

								<span class="option-detail">
									Unidad · Volumen · Proyecto
								</span>
							</div>
						</article>

						<article
							class="execution-option execution-option-featured"
						>
							<span class="option-number">
								02
							</span>

							<div>
								<h3>
									Suministro + instalación
								</h3>

								<p>
									Podemos evaluar el suministro,
									instalación y ejecución necesaria
									para entregar una solución completa.
								</p>

								<span class="option-detail">
									Material + Mano de obra
								</span>
							</div>
						</article>
					</div>
				</div>
			</section>

			<!-- ==================================================
			     CONTACTO
			================================================== -->

			<section
				class="section contact"
				id="contacto"
			>
				<div class="container">
					<p class="eyebrow">
						COTIZACIONES
					</p>

					<h2>
						¿Tiene un proyecto o necesita un producto?
					</h2>

					<p>
						Indíquenos qué necesita, cantidad o medidas
						y le ayudamos a preparar una cotización.
					</p>

					<a
						class="button"
						href={whatsappLink}
					>
						Contactar por WhatsApp
					</a>
				</div>
			</section>
		</main>

		<!-- ==================================================
		     FOOTER
		================================================== -->

		<footer>
			<div class="container footer">
				<div class="footer-brand">
					<img
						src="/images/brand/logo-ar-header.png"
						alt="Multiservicios Obra Civil AR"
					/>

					<p>
						Guatemala
					</p>
				</div>

				<p class="footer-divisions">
					Obra Civil · Hidráulicos · Deck WPC
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	/* ==================================================
	   BASE
	================================================== */

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 100px;
	}

	:global(body) {
		margin: 0;

		overflow-x: hidden;

		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;

		background: #f7f7f7;

		color: #111111;
	}

	section[id],
	article[id] {
		scroll-margin-top: 105px;
	}

	a {
		color: inherit;

		text-decoration: none;
	}

	.container {
		width: min(
			1180px,
			calc(100% - 48px)
		);

		margin-inline: auto;
	}

	/* ==================================================
	   HEADER
	================================================== */

	.header {
		position: sticky;

		top: 0;

		z-index: 100;

		background:
			rgba(255, 255, 255, 0.97);

		backdrop-filter:
			blur(14px);

		border-bottom:
			1px solid #e8e8e8;
	}

	.nav {
		min-height: 76px;

		display: flex;

		align-items: center;

		justify-content: space-between;

		gap: 30px;
	}

	.brand {
		display: flex;

		align-items: center;

		flex-shrink: 0;
	}

	.brand img {
		display: block;

		width: 120px;

		height: auto;
	}

	.desktop-nav {
		display: flex;

		align-items: center;

		gap: 30px;

		font-size: 0.92rem;

		font-weight: 700;
	}

	.desktop-nav a {
		transition:
			color 0.2s ease;
	}

	.desktop-nav a:hover {
		color: #ed1c24;
	}

	.nav-actions {
		display: flex;

		align-items: center;

		gap: 12px;
	}

	/* ==================================================
	   MENÚ MÓVIL
	================================================== */

	.mobile-menu {
		display: none;

		position: relative;

		z-index: 120;
	}

	.mobile-menu summary {
		width: 42px;

		height: 42px;

		display: flex;

		flex-direction: column;

		align-items: center;

		justify-content: center;

		gap: 5px;

		cursor: pointer;

		list-style: none;

		background: white;

		border:
			1px solid #dedede;

		border-radius: 6px;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu summary span {
		width: 18px;

		height: 2px;

		display: block;

		background: #111111;
	}

	.mobile-menu-panel {
		position: absolute;

		top: 52px;

		right: 0;

		z-index: 130;

		width: 245px;

		display: flex;

		flex-direction: column;

		padding: 10px;

		background: white;

		border:
			1px solid #dedede;

		border-radius: 10px;

		box-shadow:
			0 18px 50px
			rgba(0, 0, 0, 0.14);
	}

	.mobile-menu-panel a {
		padding:
			13px 14px;

		font-weight: 700;

		border-radius: 6px;
	}

	.mobile-menu-panel a:hover {
		background:
			#f5f5f5;
	}

	.mobile-menu-panel .mobile-quote {
		margin-top: 6px;

		background:
			#ed1c24;

		color: white;

		text-align: center;
	}

	.mobile-menu-panel .mobile-quote:hover {
		background:
			#c9141b;
	}

	/* ==================================================
	   BOTONES
	================================================== */

	.button {
		display: inline-flex;

		align-items: center;

		justify-content: center;

		padding:
			14px 22px;

		border-radius: 6px;

		background:
			#ed1c24;

		color: white;

		font-weight: 800;

		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.button:hover {
		background:
			#c9141b;

		transform:
			translateY(-1px);
	}

	.button-small {
		padding:
			11px 18px;
	}

	.button-secondary {
		background:
			transparent;

		color:
			#111111;

		border:
			1px solid #cccccc;
	}

	.button-secondary:hover {
		background:
			#111111;

		color:
			white;
	}

	/* ==================================================
	   HERO
	================================================== */

	.hero {
		position: relative;

		overflow: hidden;

		padding:
			92px 0;

		background:
			linear-gradient(
				90deg,
				#ffffff 0%,
				#ffffff 54%,
				#f2f2f2 100%
			);
	}

	.hero::after {
		content: "";

		position: absolute;

		width: 450px;

		height: 450px;

		right: -180px;

		bottom: -250px;

		border-radius: 50%;

		background:
			rgba(237, 28, 36, 0.07);
	}

	.hero-grid {
		position: relative;

		z-index: 1;

		display: grid;

		grid-template-columns:
			minmax(0, 1.05fr)
			minmax(420px, 0.95fr);

		align-items: center;

		gap: 48px;
	}

	.hero-copy {
		min-width: 0;
	}

	.eyebrow {
		margin:
			0 0 18px;

		font-size:
			0.78rem;

		font-weight:
			900;

		letter-spacing:
			0.14em;

		color:
			#ed1c24;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 720px;

		margin-bottom: 28px;

		font-size:
			clamp(
				3rem,
				4.6vw,
				5.15rem
			);

		line-height:
			0.96;

		letter-spacing:
			-0.055em;
	}

	h1 span {
		display: block;

		color:
			#ed1c24;
	}

	.lead {
		max-width:
			650px;

		color:
			#5f5f5f;

		font-size:
			1.12rem;

		line-height:
			1.7;
	}

	.hero-actions {
		display: flex;

		flex-wrap: wrap;

		gap: 12px;

		margin-top: 34px;
	}

	.hero-trust {
		display: flex;

		flex-wrap: wrap;

		gap: 22px;

		margin-top: 30px;

		color:
			#555555;

		font-size:
			0.92rem;

		font-weight:
			600;
	}

	/* ==================================================
	   HERO - FOTO
	================================================== */

	.hero-project {
		position: relative;

		min-height: 500px;

		overflow: hidden;

		border-radius: 14px;

		background:
			#111111;

		box-shadow:
			0 30px 70px
			rgba(0, 0, 0, 0.16);
	}

	.hero-project img {
		position: absolute;

		inset: 0;

		width: 100%;

		height: 100%;

		object-fit: cover;

		display: block;
	}

	.hero-project::after {
		content: "";

		position: absolute;

		inset: 0;

		background:
			linear-gradient(
				to top,
				rgba(0, 0, 0, 0.82)
				0%,
				rgba(0, 0, 0, 0.2)
				52%,
				rgba(0, 0, 0, 0.02)
				100%
			);
	}

	.project-overlay {
		position: absolute;

		z-index: 2;

		left: 28px;

		right: 28px;

		bottom: 28px;

		color: white;
	}

	.project-label {
		display:
			inline-block;

		margin-bottom:
			10px;

		color:
			#ff3b42;

		font-size:
			0.72rem;

		font-weight:
			900;

		letter-spacing:
			0.14em;
	}

	.project-overlay strong {
		display: block;

		margin-bottom: 6px;

		font-size: 1.45rem;
	}

	.project-overlay p {
		margin: 0;

		color:
			#dddddd;
	}

	/* ==================================================
	   SECCIONES GENERALES
	================================================== */

	.section {
		padding:
			90px 0;
	}

	.section-heading {
		max-width:
			760px;

		margin-bottom:
			42px;
	}

	h2 {
		margin-bottom:
			18px;

		font-size:
			clamp(
				2.1rem,
				4vw,
				3.4rem
			);

		line-height:
			1.05;

		letter-spacing:
			-0.04em;
	}

	.section-heading > p:last-child,
	.card p,
	.contact p {
		color:
			#666666;

		line-height:
			1.7;
	}

	/* ==================================================
	   TARJETAS
	================================================== */

	.cards {
		display: grid;

		grid-template-columns:
			repeat(3, minmax(0, 1fr));

		gap: 18px;
	}

	.card {
		min-height:
			330px;

		display: flex;

		flex-direction:
			column;

		padding:
			30px;

		background:
			white;

		border:
			1px solid #e2e2e2;

		border-radius:
			12px;

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.card:hover {
		transform:
			translateY(-3px);

		box-shadow:
			0 18px 45px
			rgba(0, 0, 0, 0.07);
	}

	.card-featured {
		border-top:
			4px solid #ed1c24;
	}

	.card-top {
		display: flex;

		align-items: center;

		gap: 12px;

		margin-bottom: auto;
	}

	.card-number {
		color:
			#ed1c24;

		font-weight:
			900;
	}

	.card-line {
		height: 1px;

		flex: 1;

		background:
			#e1e1e1;
	}

	.card h3 {
		margin-top:
			38px;

		font-size:
			1.45rem;
	}

	.card a {
		margin-top: auto;

		color:
			#ed1c24;

		font-weight:
			800;
	}

	/* ==================================================
	   SUMINISTRO + EJECUCIÓN
	================================================== */

	.dark-section {
		background:
			#111111;

		color:
			white;
	}

	.execution-grid {
		display: grid;

		grid-template-columns:
			minmax(0, 0.85fr)
			minmax(0, 1.15fr);

		gap: 65px;

		align-items: center;
	}

	.execution-copy {
		min-width: 0;
	}

	.execution-copy h2 {
		max-width:
			520px;
	}

	.execution-copy h2 span {
		display: block;

		color:
			#ff4047;
	}

	.execution-copy > p:not(.eyebrow) {
		max-width:
			520px;

		color:
			#c4c4c4;

		line-height:
			1.8;
	}

	.eyebrow-light {
		color:
			#ff4b52;
	}

	.button-light {
		margin-top:
			12px;

		background:
			white;

		color:
			#111111;
	}

	.button-light:hover {
		background:
			#ed1c24;

		color:
			white;
	}

	.execution-options {
		display: grid;

		gap:
			14px;

		min-width: 0;
	}

	.execution-option {
		display: grid;

		grid-template-columns:
			auto minmax(0, 1fr);

		gap:
			22px;

		padding:
			28px;

		border:
			1px solid #333333;

		border-radius:
			10px;

		background:
			#181818;
	}

	.execution-option-featured {
		border-color:
			#ed1c24;

		background:
			#1c1516;
	}

	.option-number {
		color:
			#ed1c24;

		font-size:
			0.82rem;

		font-weight:
			900;
	}

	.execution-option h3 {
		margin-bottom:
			10px;

		color:
			white;

		font-size:
			1.3rem;
	}

	.execution-option p {
		margin-bottom:
			15px;

		color:
			#bdbdbd;

		line-height:
			1.65;
	}

	.option-detail {
		color:
			white;

		font-size:
			0.82rem;

		font-weight:
			800;

		letter-spacing:
			0.04em;
	}

	/* ==================================================
	   CONTACTO
	================================================== */

	.contact {
		text-align:
			center;

		background:
