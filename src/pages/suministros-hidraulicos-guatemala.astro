---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Suministros Hidráulicos en Guatemala | Woltmann, Dresser y Válvulas | AR";

const description =
	"Suministros hidráulicos en Guatemala con precios de referencia para Woltmann y Dresser, además de válvulas, flanges, kits y accesorios. Suministro e instalación.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de suministros hidráulicos y quisiera comprar un producto o solicitar una cotización.

Producto o material:
Medida:
Cantidad:
Aplicación:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappWoltmann = createWhatsAppLink(
	`Hola, necesito cotizar un contador Woltmann Genebre 6060A.

Medida:
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappDresser = createWhatsAppLink(
	`Hola, necesito cotizar una unión tipo Dresser HELMAN 200 PSI.

Medida:
Cantidad:
Aplicación / tubería:
Ubicación del proyecto:
¿Necesito instalación?: Sí / No`
);

const whatsappValve = createWhatsAppLink(
	`Hola, necesito cotizar una válvula de compuerta flangeada.

Medida:
Cantidad:
Presión / especificación si la tengo:
Aplicación:
Ubicación del proyecto:
¿Necesito instalación?: Sí / No`
);

const whatsappKit = createWhatsAppLink(
	`Hola, necesito cotizar un kit de instalación hidráulica.

Tipo de equipo:
Medida:
Cantidad:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const woltmannPrices = [
	{
		size: '3"',
		ref: "6060A 11 · DN80",
		price: "Q3,050",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 3" con precio de referencia Q3,050.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
	{
		size: '4"',
		ref: "6060A 12 · DN100",
		price: "Q4,000",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 4" con precio de referencia Q4,000.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
	{
		size: '6"',
		ref: "6060A 14 · DN150",
		price: "Q5,900",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 6" con precio de referencia Q5,900.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
	{
		size: '8"',
		ref: "6060A 16 · DN200",
		price: "Q8,500",
		href: createWhatsAppLink(
			`Hola, vi el contador Woltmann Genebre 6060A de 8" con precio de referencia Q8,500.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
];

const dresserPrices = [
	{
		size: '3"',
		ref: "HELMAN · 200 PSI",
		price: "Q1,400",
		href: createWhatsAppLink(
			`Hola, vi la unión tipo Dresser HELMAN 200 PSI de 3" con precio de referencia Q1,400.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
Aplicación / tubería:
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
	{
		size: '4"',
		ref: "HELMAN · 200 PSI",
		price: "Q2,350",
		href: createWhatsAppLink(
			`Hola, vi la unión tipo Dresser HELMAN 200 PSI de 4" con precio de referencia Q2,350.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
Aplicación / tubería:
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
	{
		size: '6"',
		ref: "HELMAN · 200 PSI",
		price: "Q2,400",
		href: createWhatsAppLink(
			`Hola, vi la unión tipo Dresser HELMAN 200 PSI de 6" con precio de referencia Q2,400.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
Aplicación / tubería:
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
	{
		size: '8"',
		ref: "HELMAN · 200 PSI",
		price: "Q3,400",
		href: createWhatsAppLink(
			`Hola, vi la unión tipo Dresser HELMAN 200 PSI de 8" con precio de referencia Q3,400.

Quisiera comprar / confirmar disponibilidad.
Cantidad:
Aplicación / tubería:
¿Necesito instalación?: Sí / No
Ubicación:`
		),
	},
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué precios de referencia tienen los suministros hidráulicos?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR publica precios de referencia para equipos comparables: Woltmann Genebre 6060A desde Q3,050 y uniones tipo Dresser HELMAN 200 PSI desde Q1,400. El precio y la disponibilidad se confirman antes de cerrar la compra.",
			},
		},
		{
			"@type": "Question",
			name: "¿Qué incluye el precio publicado de Woltmann y Dresser?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"El precio publicado corresponde al producto y medida indicados. Kits, flanges, empaques, tornillería, otros materiales complementarios, entrega e instalación se cotizan por separado cuando aplican.",
			},
		},
		{
			"@type": "Question",
			name: "¿Qué suministros hidráulicos pueden cotizar en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede cotizar contadores de agua y Woltmann, uniones tipo Dresser, válvulas de compuerta flangeadas, flanges, empaques, tornillería, kits y otros accesorios según el requerimiento del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Venden uniones tipo Dresser?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar uniones tipo Dresser HELMAN 200 PSI en medidas como 3, 4, 6 y 8 pulgadas, sujetas a confirmación de especificación, precio y disponibilidad.",
			},
		},
		{
			"@type": "Question",
			name: "¿Cotizan válvulas de compuerta flangeadas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Las válvulas se cotizan según medida, tipo de conexión, presión y requerimiento de la instalación. La referencia exacta se confirma antes de preparar la propuesta.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan contadores Woltmann de 3, 4, 6 y 8 pulgadas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede cotizar la línea Genebre 6060A en medidas como 3, 4, 6 y 8 pulgadas. Otras medidas y configuraciones se revisan según el requerimiento y disponibilidad.",
			},
		},
		{
			"@type": "Question",
			name: "¿También realizan instalación de productos hidráulicos?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar únicamente el suministro o evaluar equipo, materiales complementarios y mano de obra para una solución más completa.",
			},
		},
		{
			"@type": "Question",
			name: "¿Mantienen todos los productos en inventario?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"No necesariamente. Precio y disponibilidad se confirman con la cadena de suministro al momento de cada cotización.",
			},
		},
	],
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Suministros hidráulicos en Guatemala",
			item: "/suministros-hidraulicos-guatemala/",
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/hidraulicos/union-dresser-helman-200psi.png"
	imageAlt="Suministros hidráulicos en Guatemala: unión Dresser, Woltmann y válvulas"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="hydraulic-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					SUMINISTROS HIDRÁULICOS EN GUATEMALA
				</p>

				<h1>
					Suministros hidráulicos
					<span>para proyectos en Guatemala.</span>
				</h1>

				<p class="hero-lead">
					Woltmann, uniones tipo Dresser, válvulas de
					compuerta, flanges, kits y accesorios para
					instalaciones hidráulicas. En los productos que
					podemos comparar claramente publicamos el precio
					de referencia antes de que nos escriba.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href="#precios-hidraulicos"
					>
						Ver precios
					</a>

					<a
						class="button button-secondary"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Comprar / consultar
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Precios de referencia publicados</span>
					<span>✓ Instalación disponible</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel price-preview-panel">
				<p class="panel-label">
					PRECIOS VISIBLES
				</p>

				<h2>
					Sepa cuánto cuesta antes de escribir.
				</h2>

				<div class="preview-price-list">
					<div>
						<p>
							<strong>Dresser HELMAN 3"</strong>
							200 PSI
						</p>
						<span>Q1,400</span>
					</div>

					<div>
						<p>
							<strong>Woltmann Genebre 3"</strong>
							6060A 11 · DN80
						</p>
						<span>Q3,050</span>
					</div>

					<div>
						<p>
							<strong>Contador de agua 3/4"</strong>
							Opciones Genebre
						</p>
						<span>Desde Q420</span>
					</div>
				</div>

				<a class="panel-link" href="#precios-hidraulicos">
					Ver tabla completa de precios →
				</a>

				<p class="panel-note">
					Precios de referencia sujetos a confirmación
					de disponibilidad.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     PRECIOS
	================================================== -->

	<section
		class="section hydraulic-prices"
		id="precios-hidraulicos"
	>
		<div class="container">
			<div class="prices-heading">
				<div>
					<p class="eyebrow">
						PRECIOS DE REFERENCIA
					</p>

					<h2>
						Compare precios
						<span>antes de solicitar la compra.</span>
					</h2>
				</div>

				<p>
					Estos precios corresponden a las referencias indicadas.
					Confirmamos disponibilidad antes de cerrar la venta.
					Instalación, transporte, kits y materiales complementarios
					se agregan únicamente cuando aplican.
				</p>
			</div>

			<div class="price-table-grid">
				<article class="price-table-card">
					<div class="price-table-head">
						<div>
							<span>CONTADORES WOLTMANN</span>
							<h3>Genebre 6060A</h3>
						</div>

						<strong>Desde Q3,050</strong>
					</div>

					<div class="price-rows">
						{
							woltmannPrices.map((item) => (
								<div class="price-row">
									<div class="price-product">
										<strong>{item.size}</strong>
										<span>{item.ref}</span>
									</div>

									<strong class="row-price">
										{item.price}
									</strong>

									<a
										href={item.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										Comprar / confirmar →
									</a>
								</div>
							))
						}
					</div>
				</article>

				<article class="price-table-card">
					<div class="price-table-head">
						<div>
							<span>UNIONES TIPO DRESSER</span>
							<h3>HELMAN · 200 PSI</h3>
						</div>

						<strong>Desde Q1,400</strong>
					</div>

					<div class="price-rows">
						{
							dresserPrices.map((item) => (
								<div class="price-row">
									<div class="price-product">
										<strong>{item.size}</strong>
										<span>{item.ref}</span>
									</div>

									<strong class="row-price">
										{item.price}
									</strong>

									<a
										href={item.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										Comprar / confirmar →
									</a>
								</div>
							))
						}
					</div>
				</article>
			</div>

			<div class="price-quick-links">
				<a href="/contador-agua-3-4-guatemala/">
					<span>CONTADOR 3/4"</span>
					<strong>Desde Q420</strong>
					<em>Ver modelos y precios →</em>
				</a>

				<a href="/contadores-de-agua-guatemala/">
					<span>CONTADORES DE AGUA</span>
					<strong>Opciones para distintas medidas</strong>
					<em>Ver precios disponibles →</em>
				</a>

				<a href="#valvulas">
					<span>VÁLVULAS DE COMPUERTA</span>
					<strong>Precio según especificación</strong>
					<em>Ver cómo cotizamos →</em>
				</a>
			</div>

			<p class="prices-disclaimer">
				*Precios comerciales de referencia. No constituyen garantía
				de inventario. La disponibilidad, entrega e instalación se
				confirman antes de aceptar el pedido.
			</p>
		</div>
	</section>

	<!-- ==================================================
	     QUÉ INCLUYE / COMPRA
	================================================== -->

	<section class="section purchase-clarity-section">
		<div class="container">
			<div class="purchase-clarity-heading">
				<div>
					<p class="eyebrow">
						ANTES DE COMPRAR
					</p>

					<h2>
						El precio publicado es del producto.
						<span>Los complementos se agregan solo si los necesita.</span>
					</h2>
				</div>

				<p>
					Así puede comparar el costo del equipo sin mezclarlo
					con instalación, transporte o accesorios que cambian
					según cada proyecto.
				</p>
			</div>

			<div class="purchase-clarity-grid">
				<article>
					<span>01</span>

					<h3>Woltmann</h3>

					<p>
						El precio mostrado corresponde al contador Genebre
						6060A de la medida indicada.
					</p>

					<ul>
						<li>Equipo de la medida seleccionada</li>
						<li>Kit y accesorios: aparte</li>
						<li>Entrega e instalación: aparte</li>
					</ul>
				</article>

				<article>
					<span>02</span>

					<h3>Unión Dresser</h3>

					<p>
						El precio mostrado corresponde a una unión tipo
						Dresser HELMAN 200 PSI de la medida indicada.
					</p>

					<ul>
						<li>Unión de la medida seleccionada</li>
						<li>Materiales complementarios: aparte</li>
						<li>Entrega e instalación: aparte</li>
					</ul>
				</article>

				<article class="featured">
					<span>03</span>

					<h3>¿Necesita el sistema completo?</h3>

					<p>
						Podemos agregar flanges, empaques, tornillería,
						otros accesorios y mano de obra según el requerimiento.
					</p>

					<a
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Completar mi requerimiento →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAMILIAS
	================================================== -->

	<section
		class="section families-section"
		id="familias"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					PRODUCTOS HIDRÁULICOS
				</p>

				<h2>
					De contadores a accesorios
					<span>para completar la instalación.</span>
				</h2>

				<p>
					La cotización se prepara según medida, cantidad,
					conexión, presión y aplicación. No asumimos que
					dos productos de la misma medida sean equivalentes.
				</p>
			</div>

			<div class="family-grid">
				<article class="family-card">
					<span class="family-number">01</span>

					<h3>
						Contadores de agua
					</h3>

					<p>
						Para 3/4", reposición, instalaciones nuevas
						y otras aplicaciones de medición de agua.
					</p>

					<div class="family-links">
						<a href="/contadores-de-agua-guatemala/">
							Ver contadores →
						</a>

						<a href="/contador-agua-3-4-guatemala/">
							Ver contador 3/4 →
						</a>
					</div>
				</article>

				<article class="family-card featured">
					<span class="family-number">02</span>

					<h3>
						Contadores Woltmann
					</h3>

					<p>
						Equipos bridados para mayores diámetros
						y caudales, con opciones de 3", 4", 6" y 8".
					</p>

					<a href="#precios-hidraulicos">
						Ver precios Woltmann →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">03</span>

					<h3>
						Uniones tipo Dresser
					</h3>

					<p>
						Acoples para tubería de extremos lisos,
						reparaciones y adaptaciones hidráulicas.
					</p>

					<a href="#dresser">
						Ver uniones Dresser →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">04</span>

					<h3>
						Válvulas de compuerta
					</h3>

					<p>
						Válvulas flangeadas cotizadas según
						medida, presión, conexión y aplicación.
					</p>

					<a href="#valvulas">
						Ver válvulas →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">05</span>

					<h3>
						Kits y accesorios
					</h3>

					<p>
						Flanges, empaques, tornillería y otros
						materiales complementarios para instalación.
					</p>

					<a href="#kits">
						Ver accesorios →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WOLTMANN
	================================================== -->

	<section
		class="section woltmann-section"
		id="woltmann"
	>
		<div class="container product-feature-grid">
			<div class="feature-media">
				<ProductMedia
					src="/images/contadores/genebre-6060a-woltmann-bridado.png"
					alt="Imagen ilustrativa de contador Woltmann Genebre 6060A bridado"
					model="Genebre 6060A"
					label="Contador Woltmann con bridas ANSI"
					variant="dark"
					aspect="wide"
				/>
			</div>

			<div class="feature-copy">
				<p class="eyebrow eyebrow-light">
					CONTADOR WOLTMANN
				</p>

				<h2>
					Genebre 6060A
					<span>para mayores diámetros.</span>
				</h2>

				<p>
					La línea Genebre 6060A está orientada a medición
					de agua fría en instalaciones que requieren mayores
					diámetros. La selección se revisa según diámetro,
					caudal, conexión y condiciones del proyecto.
				</p>

				<div class="size-list">
					{
						woltmannPrices.map((item) => (
							<div>
								<strong>{item.size}</strong>
								<span>{item.ref}</span>
								<b>{item.price}</b>
							</div>
						))
					}
				</div>

				<ul class="feature-specs">
					<li>Agua fría</li>
					<li>Presión máxima 16 bar</li>
					<li>Bridas ANSI / ASME Class 150</li>
					<li>Montaje horizontal, vertical o inclinado</li>
				</ul>

				<a
					class="button"
					href="#precios-hidraulicos"
				>
					Ver precios Woltmann
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     DRESSER
	================================================== -->

	<section
		class="section dresser-section"
		id="dresser"
	>
		<div class="container dresser-grid">
			<div class="dresser-copy">
				<p class="eyebrow">
					UNIÓN DRESSER
				</p>

				<h2>
					Uniones tipo Dresser HELMAN
					<span>200 PSI.</span>
				</h2>

				<p>
					Uniones tipo Dresser HELMAN para tubería de
					extremos lisos, reparaciones y adaptaciones.
					Publicamos el precio por medida para que pueda
					comparar antes de comprar.
				</p>

				<div class="dresser-price-list">
					{
						dresserPrices.map((item) => (
							<div>
								<strong>{item.size}</strong>
								<span>{item.price}</span>
							</div>
						))
					}
				</div>

				<div class="dresser-details">
					<div>
						<strong>200 PSI</strong>
						<span>Presión indicada para la línea cotizada.</span>
