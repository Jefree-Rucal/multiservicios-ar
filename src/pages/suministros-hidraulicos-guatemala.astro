---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Suministros Hidráulicos en Guatemala | Woltmann, Dresser y Válvulas | AR";

const description =
	"Suministros hidráulicos en Guatemala para proyectos: contadores Woltmann, uniones Dresser, válvulas de compuerta, flanges, kits y accesorios. Cotice suministro e instalación.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de suministros hidráulicos y quisiera solicitar una cotización.

Producto o material:
Medida:
Cantidad:
Aplicación:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappWoltmann = createWhatsAppLink(
	`Hola, necesito cotizar un contador Woltmann Genebre 6060A.

Medida:
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappDresser = createWhatsAppLink(
	`Hola, necesito cotizar una unión tipo Dresser HELMAN 200 PSI.

Medida:
Cantidad:
Aplicación / tubería:
Ubicación del proyecto:
¿Necesito instalación?: Sí / No`
);

const whatsappValve = createWhatsAppLink(
	`Hola, necesito cotizar una válvula de compuerta flangeada.

Medida:
Cantidad:
Presión / especificación si la tengo:
Aplicación:
Ubicación del proyecto:
¿Necesito instalación?: Sí / No`
);

const whatsappKit = createWhatsAppLink(
	`Hola, necesito cotizar un kit de instalación hidráulica.

Tipo de equipo:
Medida:
Cantidad:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué suministros hidráulicos pueden cotizar en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede cotizar contadores de agua y Woltmann, uniones tipo Dresser, válvulas de compuerta flangeadas, flanges, empaques, tornillería, kits y otros accesorios según el requerimiento del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Venden uniones tipo Dresser?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar uniones tipo Dresser HELMAN 200 PSI en medidas como 3, 4, 6 y 8 pulgadas, sujetas a confirmación de especificación, precio y disponibilidad.",
			},
		},
		{
			"@type": "Question",
			name: "¿Cotizan válvulas de compuerta flangeadas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Las válvulas se cotizan según medida, tipo de conexión, presión y requerimiento de la instalación. La referencia exacta se confirma antes de preparar la propuesta.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan contadores Woltmann de 3, 4, 6 y 8 pulgadas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede cotizar la línea Genebre 6060A en medidas como 3, 4, 6 y 8 pulgadas. Otras medidas y configuraciones se revisan según el requerimiento y disponibilidad.",
			},
		},
		{
			"@type": "Question",
			name: "¿También realizan instalación de productos hidráulicos?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar únicamente el suministro o evaluar equipo, materiales complementarios y mano de obra para una solución más completa.",
			},
		},
		{
			"@type": "Question",
			name: "¿Mantienen todos los productos en inventario?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"No necesariamente. Precio y disponibilidad se confirman con la cadena de suministro al momento de cada cotización.",
			},
		},
	],
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Suministros hidráulicos en Guatemala",
			item: "/suministros-hidraulicos-guatemala/",
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/hidraulicos/union-dresser-helman-200psi.png"
	imageAlt="Suministros hidráulicos en Guatemala: unión Dresser, Woltmann y válvulas"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="hydraulic-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					SUMINISTROS HIDRÁULICOS EN GUATEMALA
				</p>

				<h1>
					Suministros hidráulicos
					<span>para proyectos en Guatemala.</span>
				</h1>

				<p class="hero-lead">
					Cotizamos contadores Woltmann, uniones tipo Dresser,
					válvulas de compuerta flangeadas, flanges, kits y
					accesorios para instalaciones hidráulicas. Puede
					solicitar solo suministro o consultar suministro
					más instalación.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar suministros
					</a>

					<a
						class="button button-secondary"
						href="#familias"
					>
						Ver productos
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Cotización por requerimiento</span>
					<span>✓ Instalación disponible</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="panel-label">
					PARA COTIZAR MÁS RÁPIDO
				</p>

				<h2>
					Envíenos cuatro datos.
				</h2>

				<div class="panel-list">
					<div>
						<span>01</span>

						<p>
							<strong>Producto</strong>
							Woltmann, Dresser, válvula, kit o accesorio.
						</p>
					</div>

					<div>
						<span>02</span>

						<p>
							<strong>Medida</strong>
							Por ejemplo 3", 4", 6" u 8".
						</p>
					</div>

					<div>
						<span>03</span>

						<p>
							<strong>Cantidad</strong>
							Indique cuántas unidades necesita.
						</p>
					</div>

					<div>
						<span>04</span>

						<p>
							<strong>Aplicación</strong>
							Proyecto, reposición o instalación nueva.
						</p>
					</div>
				</div>

				<p class="panel-note">
					Precio, referencia y disponibilidad sujetos a confirmación.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     FAMILIAS
	================================================== -->

	<section
		class="section families-section"
		id="familias"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					PRODUCTOS HIDRÁULICOS
				</p>

				<h2>
					De contadores a accesorios
					<span>para completar la instalación.</span>
				</h2>

				<p>
					La cotización se prepara según medida, cantidad,
					conexión, presión y aplicación. No asumimos que
					dos productos de la misma medida sean equivalentes.
				</p>
			</div>

			<div class="family-grid">
				<article class="family-card">
					<span class="family-number">01</span>

					<h3>
						Contadores de agua
					</h3>

					<p>
						Para 3/4", reposición, instalaciones nuevas
						y otras aplicaciones de medición de agua.
					</p>

					<div class="family-links">
						<a href="/contadores-de-agua-guatemala/">
							Ver contadores →
						</a>

						<a href="/contador-agua-3-4-guatemala/">
							Ver contador 3/4 →
						</a>
					</div>
				</article>

				<article class="family-card featured">
					<span class="family-number">02</span>

					<h3>
						Contadores Woltmann
					</h3>

					<p>
						Equipos bridados para mayores diámetros
						y caudales, con opciones de 3", 4", 6" y 8".
					</p>

					<a
						href={whatsappWoltmann}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar Woltmann →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">03</span>

					<h3>
						Uniones tipo Dresser
					</h3>

					<p>
						Acoples para tubería de extremos lisos,
						reparaciones y adaptaciones hidráulicas.
					</p>

					<a href="#dresser">
						Ver uniones Dresser →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">04</span>

					<h3>
						Válvulas de compuerta
					</h3>

					<p>
						Válvulas flangeadas cotizadas según
						medida, presión, conexión y aplicación.
					</p>

					<a href="#valvulas">
						Ver válvulas →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">05</span>

					<h3>
						Kits y accesorios
					</h3>

					<p>
						Flanges, empaques, tornillería y otros
						materiales complementarios para instalación.
					</p>

					<a href="#kits">
						Ver accesorios →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WOLTMANN
	================================================== -->

	<section
		class="section woltmann-section"
		id="woltmann"
	>
		<div class="container product-feature-grid">
			<div class="feature-media">
				<ProductMedia
					src="/images/contadores/genebre-6060a-woltmann-bridado.png"
					alt="Imagen ilustrativa de contador Woltmann Genebre 6060A bridado"
					model="Genebre 6060A"
					label="Contador Woltmann con bridas ANSI"
					variant="dark"
					aspect="wide"
				/>
			</div>

			<div class="feature-copy">
				<p class="eyebrow eyebrow-light">
					CONTADOR WOLTMANN
				</p>

				<h2>
					Genebre 6060A
					<span>para mayores diámetros.</span>
				</h2>

				<p>
					La línea Genebre 6060A está orientada a medición
					de agua fría en instalaciones que requieren mayores
					diámetros. La selección se revisa según diámetro,
					caudal, conexión y condiciones del proyecto.
				</p>

				<div class="size-list">
					<div>
						<strong>3"</strong>
						<span>6060A 11 · DN80</span>
					</div>

					<div>
						<strong>4"</strong>
						<span>6060A 12 · DN100</span>
					</div>

					<div>
						<strong>6"</strong>
						<span>6060A 14 · DN150</span>
					</div>

					<div>
						<strong>8"</strong>
						<span>6060A 16 · DN200</span>
					</div>
				</div>

				<ul class="feature-specs">
					<li>Agua fría</li>
					<li>Presión máxima 16 bar</li>
					<li>Bridas ANSI / ASME Class 150</li>
					<li>Montaje horizontal, vertical o inclinado</li>
				</ul>

				<a
					class="button"
					href={whatsappWoltmann}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar Woltmann
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     DRESSER
	================================================== -->

	<section
		class="section dresser-section"
		id="dresser"
	>
		<div class="container dresser-grid">
			<div class="dresser-copy">
				<p class="eyebrow">
					UNIÓN DRESSER
				</p>

				<h2>
					Uniones tipo Dresser HELMAN
					<span>200 PSI.</span>
				</h2>

				<p>
					Podemos cotizar uniones tipo Dresser HELMAN
					para unión de tubería de extremos lisos y
					trabajos de reparación o adaptación.
				</p>

				<div class="dresser-sizes">
					<span>3"</span>
					<span>4"</span>
					<span>6"</span>
					<span>8"</span>
				</div>

				<div class="dresser-details">
					<div>
						<strong>200 PSI</strong>
						<span>Presión indicada para la línea cotizada.</span>
					</div>

					<div>
						<strong>Hierro fundido</strong>
						<span>Cuerpo con recubrimiento epóxico.</span>
					</div>
				</div>

				<p class="product-note">
					La referencia exacta, precio y disponibilidad se
					confirman antes de preparar la cotización.
				</p>

				<a
					class="button"
					href={whatsappDresser}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar unión Dresser
				</a>
			</div>

			<div class="dresser-visual">
				<ProductMedia
					src="/images/hidraulicos/union-dresser-helman-200psi.png"
					alt='Imagen ilustrativa de unión tipo Dresser HELMAN 200 PSI en Guatemala'
					model="Unión tipo Dresser HELMAN"
					label='Medidas 3", 4", 6" y 8"'
					aspect="wide"
				/>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     VÁLVULAS
	================================================== -->

	<section
		class="section valves-section"
		id="valvulas"
	>
		<div class="container">
			<div class="section-heading valve-heading">
				<p class="eyebrow eyebrow-light">
					VÁLVULAS DE COMPUERTA FLANGEADAS
				</p>

				<h2>
					Cotizamos válvulas según
					<span>medida y especificación.</span>
				</h2>

				<p>
					Antes de cotizar una válvula de compuerta revisamos
					medida, presión, conexión y aplicación. Así evitamos
					tratar como equivalentes equipos que pueden tener
					especificaciones distintas.
				</p>
			</div>

			<div class="valve-grid">
				<article>
					<span>01</span>

					<h3>
						Medida
					</h3>

					<p>
						3", 4", 6", 8" u otra medida según
						el requerimiento.
					</p>
				</article>

				<article>
					<span>02</span>

					<h3>
						Conexión
					</h3>

					<p>
						Confirmamos el tipo de conexión y
						patrón de brida requerido.
					</p>
				</article>

				<article>
					<span>03</span>

					<h3>
						Presión
					</h3>

					<p>
						La presión de trabajo debe corresponder
						con las condiciones de la instalación.
					</p>
				</article>

				<article>
					<span>04</span>

					<h3>
						Aplicación
					</h3>

					<p>
						Revisamos el uso antes de confirmar
						modelo, precio y disponibilidad.
					</p>
				</article>
			</div>

			<div class="valve-cta">
				<p>
					Si tiene una fotografía, ficha técnica o
					especificación, puede enviárnosla para revisar
					mejor el requerimiento.
				</p>

				<a
					class="button"
					href={whatsappValve}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar válvula
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     KITS
	================================================== -->

	<section
		class="section kits-section"
		id="kits"
	>
		<div class="container kits-grid">
			<div>
				<p class="eyebrow">
					KITS Y ACCESORIOS HIDRÁULICOS
				</p>

				<h2>
					No siempre basta
					<span>con comprar el equipo.</span>
				</h2>

				<p class="kits-lead">
					Dependiendo de la instalación podemos incluir
					materiales complementarios para que el requerimiento
					llegue más completo a obra.
				</p>
			</div>

			<div class="kit-cards">
				<article>
					<span>01</span>

					<div>
						<h3>
							Flanges
						</h3>

						<p>
							Opciones según medida y tipo de instalación.
						</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>
							Empaques
						</h3>

						<p>
							Seleccionados según equipo y requerimiento.
						</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>
							Tornillería
						</h3>

						<p>
							Cantidad y dimensiones según la conexión.
						</p>
					</div>
				</article>

				<article class="kit-featured">
					<span>04</span>

					<div>
						<h3>
							Kit + instalación
						</h3>

						<p>
							Podemos evaluar accesorios y mano de obra.
						</p>
					</div>
				</article>
			</div>

			<a
				class="button kit-button"
				href={whatsappKit}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar accesorios
			</a>
		</div>
	</section>

	<!-- ==================================================
	     CONTADORES
	================================================== -->

	<section class="section meters-link-section">
		<div class="container meters-link-grid">
			<div>
				<p class="eyebrow">
					¿BUSCA UN CONTADOR DE AGUA?
				</p>

				<h2>
					Tenemos páginas específicas
					<span>para esa búsqueda.</span>
				</h2>

				<p>
					Para evitar mezclar requerimientos industriales
					con contadores pequeños, organizamos la información
					en páginas especializadas.
				</p>
			</div>

			<div class="meters-links">
				<a href="/contadores-de-agua-guatemala/">
					<strong>Contadores de agua en Guatemala</strong>
					<span>Opciones generales, 3/4 y Woltmann →</span>
				</a>

				<a href="/contador-agua-3-4-guatemala/">
					<strong>Contador de agua 3/4</strong>
					<span>Modelos y precios desde Q420 →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PROCESO
	================================================== -->

	<section class="section process-section">
		<div class="container">
			<div class="section-heading process-heading">
				<p class="eyebrow">
					CÓMO TRABAJAMOS
				</p>

				<h2>
					Confirmamos antes de comprar.
				</h2>

				<p>
					No publicamos inventario que no mantenemos.
					Verificamos especificaciones, precio y
					disponibilidad antes de presentar la propuesta.
				</p>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Requerimiento</h3>
					<p>Producto, medida, cantidad y aplicación.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Verificación</h3>
					<p>Confirmamos especificación y disponibilidad.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Preparamos la propuesta según el alcance.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Entrega / instalación</h3>
					<p>Coordinamos suministro y trabajo cuando aplica.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar suministros hidráulicos.
				</h2>

				<p>
					Si cuenta con planos, fotografías o fichas técnicas,
					puede enviarlos para revisar mejor el requerimiento.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué suministros hidráulicos pueden cotizar en Guatemala?
					</summary>

					<p>
						Podemos cotizar contadores Woltmann, uniones
						tipo Dresser, válvulas de compuerta, flanges,
						empaques, tornillería, kits y otros accesorios
						según el proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿Venden uniones tipo Dresser?
					</summary>

					<p>
						Podemos cotizar uniones tipo Dresser HELMAN
						200 PSI en medidas como 3", 4", 6" y 8".
						La referencia, precio y disponibilidad se
						confirman al momento de cotizar.
					</p>
				</details>

				<details>
					<summary>
						¿Cotizan válvulas de compuerta flangeadas?
					</summary>

					<p>
						Sí. Para preparar la propuesta revisamos
						medida, conexión, presión y aplicación antes
						de confirmar el modelo disponible.
					</p>
				</details>

				<details>
					<summary>
						¿Trabajan contadores Woltmann de 3", 4", 6" y 8"?
					</summary>

					<p>
						Podemos cotizar la línea Genebre 6060A en esas
						medidas. Otras medidas se revisan según
						requerimiento y disponibilidad.
					</p>
				</details>

				<details>
					<summary>
						¿Mantienen todos los productos en inventario?
					</summary>

					<p>
						No necesariamente. Trabajamos bajo cotización
