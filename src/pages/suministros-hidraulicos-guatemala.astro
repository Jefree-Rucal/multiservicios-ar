---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Suministros Hidráulicos en Guatemala | Contadores, Válvulas y Dresser | AR";

const description =
	"Suministros hidráulicos en Guatemala para proyectos e instalaciones: contadores de agua, Woltmann, uniones Dresser, válvulas de compuerta, kits y accesorios. Suministro e instalación.";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de suministros hidráulicos y quisiera solicitar una cotización.

Producto o material:
Medida:
Cantidad:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappWoltmann = createWhatsAppLink(
	`Hola, necesito cotizar un contador Woltmann Genebre 6060A.

Medida:
Cantidad:
¿Necesito kit de instalación?: Sí / No
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const whatsappDresser = createWhatsAppLink(
	`Hola, necesito cotizar una unión tipo Dresser HELMAN 200 PSI.

Medida:
Cantidad:
Aplicación / tubería:
Ubicación del proyecto:`
);

const whatsappValve = createWhatsAppLink(
	`Hola, necesito cotizar una válvula de compuerta flangeada.

Medida:
Cantidad:
Presión / especificación si la tengo:
Aplicación:
Ubicación del proyecto:`
);

const whatsappKit = createWhatsAppLink(
	`Hola, necesito cotizar un kit de instalación hidráulica.

Tipo de equipo:
Medida:
Cantidad:
¿Necesito instalación?: Sí / No
Ubicación del proyecto:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué suministros hidráulicos manejan?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede cotizar contadores de agua, medidores Woltmann, uniones tipo Dresser, válvulas de compuerta, kits de instalación, flanges, empaques, tornillería y otros accesorios según requerimiento.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan medidas de 3, 4, 6 y 8 pulgadas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Estas medidas son comunes dentro de las líneas de Woltmann, Dresser, válvulas y kits que AR puede cotizar. La disponibilidad y especificación se confirman antes de preparar la propuesta.",
			},
		},
		{
			"@type": "Question",
			name: "¿También realizan instalación?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar únicamente el suministro o evaluar equipo, materiales complementarios y mano de obra para una solución completa.",
			},
		},
		{
			"@type": "Question",
			name: "¿Mantienen todos los productos en inventario?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"No necesariamente. Precio y disponibilidad se confirman con la cadena de suministro al momento de cada cotización.",
			},
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="hydraulic-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					SUMINISTROS HIDRÁULICOS EN GUATEMALA
				</p>

				<h1>
					Equipo y accesorios para
					<span>instalaciones hidráulicas.</span>
				</h1>

				<p class="hero-lead">
					Contadores de agua, medidores Woltmann,
					uniones tipo Dresser, válvulas de compuerta,
					kits y accesorios para proyectos e instalaciones
					en Guatemala.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#familias"
					>
						Ver productos
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Suministro</span>
					<span>✓ Instalación disponible</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="panel-label">
					PARA COTIZAR MÁS RÁPIDO
				</p>

				<h2>
					Envíenos estos datos.
				</h2>

				<div class="panel-list">
					<div>
						<span>01</span>

						<p>
							<strong>Producto</strong>
							Contador, Dresser, válvula, kit o accesorio.
						</p>
					</div>

					<div>
						<span>02</span>

						<p>
							<strong>Medida</strong>
							Por ejemplo 3", 4", 6" u 8".
						</p>
					</div>

					<div>
						<span>03</span>

						<p>
							<strong>Cantidad</strong>
							Unidades requeridas.
						</p>
					</div>

					<div>
						<span>04</span>

						<p>
							<strong>Instalación</strong>
							Indique si también necesita mano de obra.
						</p>
					</div>
				</div>

				<p class="panel-note">
					Precio y disponibilidad sujetos a confirmación.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     FAMILIAS
	================================================== -->

	<section
		class="section families-section"
		id="familias"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					FAMILIAS DE PRODUCTO
				</p>

				<h2>
					Desde una unidad
					<span>hasta un requerimiento de proyecto.</span>
				</h2>

				<p>
					Trabajamos la cotización según medida,
					cantidad, conexión, presión y aplicación.
					Cuando aplica, también podemos incluir
					materiales complementarios e instalación.
				</p>
			</div>

			<div class="family-grid">
				<article class="family-card">
					<span class="family-number">01</span>

					<h3>
						Contadores de agua
					</h3>

					<p>
						Opciones de 3/4" para instalaciones
						y reposición, además de otras medidas
						según requerimiento.
					</p>

					<div class="family-links">
						<a href="/contadores-de-agua-guatemala/">
							Ver contadores →
						</a>

						<a href="/contador-agua-3-4-guatemala/">
							Ver 3/4" →
						</a>
					</div>
				</article>

				<article class="family-card featured">
					<span class="family-number">02</span>

					<h3>
						Woltmann bridados
					</h3>

					<p>
						Medidores para mayores diámetros y
						caudales, con opciones como 3", 4",
						6" y 8".
					</p>

					<a
						href={whatsappWoltmann}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar Woltmann →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">03</span>

					<h3>
						Uniones tipo Dresser
					</h3>

					<p>
						Para unión y reparación de tuberías
						de extremos lisos en instalaciones
						hidráulicas.
					</p>

					<a
						href={whatsappDresser}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar Dresser →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">04</span>

					<h3>
						Válvulas de compuerta
					</h3>

					<p>
						Válvulas flangeadas para proyecto,
						cotizadas según medida, presión y
						especificación requerida.
					</p>

					<a
						href={whatsappValve}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar válvula →
					</a>
				</article>

				<article class="family-card">
					<span class="family-number">05</span>

					<h3>
						Kits y accesorios
					</h3>

					<p>
						Flanges, empaques, tornillería y
						otros materiales complementarios
						para la instalación.
					</p>

					<a
						href={whatsappKit}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar kit →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     WOLTMANN
	================================================== -->

	<section class="section woltmann-section">
		<div class="container product-feature-grid">
			<div class="feature-media">
				<ProductMedia
					src="/images/contadores/genebre-6060a-woltmann-bridado.png"
					alt="Imagen ilustrativa de contador Woltmann bridado Genebre 6060A"
					model="Genebre 6060A"
					label="Contador Woltmann con bridas ANSI"
					variant="dark"
					aspect="wide"
				/>
			</div>

			<div class="feature-copy">
				<p class="eyebrow eyebrow-light">
					CONTADORES WOLTMANN
				</p>

				<h2>
					Genebre 6060A
					<span>para mayores diámetros.</span>
				</h2>

				<p>
					La línea 6060A permite trabajar medidas
					de mayor diámetro con conexión bridada ANSI.
					La selección se realiza según medida,
					caudal y condiciones del proyecto.
				</p>

				<div class="size-list">
					<div>
						<strong>3"</strong>
						<span>6060A 11</span>
					</div>

					<div>
						<strong>4"</strong>
						<span>6060A 12</span>
					</div>

					<div>
						<strong>6"</strong>
						<span>6060A 14</span>
					</div>

					<div>
						<strong>8"</strong>
						<span>6060A 16</span>
					</div>
				</div>

				<ul class="feature-specs">
					<li>Agua fría</li>
					<li>Hasta 16 bar</li>
					<li>Bridas ANSI</li>
					<li>Instalación horizontal, vertical o inclinada</li>
				</ul>

				<a
					class="button"
					href={whatsappWoltmann}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar Woltmann
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     DRESSER
	================================================== -->

	<section class="section dresser-section">
		<div class="container dresser-grid">
			<div class="dresser-copy">
				<p class="eyebrow">
					UNIONES TIPO DRESSER
				</p>

				<h2>
					HELMAN 200 PSI
					<span>para instalaciones hidráulicas.</span>
				</h2>

				<p>
					Podemos cotizar uniones tipo Dresser HELMAN
					para unión de extremos lisos y trabajos de
					reparación o adaptación de tubería.
				</p>

				<div class="dresser-sizes">
					<span>3"</span>
					<span>4"</span>
					<span>6"</span>
					<span>8"</span>
				</div>

				<div class="dresser-details">
					<div>
						<strong>200 PSI</strong>
						<span>Presión de trabajo de la línea cotizada</span>
					</div>

					<div>
						<strong>Hierro fundido</strong>
						<span>Cuerpo con recubrimiento epóxico</span>
					</div>
				</div>

				<a
					class="button"
					href={whatsappDresser}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar Dresser
				</a>
			</div>

			<div class="dresser-visual">
				<ProductMedia
					src="/images/hidraulicos/union-dresser-helman-200psi.png"
					alt='Imagen ilustrativa de unión tipo Dresser HELMAN 200 PSI para instalaciones hidráulicas'
					model="Unión tipo Dresser HELMAN"
					label='Medidas 3", 4", 6" y 8"'
					aspect="wide"
				/>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     VÁLVULAS
	================================================== -->

	<section class="section valves-section">
		<div class="container">
			<div class="section-heading valve-heading">
				<p class="eyebrow eyebrow-light">
					VÁLVULAS DE COMPUERTA
				</p>

				<h2>
					Cotizamos según
					<span>medida y especificación.</span>
				</h2>

				<p>
					No todas las válvulas de la misma medida
					son equivalentes. Antes de cotizar revisamos
					conexión, presión, material y requerimiento
					del proyecto.
				</p>
			</div>

			<div class="valve-grid">
				<article>
					<span>01</span>

					<h3>
						Medida
					</h3>

					<p>
						3", 4", 6", 8" u otra medida según
						el requerimiento.
					</p>
				</article>

				<article>
					<span>02</span>

					<h3>
						Conexión
					</h3>

					<p>
						Confirmamos el tipo de conexión
						y patrón de brida requerido.
					</p>
				</article>

				<article>
					<span>03</span>

					<h3>
						Presión
					</h3>

					<p>
						La presión de trabajo debe corresponder
						a la instalación.
					</p>
				</article>

				<article>
					<span>04</span>

					<h3>
						Aplicación
					</h3>

					<p>
						Revisamos el uso antes de confirmar
						modelo y disponibilidad.
					</p>
				</article>
			</div>

			<div class="valve-cta">
				<p>
					Si tiene una fotografía, ficha técnica o
					especificación, puede enviárnosla por WhatsApp.
				</p>

				<a
					class="button"
					href={whatsappValve}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar válvula
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     KITS
	================================================== -->

	<section class="section kits-section">
		<div class="container kits-grid">
			<div>
				<p class="eyebrow">
					KITS Y ACCESORIOS
				</p>

				<h2>
					No siempre basta
					<span>con comprar el equipo.</span>
				</h2>

				<p class="kits-lead">
					Dependiendo de la instalación podemos cotizar
					materiales complementarios para dejar el
					requerimiento más completo.
				</p>
			</div>

			<div class="kit-cards">
				<article>
					<span>01</span>

					<div>
						<h3>
							Flanges
						</h3>

						<p>
							Opciones según medida y tipo
							de instalación.
						</p>
					</div>
				</article>

				<article>
					<span>02</span>

					<div>
						<h3>
							Empaques
						</h3>

						<p>
							Seleccionados según el equipo
							y requerimiento.
						</p>
					</div>
				</article>

				<article>
					<span>03</span>

					<div>
						<h3>
							Tornillería
						</h3>

						<p>
							Cantidad y dimensiones de acuerdo
							con la conexión.
						</p>
					</div>
				</article>

				<article class="kit-featured">
					<span>04</span>

					<div>
						<h3>
							Kit + instalación
						</h3>

						<p>
							Podemos evaluar materiales
							complementarios y mano de obra.
						</p>
					</div>
				</article>
			</div>

			<a
				class="button kit-button"
				href={whatsappKit}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar accesorios
			</a>
		</div>
	</section>

	<!-- ==================================================
	     MODELO DE TRABAJO
	================================================== -->

	<section class="section process-section">
		<div class="container">
			<div class="section-heading process-heading">
				<p class="eyebrow">
					CÓMO TRABAJAMOS
				</p>

				<h2>
					Confirmamos antes de comprar.
				</h2>

				<p>
					No publicamos inventario que no tenemos.
					Verificamos especificaciones, precio y
					disponibilidad antes de presentar la propuesta.
				</p>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Requerimiento</h3>
					<p>Producto, medida, cantidad y aplicación.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Verificación</h3>
					<p>Confirmamos especificación y disponibilidad.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Preparamos la propuesta según el alcance.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Entrega / instalación</h3>
					<p>Coordinamos suministro y trabajo cuando aplica.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar suministros hidráulicos.
				</h2>

				<p>
					Si cuenta con planos, fotografías o
					fichas técnicas, puede enviarlos para
					revisar mejor el requerimiento.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué suministros hidráulicos manejan?
					</summary>

					<p>
						Podemos cotizar contadores de agua,
						Woltmann, uniones tipo Dresser, válvulas
						de compuerta, kits, flanges, empaques,
						tornillería y otros accesorios según proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿Trabajan medidas de 3", 4", 6" y 8"?
					</summary>

					<p>
						Sí. Estas medidas aparecen con frecuencia
						en las líneas que cotizamos. La disponibilidad
						y referencia exacta se confirman antes de
						preparar la propuesta.
					</p>
				</details>

				<details>
					<summary>
						¿Mantienen todos los productos en inventario?
					</summary>

					<p>
						No necesariamente. Trabajamos bajo cotización
						y confirmamos precio y disponibilidad con
						la cadena de suministro antes de comprar.
					</p>
				</details>

				<details>
					<summary>
						¿También realizan instalación?
					</summary>

					<p>
						Sí. Podemos cotizar únicamente el suministro
						o evaluar equipo, materiales complementarios
						y mano de obra.
					</p>
				</details>

				<details>
					<summary>
						¿Puedo enviar una foto o ficha técnica?
					</summary>

					<p>
						Sí. Es especialmente útil para válvulas,
						reposiciones y productos donde la medida
						por sí sola no define toda la especificación.
					</p>
				</details>

				<details>
					<summary>
						¿Emiten factura FEL?
					</summary>

					<p>
						Sí. Las ventas pueden documentarse
						mediante factura electrónica FEL.
					</p>
				</details>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CTA FINAL
	================================================== -->

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN
			</p>

			<h2>
				¿Necesita un producto hidráulico?
			</h2>

			<p>
				Envíenos producto, medida y cantidad.
				Si tiene fotografías o especificaciones,
				también puede adjuntarlas por WhatsApp.
			</p>

			<a
				class="button"
				href={whatsappGeneral}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cotizar por WhatsApp
			</a>
		</div>
	</section>

	<section class="legal-note">
		<div class="container">
			<p>
				Las marcas y referencias mencionadas pertenecen
				a sus respectivos titulares. Imágenes ilustrativas.
				Precios, especificaciones y disponibilidad sujetos
				a confirmación al momento de cotizar.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	/* ==================================================
	   HERO
	================================================== */

	.hydraulic-hero {
		padding: 88px 0;

		background:
			linear-gradient(
				115deg,
				#ffffff 0%,
				#ffffff 60%,
				#f1f1f1 100%
			);
	}

	.hero-grid {
		display: grid;

		grid-template-columns:
			minmax(0, 1.08fr)
			minmax(370px, 0.92fr);

		align-items: center;

		gap: 64px;
	}

	.hero-copy {
		min-width: 0;
	}

	.hero-copy h1 {
		max-width: 780px;

		margin-bottom: 26px;

		font-size:
			clamp(
				3.1rem,
				5vw,
				5.1rem
			);

		line-height: 0.97;

		letter-spacing: -0.055em;
	}

	.hero-copy h1 span {
		display: block;

		color: #ed1c24;
	}

	.hero-lead {
		max-width: 690px;

		color: #606060;

		font-size: 1.08rem;

		line-height: 1.75;
	}

	.hero-actions {
		display: flex;

		flex-wrap: wrap;

		gap: 12px;

		margin-top: 32px;
	}

	.hero-trust {
		display: flex;

		flex-wrap: wrap;

		gap: 12px 22px;

