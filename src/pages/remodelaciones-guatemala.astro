---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Remodelaciones en Guatemala | Oficinas y Locales | AR";

const description =
	"Remodelaciones en Guatemala para oficinas, comercios y proyectos: adecuaciones interiores, pisos, cielos, pintura, ampliaciones y trabajos integrales.";

const pageUrl =
	"https://obracivilar.com/remodelaciones-guatemala/";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de remodelaciones en Guatemala y quisiera solicitar una cotización.

Tipo de espacio:
Ubicación del proyecto:
Área o medidas aproximadas:
¿Qué desea remodelar o cambiar?:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappOffice = createWhatsAppLink(
	`Hola, necesito cotizar la remodelación de una oficina o espacio comercial.

Tipo de espacio:
Ubicación:
Área aproximada:
Trabajos que necesito:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappFloor = createWhatsAppLink(
	`Hola, necesito cotizar la renovación de un piso o acabado interior.

Ubicación:
Área aproximada:
Condición actual:
Acabado que deseo si ya lo sé:
¿Puedo enviar fotografías?: Sí`
);

const whatsappExpansion = createWhatsAppLink(
	`Hola, necesito cotizar una ampliación o adecuación.

Ubicación:
Área aproximada:
¿Qué se necesita ampliar o modificar?:
¿Existe estructura o construcción actual?: Sí / No
¿Puedo enviar fotografías o planos?: Sí`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué tipo de remodelaciones realizan en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede evaluar remodelaciones y adecuaciones de oficinas, comercios, interiores y áreas de proyecto, incluyendo pisos, cielos, tablayeso, pintura, plomería, estructuras y otros trabajos según el alcance.",
			},
		},
		{
			"@type": "Question",
			name: "¿Remodelan oficinas y locales comerciales?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Se pueden evaluar adecuaciones interiores, divisiones, cielos, pisos, pintura, instalaciones y otros trabajos requeridos para renovar o adaptar el espacio.",
			},
		},
		{
			"@type": "Question",
			name: "¿Cuánto cuesta una remodelación?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"El costo depende del área, condición existente, materiales, acabados, instalaciones y alcance. Por eso la propuesta se prepara después de revisar fotografías, medidas, planos y requerimientos.",
			},
		},
		{
			"@type": "Question",
			name: "¿La cotización puede incluir materiales y mano de obra?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Dependiendo del alcance, la cotización puede integrar materiales, mano de obra, trabajos complementarios y coordinación entre especialidades.",
			},
		},
		{
			"@type": "Question",
			name: "¿Pueden trabajar una remodelación por etapas?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí, cuando el proyecto lo permite. El alcance puede dividirse por áreas o etapas para coordinar mejor trabajos, accesos y continuidad de operación.",
			},
		},
		{
			"@type": "Question",
			name: "¿Necesitan visitar el lugar antes de cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Depende del proyecto. Fotografías, medidas y planos permiten una revisión inicial; remodelaciones con instalaciones ocultas, demoliciones o cambios estructurales pueden requerir visita técnica.",
			},
		},
	],
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "Remodelaciones en Guatemala",
	description,
	url: pageUrl,
	image:
		"https://obracivilar.com/images/servicios/remodelaciones/oficina-remodelacion-piso-cielo-proceso.jpeg",
	serviceType: [
		"Remodelaciones",
		"Remodelación de oficinas",
		"Remodelación de locales",
		"Adecuaciones interiores",
		"Pisos y acabados",
		"Ampliaciones",
	],
	areaServed: {
		"@type": "Country",
		name: "Guatemala",
	},
	provider: {
		"@type": "Organization",
		name: "Multiservicios Obra Civil AR",
		url: "https://obracivilar.com/",
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "https://obracivilar.com/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Servicios de obra civil en Guatemala",
			item: "https://obracivilar.com/servicios-obra-civil-guatemala/",
		},
		{
			"@type": "ListItem",
			position: 3,
			name: "Remodelaciones en Guatemala",
			item: pageUrl,
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/servicios/remodelaciones/oficina-remodelacion-piso-cielo-proceso.jpeg"
	imageAlt="Remodelación interior de oficina con piso, cielo falso y acabados ejecutada por Multiservicios Obra Civil AR en Guatemala"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(serviceSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<section class="remodel-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					REMODELACIONES EN GUATEMALA
				</p>

				<h1>
					Remodelaciones
					<span>para oficinas, comercios y proyectos.</span>
				</h1>

				<p class="hero-lead">
					Adecuaciones interiores, pisos, cielos, pintura,
					divisiones, instalaciones y ampliaciones coordinadas
					según las condiciones y el objetivo del espacio.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#trabajos-reales"
					>
						Ver trabajos reales
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Evaluación por proyecto</span>
					<span>✓ Materiales + mano de obra</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<div class="hero-media">
				<img
					src="/images/servicios/remodelaciones/oficina-remodelacion-piso-cielo-proceso.jpeg"
					alt="Oficina en etapa final de remodelación con piso tipo madera, cielo falso y pintura"
					loading="eager"
					decoding="async"
				/>

				<div class="hero-media-caption">
					<span>PROYECTO REAL</span>
					<strong>Adecuación interior de oficina</strong>
					<p>piso · cielo · pintura · divisiones</p>
				</div>
			</div>
		</div>
	</section>

	<section class="proof-strip">
		<div class="container proof-grid">
			<div>
				<strong>≈78 m²</strong>
				<span>en renovación interior documentada</span>
			</div>

			<div>
				<strong>Interior + exterior</strong>
				<span>adecuaciones según cada espacio</span>
			</div>

			<div>
				<strong>Proyecto integral</strong>
				<span>varios oficios dentro de un mismo alcance</span>
			</div>
		</div>
	</section>

	<section class="section services-section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					¿QUÉ PUEDE INCLUIR?
				</p>

				<h2>
					Una remodelación no es
					<span>solo cambiar acabados.</span>
				</h2>

				<p>
					Primero revisamos qué existe, qué debe conservarse,
					qué necesita modificarse y qué especialidades deben
					coordinarse para llegar al resultado esperado.
				</p>
			</div>

			<div class="service-grid">
				<article class="service-card featured">
					<span class="service-number">01</span>

					<h3>Oficinas y espacios comerciales</h3>

					<p>
						Adecuación de interiores para reorganizar,
						renovar o adaptar un espacio existente.
					</p>

					<ul>
						<li>Divisiones y distribución</li>
						<li>Cielos y pintura</li>
						<li>Pisos y acabados</li>
					</ul>

					<a
						href={whatsappOffice}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar remodelación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">02</span>

					<h3>Pisos y acabados</h3>

					<p>
						Renovación de superficies y terminaciones
						según uso, condición de base y material seleccionado.
					</p>

					<ul>
						<li>Preparación de base</li>
						<li>Pisos interiores</li>
						<li>Acabados finales</li>
					</ul>

					<a
						href={whatsappFloor}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar piso o acabado →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">03</span>

					<h3>Ampliaciones y adecuaciones</h3>

					<p>
						Intervenciones para aumentar, cerrar,
						reorganizar o adaptar áreas existentes.
					</p>

					<ul>
						<li>Nuevos cerramientos</li>
						<li>Adecuación de áreas</li>
						<li>Integración con obra existente</li>
					</ul>

					<a
						href={whatsappExpansion}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar ampliación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">04</span>

					<h3>Coordinación integral</h3>

					<p>
						Un mismo proyecto puede combinar varios oficios
						en lugar de tratar cada intervención por separado.
					</p>

					<ul>
						<li>Tablayeso y herrería</li>
						<li>Plomería e instalaciones</li>
						<li>Pintura y acabados</li>
					</ul>

					<a
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Revisar proyecto integral →
					</a>
				</article>
			</div>
		</div>
	</section>

	<section
		class="section case-section"
		id="trabajos-reales"
	>
		<div class="container case-grid">
			<div class="case-copy">
				<p class="eyebrow">
					CASO DOCUMENTADO · REMODELACIÓN
				</p>

				<h2>
					Renovación interior
					<span>sobre una condición existente.</span>
				</h2>

				<p class="case-intro">
					En un área interior afectada por humedad se preparó
					la base y se instaló un nuevo acabado de piso para
					renovar el espacio y resolver la condición previa.
				</p>

				<div class="case-stat">
					<strong>≈78 m²</strong>
					<span>preparación + instalación de acabado</span>
				</div>

				<div class="case-steps">
					<div>
						<span>01</span>
						<p>
							<strong>Revisión de la condición</strong>
							Se parte del estado real del área, no solo del acabado deseado.
						</p>
					</div>

					<div>
						<span>02</span>
						<p>
							<strong>Preparación de base</strong>
							El soporte debe quedar listo antes de instalar el sistema final.
						</p>
					</div>

					<div>
						<span>03</span>
						<p>
							<strong>Instalación y terminación</strong>
							Se completa el acabado de acuerdo con el alcance aprobado.
						</p>
					</div>
				</div>

				<a
					class="button"
					href={whatsappFloor}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar una remodelación similar
				</a>
			</div>

			<div class="case-media">
				<img
					src="/images/projects/remodelacion-piso-deck-pvc-restaurante.jpeg"
					alt="Remodelación de piso interior en restaurante ejecutada por AR en Guatemala"
					loading="lazy"
					decoding="async"
				/>

				<span class="photo-badge">
					PROYECTO EJECUTADO
				</span>
			</div>
		</div>
	</section>

	<section class="section gallery-section">
		<div class="container">
			<div class="gallery-heading">
				<div>
					<p class="eyebrow">
						PROCESO + RESULTADO
					</p>

					<h2>
						Remodelar es coordinar
						<span>muchas capas del espacio.</span>
					</h2>
				</div>

				<p>
					Las fotografías muestran diferentes proyectos y etapas:
					estructura, adecuación, pisos, ampliaciones y acabados
					ejecutados dentro de trabajos reales.
				</p>
			</div>

			<div class="gallery-grid">
				<article class="gallery-card gallery-card-tall">
					<img
						src="/images/servicios/remodelaciones/fachada-ampliacion-terminada.jpeg"
						alt="Fachada de ampliación terminada dentro de proyecto de remodelación"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>AMPLIACIÓN</span>
						<strong>Integración de nueva área con construcción existente</strong>
					</div>
				</article>

				<article class="gallery-card">
					<img
						src="/images/servicios/remodelaciones/estructura-tabique-interior-proceso.jpeg"
						alt="Estructura metálica de tabique durante adecuación interior"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>RECONFIGURACIÓN INTERIOR</span>
						<strong>Perfilería antes de cerrar divisiones</strong>
					</div>
				</article>

				<article class="gallery-card">
					<img
						src="/images/servicios/remodelaciones/piso-tipo-madera-pasillo.jpeg"
						alt="Piso tipo madera terminado en pasillo interior"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>ACABADOS</span>
						<strong>Piso terminado y remates interiores</strong>
					</div>
				</article>

				<article class="gallery-card gallery-card-wide">
					<img
						src="/images/servicios/remodelaciones/deck-exterior-remodelacion-terminado.jpeg"
						alt="Área exterior remodelada con deck terminado"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>ÁREA EXTERIOR</span>
						<strong>Renovación de superficie con acabado tipo madera</strong>
					</div>
				</article>

				<article class="gallery-card">
					<img
						src="/images/servicios/remodelaciones/adecuacion-interior-proceso.jpeg"
						alt="Adecuación interior en proceso dentro de ampliación"
						loading="lazy"
						decoding="async"
					/>

					<div>
						<span>PROCESO DE OBRA</span>
						<strong>Intervención coordinada antes de la entrega final</strong>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section integration-section">
		<div class="container integration-grid">
			<div class="integration-copy">
				<p class="eyebrow eyebrow-light">
					UN PROYECTO, VARIOS OFICIOS
				</p>

				<h2>
					La ventaja está en
					<span>coordinar el conjunto.</span>
				</h2>

				<p>
					Una remodelación puede requerir divisiones,
					tuberías, estructuras, pisos y acabados.
					Cada especialidad se revisa por separado,
					pero se integra dentro del mismo objetivo.
				</p>

				<a
					class="button button-light"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Contarnos el proyecto
				</a>
			</div>

			<div class="integration-links">
				<a href="/tablayeso-guatemala/">
					<span>01</span>
					<div>
						<strong>Tablayeso y sistemas livianos</strong>
						<p>Muros, divisiones, cielos y cerramientos.</p>
					</div>
				</a>

				<a href="/plomeria-guatemala/">
					<span>02</span>
					<div>
						<strong>Plomería y drenajes</strong>
						<p>Redes, modificaciones e instalaciones sanitarias.</p>
					</div>
				</a>

				<a href="/estructuras-metalicas-herreria-guatemala/">
					<span>03</span>
					<div>
						<strong>Estructuras y herrería</strong>
						<p>Elementos metálicos, soportes y adecuaciones.</p>
					</div>
				</a>

				<a href="/deck-wpc-guatemala/">
					<span>04</span>
					<div>
						<strong>Deck WPC</strong>
						<p>Suministro e instalación para áreas exteriores.</p>
					</div>
				</a>
			</div>
		</div>
	</section>

	<section class="section scope-section">
		<div class="container">
			<div class="section-heading scope-heading">
				<p class="eyebrow">
					¿QUÉ NECESITAMOS PARA COTIZAR?
				</p>

				<h2>
					No necesita tener
					<span>el proyecto completamente definido.</span>
				</h2>

				<p>
					Con fotografías, medidas y el objetivo del cambio
					podemos hacer una primera revisión y decirle qué
					información técnica hace falta.
				</p>
			</div>

			<div class="scope-grid">
				<article>
					<span>01</span>
					<h3>Fotografías</h3>
					<p>Del espacio actual, daños y áreas a intervenir.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Medidas</h3>
					<p>Área aproximada, largos, alturas o planos existentes.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Objetivo</h3>
					<p>Qué desea cambiar, conservar, ampliar o renovar.</p>
				</article>

				<article class="scope-featured">
					<span>04</span>
					<h3>Ubicación</h3>
					<p>Para revisar acceso, logística y condiciones del sitio.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar
					<span>una remodelación.</span>
				</h2>

				<p>
					Cada espacio tiene condiciones distintas.
					Estas respuestas ayudan a entender cómo
					preparamos el alcance antes de ejecutar.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué tipo de remodelaciones realizan en Guatemala?
					</summary>

					<p>
						Podemos evaluar remodelaciones y adecuaciones de oficinas,
						comercios, interiores y áreas de proyecto, integrando
						acabados e instalaciones según el alcance.
					</p>
				</details>

				<details>
					<summary>
						¿Remodelan oficinas y locales comerciales?
					</summary>

					<p>
						Sí. Podemos revisar divisiones, cielos, pisos,
						pintura, instalaciones y otros trabajos necesarios
						para renovar o adaptar el espacio.
					</p>
				</details>

				<details>
					<summary>
						¿Cuánto cuesta una remodelación?
					</summary>

					<p>
						Depende del área, condición existente, materiales,
						acabados e instalaciones. Por eso no publicamos
						un precio genérico que luego no corresponda al proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿La cotización puede incluir materiales y mano de obra?
					</summary>

					<p>
						Sí. La propuesta puede integrar materiales, mano de obra,
						trabajos complementarios y coordinación entre especialidades.
					</p>
				</details>

				<details>
					<summary>
						¿Pueden trabajar una remodelación por etapas?
					</summary>

					<p>
						Sí, cuando el proyecto lo permite. El alcance puede
						dividirse por áreas o etapas para coordinar mejor
						trabajos y continuidad de operación.
					</p>
				</details>

				<details>
					<summary>
						¿Necesitan visitar el lugar?
					</summary>

					<p>
						Depende del proyecto. Fotografías, medidas y planos
						permiten una revisión inicial; trabajos con instalaciones
						ocultas o demoliciones pueden requerir visita técnica.
					</p>
				</details>

				<details>
					<summary>
						¿Emiten factura FEL?
					</summary>

					<p>
						Sí. Los trabajos pueden documentarse mediante
						factura electrónica FEL.
					</p>
				</details>
			</div>
		</div>
	</section>

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN
			</p>

			<h2>
				¿Tiene un espacio que necesita renovar, ampliar o adaptar?
			</h2>

			<p>
				Envíenos fotografías, medidas aproximadas y una breve
				descripción de lo que necesita cambiar. Revisamos el
				requerimiento antes de preparar la propuesta.
			</p>

			<a
				class="button"
				href={whatsappGeneral}
				target="_blank"
