---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Tablayeso en Guatemala | Instalación de Muros y Cielos | AR";

const description =
	"Instalación de tablayeso en Guatemala para oficinas y proyectos: muros, divisiones, cielos, reparaciones, DensGlass y adecuaciones con materiales y mano de obra.";

const pageUrl =
	"https://obracivilar.com/tablayeso-guatemala/";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de tablayeso en Guatemala y quisiera solicitar una cotización.

Tipo de trabajo:
Ubicación del proyecto:
Área o medidas aproximadas:
¿Es muro, división, cielo o reparación?:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappWalls = createWhatsAppLink(
	`Hola, necesito cotizar muros o divisiones de tablayeso.

Ubicación:
Metros cuadrados o medidas aproximadas:
Altura aproximada:
¿Es construcción nueva o adecuación?:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappCeilings = createWhatsAppLink(
	`Hola, necesito cotizar un cielo o trabajo interior con sistema liviano.

Ubicación:
Área aproximada:
Tipo de espacio:
¿Tiene diseño o referencia?: Sí / No
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappRepair = createWhatsAppLink(
	`Hola, necesito cotizar una reparación o adecuación de tablayeso.

Ubicación:
Tipo de daño o cambio requerido:
Área aproximada:
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué trabajos de tablayeso realizan en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede evaluar instalación de muros, divisiones, cielos, reparaciones, sustituciones y adecuaciones con sistemas livianos según el alcance y las condiciones del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Cuánto cuesta instalar tablayeso?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"El costo depende del área, altura, perfilería, tipo de placa, acabado, accesos y condiciones existentes. Por eso la cotización se prepara después de revisar medidas, fotografías y alcance.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan cielo falso de tablayeso?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Se pueden evaluar cielos y otros elementos interiores de sistema liviano según diseño, área, estructura disponible y acabado requerido.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan DensGlass además de tablayeso?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. El tipo de placa se define de acuerdo con la ubicación y requerimientos del proyecto. AR ha ejecutado proyectos que integran tablayeso y DensGlass.",
			},
		},
		{
			"@type": "Question",
			name: "¿La cotización puede incluir materiales y mano de obra?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Dependiendo del alcance, la propuesta puede incluir perfilería, placas, consumibles, mano de obra, acabados y trabajos complementarios definidos en la cotización.",
			},
		},
		{
			"@type": "Question",
			name: "¿Necesitan visitar el lugar para cotizar tablayeso?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"No siempre. Fotografías, medidas y planos permiten una revisión inicial; algunos proyectos requieren visita para confirmar niveles, soportes, instalaciones, accesos y condiciones existentes.",
			},
		},
	],
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "Instalación de tablayeso en Guatemala",
	description,
	url: pageUrl,
	image:
		"https://obracivilar.com/images/servicios/tablayeso/oficinas-densglass-pintura.webp",
	serviceType: [
		"Instalación de tablayeso",
		"Muros de tablayeso",
		"Divisiones de tablayeso",
		"Cielos",
		"DensGlass",
		"Remodelaciones interiores",
	],
	areaServed: {
		"@type": "Country",
		name: "Guatemala",
	},
	provider: {
		"@type": "Organization",
		name: "Multiservicios Obra Civil AR",
		url: "https://obracivilar.com/",
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "https://obracivilar.com/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Servicios de obra civil en Guatemala",
			item: "https://obracivilar.com/servicios-obra-civil-guatemala/",
		},
		{
			"@type": "ListItem",
			position: 3,
			name: "Tablayeso en Guatemala",
			item: pageUrl,
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/servicios/tablayeso/oficinas-densglass-pintura.webp"
	imageAlt="Proyecto de sistema liviano con placas y estructura ejecutado por Multiservicios Obra Civil AR en Guatemala"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(serviceSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<section class="drywall-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					TABLAYESO EN GUATEMALA
				</p>

				<h1>
					Instalación de tablayeso
					<span>para oficinas y proyectos.</span>
				</h1>

				<p class="hero-lead">
					Muros, divisiones, cielos, reparaciones y
					adecuaciones con sistemas livianos para espacios
					empresariales, comerciales y de proyecto.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#trabajos-reales"
					>
						Ver trabajos reales
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Materiales + mano de obra</span>
					<span>✓ Evaluación por proyecto</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<div class="hero-media">
				<img
					src="/images/servicios/tablayeso/oficinas-densglass-pintura.webp"
					alt="Cerramiento con placas DensGlass en etapa de pintura dentro de un proyecto ejecutado en Guatemala"
					loading="eager"
					decoding="async"
				/>

				<div class="hero-media-caption">
					<span>PROYECTO EJECUTADO</span>
					<strong>Sistemas livianos dentro de una obra integral</strong>
					<p>estructura · placas · acabados</p>
				</div>
			</div>
		</div>
	</section>

	<section class="proof-strip">
		<div class="container proof-grid">
			<div>
				<strong>55.62 m²</strong>
				<span>en proyecto integral de oficinas documentado</span>
			</div>

			<div>
				<strong>Muros</strong>
				<span>divisiones y adecuaciones interiores</span>
			</div>

			<div>
				<strong>Cielos</strong>
				<span>según sistema y condiciones del proyecto</span>
			</div>

			<div>
				<strong>A medida</strong>
				<span>según área, altura, uso y acabado</span>
			</div>
		</div>
	</section>

	<section class="section services-section" id="servicios">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					SERVICIOS DE TABLAYESO
				</p>

				<h2>
					No vendemos una medida estándar.
					<span>Definimos el sistema según el espacio.</span>
				</h2>

				<p>
					Antes de cotizar revisamos dimensiones, altura,
					estructura existente, instalaciones, tipo de placa
					y nivel de acabado que necesita el proyecto.
				</p>
			</div>

			<div class="services-grid">
				<article class="service-card featured">
					<span class="service-number">01</span>
					<h3>Muros y divisiones</h3>
					<p>
						Construcción de divisiones para oficinas,
						ambientes interiores y adecuaciones de espacios.
					</p>
					<ul>
						<li>Perfilería metálica</li>
						<li>Placas según aplicación</li>
						<li>Tratamiento de juntas y acabado</li>
					</ul>
					<a
						href={whatsappWalls}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar muros →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">02</span>
					<h3>Cielos y elementos interiores</h3>
					<p>
						Revisión de cielos y soluciones interiores
						según diseño, estructura disponible y uso del área.
					</p>
					<ul>
						<li>Cielos de sistema liviano</li>
						<li>Fascias y elementos complementarios</li>
						<li>Adecuaciones para iluminación e instalaciones</li>
					</ul>
					<a
						href={whatsappCeilings}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar cielo →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">03</span>
					<h3>Reparaciones y adecuaciones</h3>
					<p>
						Intervenciones sobre muros y elementos existentes
						para reparar, modificar o redistribuir espacios.
					</p>
					<ul>
						<li>Reparaciones localizadas</li>
						<li>Cambios de distribución</li>
						<li>Reposición de secciones dañadas</li>
					</ul>
					<a
						href={whatsappRepair}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar reparación →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">04</span>
					<h3>DensGlass y placas según aplicación</h3>
					<p>
						No tratamos todos los tableros como equivalentes.
						El tipo de placa se revisa según ubicación y requerimiento.
					</p>
					<ul>
						<li>Selección según condiciones del área</li>
						<li>Integración con estructura y acabados</li>
						<li>Alcance definido antes de ejecutar</li>
					</ul>
					<a
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Revisar mi proyecto →
					</a>
				</article>
			</div>
		</div>
	</section>

	<section class="section real-work-section" id="trabajos-reales">
		<div class="container">
			<div class="real-work-heading">
				<div>
					<p class="eyebrow eyebrow-light">
						TRABAJOS Y PROCESOS
					</p>

					<h2>
						Tablayeso y sistemas livianos
						<span>ejecutados en proyectos reales.</span>
					</h2>
				</div>

				<p>
					Mostramos perfilería, cerramientos, tratamiento de
					juntas, cielos y espacios terminados para que pueda
					ver el proceso, no solo el resultado.
				</p>
			</div>

			<div class="real-work-grid">
				<figure class="work-photo work-photo-tall">
					<img
						src="/images/servicios/tablayeso/estructura-tabique-metalico.webp"
						alt="Perfilería metálica para tabique interior en proceso de adecuación"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<span>PERFILERÍA</span>
						<strong>Estructura de tabique interior</strong>
					</figcaption>
				</figure>

				<figure class="work-photo work-photo-tall">
					<img
						src="/images/servicios/tablayeso/muro-densglass-proceso.webp"
						alt="Muro con placas DensGlass y tratamiento de juntas en proceso"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<span>PLACAS + JUNTAS</span>
						<strong>Muro en etapa de acabado</strong>
					</figcaption>
				</figure>

				<figure class="work-photo">
					<img
						src="/images/servicios/tablayeso/oficina-cielo-falso-proceso.webp"
						alt="Adecuación de oficina con cielo falso e iluminación en proceso"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<span>ADECUACIÓN INTERIOR</span>
						<strong>Adecuación interior con cielo e instalaciones</strong>
					</figcaption>
				</figure>

				<figure class="work-photo">
					<img
						src="/images/servicios/tablayeso/oficinas-terminadas.webp"
						alt="Oficinas terminadas después de trabajos de construcción y acabados"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<span>RESULTADO</span>
						<strong>Espacio de oficinas terminado</strong>
					</figcaption>
				</figure>
			</div>

			<div class="real-work-footer">
				<p>
					Las fotografías muestran distintos proyectos y etapas.
					El sistema final se define de acuerdo con cada requerimiento.
				</p>

				<a
					class="button"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar un trabajo similar
				</a>
			</div>
		</div>
	</section>

	<section class="section case-section">
		<div class="container case-grid">
			<div class="case-copy">
				<p class="eyebrow">
					CASO DOCUMENTADO
				</p>

				<h2>
					Oficinas completas
					<span>con sistemas livianos integrados.</span>
				</h2>

				<p>
					En un proyecto integral de oficinas se combinaron
					estructura metálica, tablayeso, DensGlass, instalaciones,
					cubierta, piso, pintura y otros acabados.
				</p>

				<div class="case-facts">
					<div>
						<strong>≈55.62 m²</strong>
						<span>de área ejecutada</span>
					</div>
					<div>
						<strong>Proyecto integral</strong>
						<span>estructura + cerramientos + acabados</span>
					</div>
				</div>

				<p class="case-detail">
					Este tipo de proyecto demuestra por qué el tablayeso
					no siempre se cotiza de forma aislada: muchas veces
					debe coordinarse con estructura, electricidad, puertas,
					ventanas, pintura y otras especialidades.
				</p>

				<a
					class="button"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar una adecuación
				</a>
			</div>

			<div class="case-sequence">
				<figure>
					<img
						src="/images/servicios/tablayeso/oficinas-estructura-proceso.webp"
						alt="Estructura de proyecto de oficinas durante la etapa inicial de construcción"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>01 · estructura y preparación</figcaption>
				</figure>

				<figure>
					<img
						src="/images/servicios/tablayeso/oficinas-densglass-pintura.webp"
						alt="Proyecto de oficinas con placas DensGlass en etapa de pintura"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>02 · cerramiento y acabado</figcaption>
				</figure>

				<figure>
					<img
						src="/images/servicios/tablayeso/oficinas-terminadas.webp"
						alt="Proyecto de oficinas terminado con pisos, pintura, cielos y divisiones"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>03 · espacio terminado</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section class="section quote-section">
		<div class="container quote-grid">
			<div>
				<p class="eyebrow eyebrow-light">
					¿QUÉ NECESITAMOS PARA COTIZAR?
				</p>

				<h2>
					No necesita saber
					<span>cuántos postes o canales comprar.</span>
				</h2>

				<p>
					Con una referencia clara del espacio podemos empezar.
					Después confirmamos qué información técnica falta.
				</p>
			</div>

			<div class="quote-list">
				<article>
					<span>01</span>
					<div>
						<h3>Medidas</h3>
						<p>Largo, altura y área aproximada del trabajo.</p>
					</div>
				</article>

				<article>
					<span>02</span>
					<div>
						<h3>Fotografías</h3>
						<p>Del área actual y de cualquier condición existente.</p>
					</div>
				</article>

				<article>
					<span>03</span>
					<div>
						<h3>Objetivo</h3>
						<p>Dividir, cerrar, reparar, remodelar o construir.</p>
					</div>
				</article>

				<article class="featured">
					<span>04</span>
					<div>
						<h3>Ubicación</h3>
						<p>Para revisar acceso, altura, logística y condiciones del sitio.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section process-section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					PROCESO
				</p>

				<h2>
					De la idea
					<span>al espacio terminado.</span>
				</h2>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Revisión</h3>
					<p>Recibimos fotografías, medidas, planos y objetivo del trabajo.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Definición</h3>
					<p>Revisamos perfilería, placas, acabados y trabajos relacionados.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Preparamos la propuesta con base en el alcance confirmado.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Ejecución</h3>
					<p>Coordinamos instalación y acabados de acuerdo con lo aprobado.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section context-section">
		<div class="container context-grid">
			<div>
				<p class="eyebrow">
					TABLAYESO, PRECIO E INSTALACIÓN
				</p>
				<h2>
					El precio de una plancha
					<span>no es el precio de un proyecto.</span>
				</h2>
			</div>

			<div class="context-copy">
				<p>
					Una instalación completa puede cambiar según el área,
					altura, separación de la perfilería, tipo de placa,
					número de caras, vanos, esquinas, tratamiento de juntas,
					nivel de acabado y condiciones del lugar.
				</p>

				<p>
					Por eso nuestra página está enfocada en cotizar{" "}
					<strong>trabajos de instalación y adecuación</strong>,
					no en publicar un precio genérico por metro cuadrado
					que luego no corresponda con el proyecto real.
				</p>
			</div>
		</div>
	</section>

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar tablayeso.
				</h2>

				<p>
					Si ya tiene fotografías, medidas o planos,
					puede enviarlos directamente por WhatsApp.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>¿Qué trabajos de tablayeso realizan en Guatemala?</summary>
					<p>
						Podemos evaluar muros, divisiones, cielos,
						reparaciones, sustituciones y adecuaciones con
						sistemas livianos según el proyecto.
					</p>
				</details>

				<details>
					<summary>¿Cuánto cuesta instalar tablayeso?</summary>
					<p>
						Depende del área, altura, perfilería, tipo de placa,
						acabado, accesos y condiciones existentes. Con medidas
						y fotografías podemos iniciar la revisión.
					</p>
				</details>

				<details>
					<summary>¿Trabajan cielo falso de tablayeso?</summary>
					<p>
						Sí. Podemos evaluar cielos y otros elementos interiores
						de sistema liviano de acuerdo con diseño, área,
						estructura disponible y acabado requerido.
					</p>
				</details>

				<details>
					<summary>¿Trabajan DensGlass además de tablayeso?</summary>
					<p>
						Sí. El tipo de placa se define según ubicación y
						requerimientos. En proyectos ejecutados hemos integrado
						tablayeso y DensGlass dentro de un mismo alcance.
					</p>
				</details>

				<details>
					<summary>¿La cotización puede incluir materiales y mano de obra?</summary>
					<p>
						Sí. Dependiendo del alcance, la propuesta puede incluir
						perfilería, placas, consumibles, mano de obra y acabados.
					</p>
				</details>

