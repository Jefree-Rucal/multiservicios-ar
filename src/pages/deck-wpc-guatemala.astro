---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Piso WPC en Guatemala | Deck WPC Q875 por Caja | AR";

const description =
	"Piso WPC y Deck WPC en Guatemala para terrazas, balcones y exteriores. Caja de 5 piezas, aprox. 2.03 m². Precio Q875, material e instalación.";

const whatsappDeck = createWhatsAppLink(
	`Hola, vi su página de Piso Deck WPC y quisiera solicitar una cotización.

Área aproximada en m²:
Ubicación del proyecto:
¿Necesito instalación?: Sí / No
Color o acabado de interés:
Información adicional:`
);

const whatsappMaterial = createWhatsAppLink(
	`Hola, quisiera cotizar únicamente material de Piso Deck WPC.

Área aproximada en m²:
Cantidad de cajas si ya la conozco:
Ubicación para entrega:
Color o acabado de interés:`
);

const whatsappInstallation = createWhatsAppLink(
	`Hola, quisiera cotizar Piso Deck WPC con instalación.

Área aproximada en m²:
Ubicación del proyecto:
¿La superficie ya está preparada?: Sí / No / No sé
¿Puedo enviar fotos del área?: Sí
Color o acabado de interés:`
);

const whatsappBoxes = createWhatsAppLink(
	`Hola, quisiera saber cuántas cajas de Deck WPC necesito.

Largo del área:
Ancho del área:
Área aproximada en m²:
¿Necesito instalación?: Sí / No`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Cuánto cuesta el Piso WPC en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR maneja un precio comercial de referencia de Q875 por caja de Deck WPC. El precio, color y disponibilidad deben confirmarse al momento de cotizar.",
			},
		},
		{
			"@type": "Question",
			name: "¿Dónde comprar Piso Deck WPC en Guatemala?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Multiservicios Obra Civil AR puede cotizar Piso Deck WPC en Guatemala para terrazas, balcones y otros proyectos exteriores, con opción de solo material o suministro más instalación.",
			},
		},
		{
			"@type": "Question",
			name: "¿Cuánto cubre una caja de Deck WPC?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Una caja contiene 5 piezas de aproximadamente 2.90 metros de largo por 14 centímetros de ancho, para un rendimiento geométrico aproximado de 2.03 m² antes de cortes y ajustes de instalación.",
			},
		},
		{
			"@type": "Question",
			name: "¿Cuántas cajas de Piso WPC necesito?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Como cálculo inicial, divida el área del proyecto entre 2.03 m² por caja y redondee hacia arriba. El cálculo final puede aumentar por cortes, orientación y condiciones de instalación.",
			},
		},
		{
			"@type": "Question",
			name: "¿Venden únicamente el material?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar únicamente las cajas de Deck WPC o preparar una propuesta con suministro e instalación.",
			},
		},
		{
			"@type": "Question",
			name: "¿También realizan instalación de Deck WPC?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. La instalación se cotiza según área, ubicación, condiciones de la superficie, materiales complementarios y alcance del proyecto.",
			},
		},
	],
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Piso Deck WPC en Guatemala",
			item: "/deck-wpc-guatemala/",
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/projects/hero-deck.jpeg"
	imageAlt="Proyecto de Piso Deck WPC en Guatemala ejecutado por Multiservicios Obra Civil AR"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<!-- ==================================================
	     HERO
	================================================== -->

	<section class="deck-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					PISO WPC · DECK WPC EN GUATEMALA
				</p>

				<h1>
					Piso Deck WPC
					<span>en Guatemala desde Q875 por caja.</span>
				</h1>

				<p class="hero-lead">
					Deck WPC para terrazas, balcones y áreas exteriores.
					Cada caja incluye 5 piezas y cubre aproximadamente
					2.03 m² antes de cortes. Puede cotizar solo material
					o solicitar suministro más instalación.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappDeck}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar Piso WPC
					</a>

					<a
						class="button button-secondary"
						href="#producto"
					>
						Ver medidas y rendimiento
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Q875 por caja</span>
					<span>✓ Instalación disponible</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<aside class="price-panel">
				<p class="panel-label">
					PRECIO DE PISO DECK WPC
				</p>

				<div class="price-main">
					<span>Precio de referencia por caja</span>
					<strong>Q875</strong>
				</div>

				<p class="panel-copy">
					Cada caja incluye 5 piezas de Deck WPC.
				</p>

				<div class="panel-specs">
					<div>
						<span>05</span>

						<p>
							<strong>Piezas</strong>
							Por caja
						</p>
					</div>

					<div>
						<span>2.90 m</span>

						<p>
							<strong>Largo aprox.</strong>
							Por pieza
						</p>
					</div>

					<div>
						<span>14 cm</span>

						<p>
							<strong>Ancho aprox.</strong>
							Por pieza
						</p>
					</div>

					<div>
						<span>2.03 m²</span>

						<p>
							<strong>Rendimiento aprox.</strong>
							Por caja
						</p>
					</div>
				</div>

				<p class="price-note">
					*Precio, color y disponibilidad sujetos a
					confirmación al momento de cotizar.
				</p>
			</aside>
		</div>
	</section>

	<!-- ==================================================
	     PRODUCTO / PROYECTO
	================================================== -->

	<section
		class="section product-section"
		id="producto"
	>
		<div class="container product-grid">
			<div class="project-visual">
				<img
					src="/images/projects/hero-deck.jpeg"
					alt="Proyecto real de Piso Deck WPC exterior ejecutado por Multiservicios Obra Civil AR en Guatemala"
					loading="eager"
					decoding="async"
				/>

				<div class="project-badge">
					<span>PROYECTO EJECUTADO POR AR</span>
					<strong>Deck WPC exterior</strong>
				</div>
			</div>

			<div class="product-copy">
				<p class="eyebrow">
					PISO WPC PARA EXTERIORES
				</p>

				<h2>
					Una solución para
					<span>renovar terrazas y balcones.</span>
				</h2>

				<p>
					El Piso Deck WPC ofrece un acabado tipo madera
					para proyectos exteriores y puede utilizarse en
					terrazas, balcones y otras áreas donde se busca
					una superficie visualmente uniforme.
				</p>

				<div class="spec-grid">
					<div>
						<strong>2.90 m</strong>
						<span>Largo aproximado</span>
					</div>

					<div>
						<strong>14 cm</strong>
						<span>Ancho aproximado</span>
					</div>

					<div>
						<strong>25 mm</strong>
						<span>Espesor aproximado</span>
					</div>

					<div>
						<strong>5 piezas</strong>
						<span>Por caja</span>
					</div>
				</div>

				<p class="product-note">
					Estas medidas corresponden al producto que
					actualmente utilizamos como referencia comercial.
					Se confirman nuevamente antes de cada cotización.
				</p>

				<a
					class="button"
					href={whatsappDeck}
					target="_blank"
					rel="noopener noreferrer"
				>
					Solicitar cotización
				</a>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     CALCULADORA
	================================================== -->

	<section class="section calculate-section">
		<div class="container calculate-grid">
			<div>
				<p class="eyebrow">
					¿CUÁNTAS CAJAS DE DECK WPC NECESITA?
				</p>

				<h2>
					Una caja cubre aproximadamente
					<span>2.03 m².</span>
				</h2>

				<p class="calculate-lead">
					Para una estimación inicial, divida los metros
					cuadrados del área entre 2.03. El resultado debe
					redondearse hacia arriba. Después se revisan cortes,
					orientación de las tablas y condiciones del proyecto.
				</p>

				<a
					class="button"
					href={whatsappBoxes}
					target="_blank"
					rel="noopener noreferrer"
				>
					Ayúdenme a calcular
				</a>
			</div>

			<div class="formula-card">
				<p class="formula-label">
					CÁLCULO INICIAL DE CAJAS
				</p>

				<div class="formula">
					<span>Área del proyecto</span>
					<strong>÷</strong>
					<span>2.03 m² por caja</span>
				</div>

				<div class="formula-example">
					<span>Ejemplo para 20 m²</span>

					<p>
						<strong>20 m² ÷ 2.03 = 9.85</strong>
						El cálculo inicial requiere 10 cajas antes
						de considerar cortes o desperdicio.
					</p>
				</div>

				<p class="formula-note">
					El rendimiento indicado es geométrico. La
					cantidad final puede variar según el proyecto.
				</p>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     OPCIONES DE COMPRA
	================================================== -->

	<section class="section scope-section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					MATERIAL O INSTALACIÓN
				</p>

				<h2>
					Compre el Piso WPC
					<span>o cotice el proyecto completo.</span>
				</h2>

				<p>
					Podemos preparar la propuesta según el alcance
					que realmente necesita.
				</p>
			</div>

			<div class="scope-grid">
				<article>
					<span class="scope-number">01</span>

					<h3>
						Solo material
					</h3>

					<p>
						Para quien ya cuenta con instalador o desea
						comprar el Deck WPC directamente por caja.
					</p>

					<ul>
						<li>Deck WPC por caja</li>
						<li>Consulta de tonos disponibles</li>
						<li>Entrega coordinada según ubicación</li>
					</ul>

					<a
						href={whatsappMaterial}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar material →
					</a>
				</article>

				<article class="featured">
					<span class="scope-number">02</span>

					<h3>
						Suministro + instalación
					</h3>

					<p>
						Evaluamos área, producto, materiales
						complementarios y mano de obra.
					</p>

					<ul>
						<li>Piso Deck WPC</li>
						<li>Materiales de instalación según alcance</li>
						<li>Mano de obra</li>
					</ul>

					<a
						href={whatsappInstallation}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar instalación →
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     COLORES / TEXTURA
	================================================== -->

	<section
		class="section colors-section"
		id="colores"
	>
		<div class="container">
			<div class="colors-heading">
				<div>
					<p class="eyebrow">
						COLORES, TEXTURA Y PERFIL
					</p>

					<h2>
						Conozca mejor
						<span>el acabado del Deck WPC.</span>
					</h2>
				</div>

				<div class="colors-heading-copy">
					<p>
						Las imágenes siguientes son ilustrativas y
						muestran textura tipo madera y perfil hueco.
						Los tonos disponibles se confirman al momento
						de cotizar.
					</p>

					<a
						class="button"
						href={whatsappDeck}
						target="_blank"
						rel="noopener noreferrer"
					>
						Consultar colores
					</a>
				</div>
			</div>

			<div class="deck-gallery">
				<figure class="deck-gallery-card">
					<div class="deck-image-wrap">
						<img
							src="/images/deck/deck-wpc-grafito-textura.png"
							alt="Piso Deck WPC color grafito con textura tipo madera"
							loading="lazy"
							decoding="async"
						/>

						<span class="image-note">
							Imagen ilustrativa
						</span>
					</div>

					<figcaption>
						<span>ACABADO</span>

						<h3>
							Grafito · textura tipo madera
						</h3>

						<p>
							Vista cercana del relieve y patrón
							de veta del Piso WPC.
						</p>
					</figcaption>
				</figure>

				<figure class="deck-gallery-card">
					<div class="deck-image-wrap">
						<img
							src="/images/deck/deck-wpc-grafito-perfil-hueco.png"
							alt="Tabla de Piso Deck WPC color grafito con perfil hueco"
							loading="lazy"
							decoding="async"
						/>

						<span class="image-note">
							Imagen ilustrativa
						</span>
					</div>

					<figcaption>
						<span>PERFIL</span>

						<h3>
							Grafito · perfil hueco
						</h3>

						<p>
							Referencia visual de la tabla y
							su estructura interna.
						</p>
					</figcaption>
				</figure>

				<figure class="deck-gallery-card">
					<div class="deck-image-wrap">
						<img
							src="/images/deck/deck-wpc-madera-clara-perfil-hueco.png"
							alt="Tabla de Piso Deck WPC color madera clara con perfil hueco"
							loading="lazy"
							decoding="async"
						/>

						<span class="image-note">
							Imagen ilustrativa
						</span>
					</div>

					<figcaption>
						<span>TONO DE REFERENCIA</span>

						<h3>
							Madera clara · perfil hueco
						</h3>

						<p>
							Ejemplo de acabado cálido tipo madera,
							sujeto a disponibilidad.
						</p>
					</figcaption>
				</figure>
			</div>

			<div class="colors-bottom">
				<div class="availability-card">
					<p class="availability-label">
						ANTES DE COMPRAR
					</p>

					<h3>
						Confirmamos color y cantidad.
					</h3>

					<p>
						Los tonos pueden variar entre lotes y
						según disponibilidad del proveedor. Por eso
						confirmamos el producto antes de cerrar
						la cotización.
					</p>

					<a
						href={whatsappDeck}
						target="_blank"
						rel="noopener noreferrer"
					>
						Consultar disponibilidad →
					</a>
				</div>

				<div class="decision-cards">
					<article>
						<span>01</span>

						<div>
							<h3>
								Área
							</h3>

							<p>
								Envíenos largo, ancho o metros
								cuadrados aproximados.
							</p>
						</div>
					</article>

					<article>
						<span>02</span>

						<div>
							<h3>
								Fotografías
							</h3>

							<p>
								Una foto del área ayuda a entender
								mejor el trabajo.
							</p>
						</div>
					</article>

					<article>
						<span>03</span>

						<div>
							<h3>
								Color
							</h3>

							<p>
								Indique el tono o estilo que
								le interesa.
							</p>
						</div>
					</article>

					<article class="decision-featured">
						<span>04</span>

						<div>
							<h3>
								Instalación
							</h3>

							<p>
								Confirme si requiere solo material
								o también mano de obra.
							</p>
						</div>
					</article>
				</div>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     PROYECTOS
	================================================== -->

	<section class="section proof-section">
		<div class="container proof-grid">
			<div>
				<p class="eyebrow">
					EXPERIENCIA REAL
				</p>

				<h2>
					¿Quiere ver más trabajos
					<span>ejecutados por AR?</span>
				</h2>

				<p>
					Puede revisar nuestra sección de proyectos para
					conocer otros trabajos de remodelación, obra civil
					e instalaciones ejecutados por el equipo.
				</p>
			</div>

			<a
				class="button button-secondary"
				href="/proyectos/"
			>
				Ver proyectos realizados
			</a>
		</div>
	</section>

	<!-- ==================================================
	     PROCESO
	================================================== -->

	<section class="section process-section">
		<div class="container">
			<div class="section-heading process-heading">
				<p class="eyebrow">
					CÓMO COTIZAMOS
				</p>

				<h2>
					Del área a la propuesta.
				</h2>

				<p>
					Con unas pocas medidas podemos preparar una
					primera estimación y definir si necesita
					solo material o instalación.
				</p>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Medidas</h3>
					<p>Recibimos el área aproximada del proyecto.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Producto</h3>
					<p>Confirmamos color y disponibilidad.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Calculamos cajas y alcance solicitado.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Entrega / instalación</h3>
					<p>Coordinamos material y trabajo cuando aplica.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ==================================================
	     FAQ
	================================================== -->

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de comprar Piso Deck WPC.
				</h2>

				<p>
					Si ya tiene medidas o fotografías del área,
					puede enviárnoslas directamente por WhatsApp.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Cuánto cuesta el Piso WPC en Guatemala?
					</summary>

					<p>
						Actualmente manejamos un precio comercial
						de referencia de Q875 por caja. El precio,
						color y disponibilidad deben confirmarse
						al momento de cotizar.
					</p>
				</details>

				<details>
					<summary>
						¿Dónde comprar Piso Deck WPC en Guatemala?
					</summary>

					<p>
						Multiservicios Obra Civil AR puede cotizar
						Deck WPC para terrazas, balcones y otros
						proyectos exteriores, ya sea solo material
						o suministro más instalación.
					</p>
				</details>

				<details>
					<summary>
						¿Cuánto cubre una caja de Deck WPC?
					</summary>

					<p>
						Una caja contiene 5 piezas de aproximadamente
						2.90 m de largo por 14 cm de ancho, para un
						rendimiento geométrico aproximado de 2.03 m²
						antes de cortes y ajustes.
					</p>
				</details>

				<details>
					<summary>
						¿Cuántas cajas necesito?
					</summary>

					<p>
						Como estimación inicial, divida el área total
						entre 2.03 m² y redondee hacia arriba. Después
						conviene agregar el ajuste necesario por cortes,
						patrón y condiciones de instalación.
					</p>
				</details>

				<details>
					<summary>
						¿Puedo comprar únicamente el material?
					</summary>

					<p>
						Sí. Podemos cotizar únicamente las cajas
						de Deck WPC si ya cuenta con instalador
						o realizará el trabajo por su cuenta.
					</p>
				</details>

				<details>
					<summary>
						¿También realizan instalación?
					</summary>

					<p>
						Sí. La instalación se cotiza según área,
						ubicación, condiciones de la superficie,
						materiales complementarios y alcance.
					</p>
				</details>

				<details>
					<summary>
						¿Tienen varios colores?
					</summary>

					<p>
						Los colores disponibles dependen del inventario
						del proveedor. Confirmamos los tonos disponibles
						al momento de preparar la cotización.
					</p>
				</details>

				<details>
					<summary>
						¿Realizan entregas?
					</summary>

					<p>
						La entrega se coordina según cantidad y ubicación.
						Podemos incluirla dentro de la propuesta cuando
						corresponda.
