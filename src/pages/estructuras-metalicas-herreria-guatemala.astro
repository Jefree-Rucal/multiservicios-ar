---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createWhatsAppLink } from "../config/site";

const title =
	"Estructuras Metálicas y Herrería en Guatemala | AR";

const description =
	"Estructuras metálicas y herrería en Guatemala para empresas y proyectos: fabricación, instalación, barandales, protecciones, soportes y trabajos de soldadura.";

const pageUrl =
	"https://obracivilar.com/estructuras-metalicas-herreria-guatemala/";

const whatsappGeneral = createWhatsAppLink(
	`Hola, vi su página de estructuras metálicas y herrería y quisiera solicitar una cotización.

Tipo de trabajo:
Ubicación del proyecto:
Medidas aproximadas:
Uso de la estructura o elemento:
¿Puedo enviar fotografías o planos?: Sí
Información adicional:`
);

const whatsappStructure = createWhatsAppLink(
	`Hola, necesito cotizar una estructura metálica.

Tipo de estructura:
Ubicación:
Medidas aproximadas:
¿Tiene planos o diseño de referencia?: Sí / No
¿Puedo enviar fotografías?: Sí
Información adicional:`
);

const whatsappMetalwork = createWhatsAppLink(
	`Hola, necesito cotizar un trabajo de herrería o soldadura.

Tipo de trabajo:
Medidas aproximadas:
Ubicación:
¿Puedo enviar fotografías o diseño?: Sí
Información adicional:`
);

const whatsappProtection = createWhatsAppLink(
	`Hola, necesito cotizar una protección o barandal metálico.

Uso del elemento:
Metros lineales o medidas aproximadas:
Ubicación:
¿Tiene diseño o fotografía de referencia?: Sí / No
Información adicional:`
);

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "¿Qué trabajos de estructuras metálicas y herrería realizan?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"AR puede evaluar fabricación e instalación de estructuras metálicas, barandales, protecciones, soportes, refuerzos, adecuaciones y trabajos de soldadura según el alcance del proyecto.",
			},
		},
		{
			"@type": "Question",
			name: "¿Fabrican estructuras metálicas a medida?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. El alcance puede definirse con medidas, fotografías, planos o una visita técnica cuando sea necesario.",
			},
		},
		{
			"@type": "Question",
			name: "¿Trabajan herrería para empresas e instalaciones industriales?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. AR puede cotizar protecciones, barandales, soportes, estructuras y otros elementos metálicos para áreas empresariales, comerciales e industriales.",
			},
		},
		{
			"@type": "Question",
			name: "¿Pueden incluir fabricación e instalación?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"Sí. Dependiendo del proyecto, la propuesta puede incluir materiales, fabricación, traslado, instalación y trabajos complementarios definidos en el alcance.",
			},
		},
		{
			"@type": "Question",
			name: "¿Necesitan planos para cotizar?",
			acceptedAnswer: {
				"@type": "Answer",
				text:
					"No siempre. Fotografías, medidas y una descripción del uso permiten una revisión inicial. Algunos proyectos sí pueden requerir planos, especificaciones o visita técnica.",
			},
		},
	],
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "Estructuras metálicas y herrería en Guatemala",
	description,
	url: pageUrl,
	image:
		"https://obracivilar.com/images/projects/barandal-seguridad-industrial.jpeg",
	serviceType: [
		"Estructuras metálicas",
		"Herrería",
		"Soldadura",
		"Barandales metálicos",
		"Protecciones metálicas",
	],
	areaServed: {
		"@type": "Country",
		name: "Guatemala",
	},
	provider: {
		"@type": "Organization",
		name: "Multiservicios Obra Civil AR",
		url: "https://obracivilar.com/",
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "https://obracivilar.com/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Servicios de obra civil en Guatemala",
			item: "https://obracivilar.com/servicios-obra-civil-guatemala/",
		},
		{
			"@type": "ListItem",
			position: 3,
			name: "Estructuras metálicas y herrería en Guatemala",
			item: pageUrl,
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image="/images/projects/barandal-seguridad-industrial.jpeg"
	imageAlt="Barandal y protección metálica fabricada e instalada por Multiservicios Obra Civil AR en Guatemala"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(serviceSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqSchema)}
	></script>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>

	<section class="metal-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					ESTRUCTURAS METÁLICAS Y HERRERÍA EN GUATEMALA
				</p>

				<h1>
					Estructuras metálicas
					<span>y herrería a medida.</span>
				</h1>

				<p class="hero-lead">
					Fabricación e instalación de estructuras,
					barandales, protecciones, soportes y elementos
					metálicos para empresas, comercios y proyectos.
				</p>

				<div class="hero-actions">
					<a
						class="button"
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Solicitar cotización
					</a>

					<a
						class="button button-secondary"
						href="#servicios"
					>
						Ver trabajos
					</a>
				</div>

				<div class="hero-trust">
					<span>✓ Fabricación según alcance</span>
					<span>✓ Instalación en proyecto</span>
					<span>✓ Factura FEL</span>
				</div>
			</div>

			<div class="hero-media">
				<img
					src="/images/projects/barandal-seguridad-industrial.jpeg"
					alt="Barandal metálico de seguridad industrial fabricado e instalado en Guatemala"
					loading="eager"
					decoding="async"
				/>

				<div class="hero-media-caption">
					<span>PROYECTO EJECUTADO</span>
					<strong>Protección metálica para área operativa</strong>
					<p>≈46.24 m lineales · fabricación + instalación</p>
				</div>
			</div>
		</div>
	</section>

	<section class="proof-strip">
		<div class="container proof-grid">
			<div>
				<strong>≈46.24 m</strong>
				<span>de protección metálica en proyecto real</span>
			</div>

			<div>
				<strong>55.62 m²</strong>
				<span>de oficinas sobre estructura metálica</span>
			</div>

			<div>
				<strong>A medida</strong>
				<span>según uso, medidas y condiciones del sitio</span>
			</div>
		</div>
	</section>

	<section
		class="section services-section"
		id="servicios"
	>
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					SERVICIOS DE METAL
				</p>

				<h2>
					Fabricación e instalación
					<span>según el proyecto.</span>
				</h2>

				<p>
					Revisamos el uso del elemento, dimensiones,
					condiciones de instalación y acabados necesarios
					antes de definir materiales y alcance.
				</p>
			</div>

			<div class="services-grid">
				<article class="service-card featured">
					<span class="service-number">01</span>
					<h3>Estructuras metálicas</h3>
					<p>
						Fabricación y montaje de elementos estructurales
						y auxiliares de acuerdo con las necesidades del proyecto.
					</p>
					<ul>
						<li>Estructuras para ampliaciones y áreas nuevas</li>
						<li>Bases, marcos y soportes metálicos</li>
						<li>Estructuras para cubiertas según alcance</li>
					</ul>
					<a
						href={whatsappStructure}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar estructura →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">02</span>
					<h3>Herrería y soldadura</h3>
					<p>
						Fabricación, reparación y adecuación de elementos
						metálicos para uso comercial, empresarial o industrial.
					</p>
					<ul>
						<li>Fabricación a medida</li>
						<li>Reparaciones y refuerzos</li>
						<li>Adecuaciones y modificaciones</li>
					</ul>
					<a
						href={whatsappMetalwork}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar herrería →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">03</span>
					<h3>Barandales y protecciones</h3>
					<p>
						Elementos metálicos para delimitar, proteger o
						separar áreas de tránsito y operación.
					</p>
					<ul>
						<li>Barandales de protección</li>
						<li>Barreras y defensas metálicas</li>
						<li>Protecciones para áreas operativas</li>
					</ul>
					<a
						href={whatsappProtection}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar protección →
					</a>
				</article>

				<article class="service-card">
					<span class="service-number">04</span>
					<h3>Soportes y trabajos especiales</h3>
					<p>
						Piezas, bases y soluciones metálicas para
						infraestructura, instalaciones y equipos.
					</p>
					<ul>
						<li>Soportes y bases</li>
						<li>Marcos y refuerzos</li>
						<li>Elementos fabricados según medida</li>
					</ul>
					<a
						href={whatsappGeneral}
						target="_blank"
						rel="noopener noreferrer"
					>
						Revisar mi proyecto →
					</a>
				</article>
			</div>
		</div>
	</section>

	<section class="section case-section">
		<div class="container case-grid">
			<div class="case-image">
				<img
					src="/images/projects/barandal-seguridad-industrial.jpeg"
					alt="Protección metálica de seguridad industrial instalada por AR en Guatemala"
					loading="lazy"
					decoding="async"
				/>
				<span>PROYECTO REAL</span>
			</div>

			<div class="case-copy">
				<p class="eyebrow">
					HERRERÍA + SEGURIDAD INDUSTRIAL
				</p>

				<h2>
					Protección metálica
					<span>para un área operativa.</span>
				</h2>

				<p>
					Se fabricó e instaló una protección metálica corrida
					para delimitar y resguardar un área de operación.
				</p>

				<div class="case-facts">
					<div>
						<strong>≈46.24 m lineales</strong>
						<span>de elemento metálico</span>
					</div>
					<div>
						<strong>Fabricación + instalación</strong>
						<span>alcance ejecutado</span>
					</div>
				</div>

				<p class="case-detail">
					La solución se ejecutó a medida para mejorar la
					delimitación y seguridad del área, integrando
					fabricación, traslado e instalación.
				</p>

				<div class="case-actions">
					<a
						class="button"
						href={whatsappProtection}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cotizar algo similar
					</a>

					<a
						class="text-link"
						href="/proyectos/"
					>
						Ver más proyectos →
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section second-case-section">
		<div class="container second-case-grid">
			<div class="second-case-copy">
				<p class="eyebrow">
					ESTRUCTURA + OBRA CIVIL
				</p>

				<h2>
					Oficinas construidas
					<span>sobre estructura metálica.</span>
				</h2>

				<p>
					En otro proyecto se ejecutó un nivel completo de
					oficinas sobre un área existente, integrando la
					estructura metálica con cerramientos, instalaciones,
					cubierta, gradas y acabados.
				</p>

				<ul>
					<li>≈55.62 m² de área ejecutada</li>
					<li>Estructura metálica + cerramientos</li>
					<li>Tablayeso, DensGlass y techo</li>
					<li>Electricidad, plomería, piso y pintura</li>
				</ul>

				<a
					class="button button-dark"
					href={whatsappStructure}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar una estructura
				</a>
			</div>

			<div class="second-case-image">
				<img
					src="/images/projects/oficinas-administrativas-estructura-metalica.jpeg"
					alt="Oficinas administrativas construidas sobre estructura metálica por AR en Guatemala"
					loading="lazy"
					decoding="async"
				/>
			</div>
		</div>
	</section>

	<section class="section intent-section">
		<div class="container intent-grid">
			<div>
				<p class="eyebrow eyebrow-light">
					¿QUÉ NECESITA COTIZAR?
				</p>
				<h2>
					No necesita llegar
					<span>con todo definido.</span>
				</h2>
				<p>
					Podemos empezar con fotografías, medidas aproximadas
					y una descripción del uso. Si el alcance lo requiere,
					se coordina una visita para confirmar condiciones.
				</p>
			</div>

			<div class="intent-list">
				<article>
					<span>01</span>
					<div>
						<h3>Uso</h3>
						<p>Qué necesita soportar, proteger, delimitar o resolver.</p>
					</div>
				</article>

				<article>
					<span>02</span>
					<div>
						<h3>Medidas</h3>
						<p>Largo, ancho, altura o metros lineales aproximados.</p>
					</div>
				</article>

				<article>
					<span>03</span>
					<div>
						<h3>Referencia</h3>
						<p>Fotos, croquis, planos o ejemplos del resultado esperado.</p>
					</div>
				</article>

				<article class="featured">
					<span>04</span>
					<div>
						<h3>Ubicación</h3>
						<p>Para revisar acceso, montaje, traslado y condiciones del sitio.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section process-section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">
					PROCESO
				</p>

				<h2>
					De la necesidad
					<span>a la instalación.</span>
				</h2>
			</div>

			<div class="process-grid">
				<article>
					<span>01</span>
					<h3>Revisión</h3>
					<p>Recibimos medidas, fotos, planos y objetivo del trabajo.</p>
				</article>

				<article>
					<span>02</span>
					<h3>Alcance</h3>
					<p>Definimos materiales, fabricación, montaje y condiciones.</p>
				</article>

				<article>
					<span>03</span>
					<h3>Cotización</h3>
					<p>Preparamos la propuesta según el requerimiento confirmado.</p>
				</article>

				<article>
					<span>04</span>
					<h3>Ejecución</h3>
					<p>Coordinamos fabricación e instalación de acuerdo con lo aprobado.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section seo-context-section">
		<div class="container context-grid">
			<div>
				<p class="eyebrow">
					ESTRUCTURAS METÁLICAS EN GUATEMALA
				</p>
				<h2>
					Una solución depende
					<span>del uso y del sitio.</span>
				</h2>
			</div>

			<div class="context-copy">
				<p>
					Una estructura para una ampliación, una cubierta,
					un soporte o una protección industrial no se cotiza
					únicamente por “metro”. Cambian perfiles, dimensiones,
					puntos de apoyo, acceso, montaje y acabado.
				</p>

				<p>
					Por eso revisamos el requerimiento antes de definir
					el alcance. Si ya cuenta con planos o especificaciones,
					puede enviarlos; si no, fotografías y medidas permiten
					iniciar la conversación.
				</p>
			</div>
		</div>
	</section>

	<section class="section faq-section">
		<div class="container faq-grid">
			<div class="faq-heading">
				<p class="eyebrow">
					PREGUNTAS FRECUENTES
				</p>

				<h2>
					Antes de cotizar
					estructuras o herrería.
				</h2>

				<p>
					Si ya tiene fotografías, medidas o planos,
					puede enviarlos directamente por WhatsApp.
				</p>
			</div>

			<div class="faq-list">
				<details open>
					<summary>
						¿Qué trabajos de estructuras metálicas y herrería realizan?
					</summary>
					<p>
						Podemos evaluar estructuras metálicas, barandales,
						protecciones, soportes, refuerzos, adecuaciones y
						trabajos de soldadura según el proyecto.
					</p>
				</details>

				<details>
					<summary>
						¿Fabrican estructuras metálicas a medida?
					</summary>
					<p>
						Sí. El alcance puede definirse con medidas,
						fotografías, planos o una visita técnica cuando
						sea necesario.
					</p>
				</details>

				<details>
					<summary>
						¿Trabajan herrería para empresas e instalaciones industriales?
					</summary>
					<p>
						Sí. Podemos cotizar protecciones, barandales,
						soportes, estructuras y otros elementos metálicos
						para áreas empresariales, comerciales e industriales.
					</p>
				</details>

				<details>
					<summary>
						¿Pueden incluir fabricación e instalación?
					</summary>
					<p>
						Sí. Dependiendo del proyecto, la propuesta puede
						incluir materiales, fabricación, traslado, instalación
						y trabajos complementarios definidos en el alcance.
					</p>
				</details>

				<details>
					<summary>
						¿Necesitan planos para cotizar?
					</summary>
					<p>
						No siempre. Fotografías, medidas y una descripción
						del uso permiten una revisión inicial. Algunos proyectos
						sí pueden requerir planos, especificaciones o visita técnica.
					</p>
				</details>
			</div>
		</div>
	</section>

	<section class="section final-cta">
		<div class="container final-inner">
			<p class="eyebrow">
				COTIZACIÓN
			</p>

			<h2>
				¿Necesita una estructura, protección
				o trabajo de herrería?
			</h2>

			<p>
				Envíenos fotografías, medidas aproximadas y una breve
				descripción del uso. Revisamos el requerimiento antes de
				preparar la propuesta.
			</p>

			<div class="final-actions">
				<a
					class="button"
					href={whatsappGeneral}
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar por WhatsApp
				</a>

				<a
					class="button button-secondary"
					href="/servicios-obra-civil-guatemala/"
				>
					Ver todos los servicios
				</a>
			</div>
		</div>
	</section>

	<section class="legal-note">
		<div class="container">
			<p>
				La factibilidad, materiales, dimensiones, acabados,
				plazos y alcance se confirman al momento de cotizar.
				Algunos proyectos pueden requerir visita técnica,
				planos o especificaciones adicionales.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.metal-hero {
		padding: 88px 0;
		background:
			linear-gradient(
				115deg,
				#ffffff 0%,
				#ffffff 58%,
				#f0f0f0 100%
			);
	}

	.hero-grid {
		display: grid;
		grid-template-columns:
			minmax(0, 1fr)
			minmax(380px, 0.95fr);
		align-items: center;
		gap: 60px;
	}

	.hero-copy h1 {
		max-width: 790px;
		margin-bottom: 26px;
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: 0.97;
		letter-spacing: -0.055em;
	}

	.hero-copy h1 span,
	.section-heading h2 span,
	.case-copy h2 span,
	.second-case-copy h2 span,
	.intent-grid h2 span,
	.context-grid h2 span {
		display: block;
		color: #ed1c24;
	}

	.hero-lead {
		max-width: 690px;
		color: #606060;
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.hero-actions,
	.final-actions,
	.case-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 30px;
	}

	.hero-trust {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		margin-top: 28px;
		color: #555555;
		font-size: 0.88rem;
		font-weight: 700;
	}

	.hero-media {
		position: relative;
		min-height: 520px;
		overflow: hidden;
		border-radius: 14px;
